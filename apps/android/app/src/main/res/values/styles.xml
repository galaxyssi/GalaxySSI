<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SignalASI" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@color/bar_bg</item>
        <item name="android:navigationBarColor">@color/bar_bg</item>
        <item name="android:windowSplashScreenBackground">@color/page_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_transparent_icon</item>
        <item name="android:windowBackground">@color/page_bg</item>
    </style>
    <style name="Theme.SignalASI.Main" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@color/bar_bg</item>
        <item name="android:navigationBarColor">@color/bar_bg</item>
        <item name="android:windowBackground">@color/page_bg</item>
    </style>
    <style name="Theme.SignalASI.Camera" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowBackground">#000000</item>
    </style>

    <style name="Widget.SignalASI.NavigationBackButton" parent="@android:style/Widget.Material.ImageButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:contentDescription">@string/conversation_hub_back_to_conversations</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:src">@drawable/ic_navigation_back</item>
    </style>
</resources>
