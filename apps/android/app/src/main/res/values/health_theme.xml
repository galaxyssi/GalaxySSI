<?xml version="1.0" encoding="utf-8"?>
<resources>
    <bool name="health_light_system_bars">true</bool>
    <color name="health_action_text">#FFFFFF</color>
    <style name="Theme.GalaxySSI.Health" parent="Theme.GalaxySSI.Main">
        <item name="android:colorAccent">@color/health_overview_green</item>
        <item name="android:colorControlActivated">@color/health_overview_green</item>
        <item name="android:windowLightStatusBar">@bool/health_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/health_light_system_bars</item>
        <item name="android:editTextStyle">@style/Widget.GalaxySSI.Health.Input</item>
        <item name="android:buttonStyle">@style/Widget.GalaxySSI.Health.Button</item>
    </style>
    <style name="Widget.GalaxySSI.Health.Input" parent="@android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/health_input_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>
    <style name="Widget.GalaxySSI.Health.Button" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/health_button_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/health_button_text</item>
    </style>
</resources>
