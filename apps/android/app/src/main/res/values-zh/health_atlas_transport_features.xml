<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="health_atlas_feature_attenuated">薄层胞质</string>
    <string name="health_atlas_feature_attenuated_detail">薄层胞质覆盖肺泡内表面的大部分区域，缩短气体扩散路径。</string>
    <string name="health_atlas_feature_flat_nucleus">扁平细胞核</string>
    <string name="health_atlas_feature_flat_nucleus_detail">扁平的细胞核位于细胞略厚的区域。</string>
    <string name="health_atlas_feature_lamellar_body">层板小体</string>
    <string name="health_atlas_feature_lamellar_body_detail">层板小体储存表面活性物质，释放后进入肺泡表面的液层。</string>
    <string name="health_atlas_feature_at2_surface">朝向肺泡腔的一面</string>
    <string name="health_atlas_feature_at2_surface_detail">II 型细胞从这里释放表面活性物质，有助于降低气液界面的表面张力。</string>
    <string name="health_atlas_feature_motile_cilia">运动纤毛</string>
    <string name="health_atlas_feature_motile_cilia_detail">纤毛协调摆动，将黏液沿较大的气道移动。</string>
    <string name="health_atlas_feature_ciliated_apical">顶端表面</string>
    <string name="health_atlas_feature_ciliated_apical_detail">纤毛从朝向气道腔的表面伸出。</string>
    <string name="health_atlas_feature_mucin_granules">黏蛋白颗粒</string>
    <string name="health_atlas_feature_mucin_granules_detail">膨大的顶端区域存有黏蛋白颗粒，分泌后参与形成黏液。</string>
    <string name="health_atlas_feature_goblet_neck">狭窄基底部</string>
    <string name="health_atlas_feature_goblet_neck_detail">细胞的下部比富含分泌颗粒的顶端狭窄。</string>
    <string name="health_atlas_feature_club_dome">穹顶状顶端</string>
    <string name="health_atlas_feature_club_dome_detail">Clara（Club）细胞的顶端呈圆顶状，没有运动纤毛。</string>
    <string name="health_atlas_feature_club_granules">分泌颗粒</string>
    <string name="health_atlas_feature_club_granules_detail">顶端颗粒储存参与维持细支气管表面环境的分泌物。</string>
    <string name="health_atlas_feature_podocyte_foot">足突</string>
    <string name="health_atlas_feature_podocyte_foot_detail">相邻足细胞的足突交错排列，在足突间形成滤过裂隙。</string>
    <string name="health_atlas_feature_gbm">肾小球基底膜</string>
    <string name="health_atlas_feature_gbm_detail">肾小球基底膜是位于毛细血管内皮与足细胞足突之间的细胞外基质。</string>
    <string name="health_atlas_feature_podocyte_body">细胞体</string>
    <string name="health_atlas_feature_podocyte_body_detail">细胞体伸出较大的分支，进一步分成足突。</string>
    <string name="health_atlas_feature_mesangial_core">系膜区</string>
    <string name="health_atlas_feature_mesangial_core_detail">系膜细胞位于毛细血管袢之间，不构成连续的滤过表面。</string>
    <string name="health_atlas_feature_mesangial_support">支撑突起</string>
    <string name="health_atlas_feature_mesangial_support_detail">细胞突起及周围基质为毛细血管袢提供支撑。</string>
    <string name="health_atlas_feature_prox_brush">刷状缘</string>
    <string name="health_atlas_feature_prox_brush_detail">密集的微绒毛扩大朝向管腔的表面，利于重吸收。</string>
    <string name="health_atlas_feature_prox_mito">线粒体</string>
    <string name="health_atlas_feature_prox_mito_detail">线粒体为跨上皮的主动转运提供能量。</string>
    <string name="health_atlas_feature_distal_microvilli">短微绒毛</string>
    <string name="health_atlas_feature_distal_microvilli_detail">远端小管细胞没有近端小管那样密集的刷状缘。</string>
    <string name="health_atlas_feature_distal_inflections">基底部褶皱</string>
    <string name="health_atlas_feature_distal_inflections_detail">膜的褶皱扩大朝向周围间质的一侧表面。</string>
    <string name="health_atlas_feature_principal_apical">管腔面</string>
    <string name="health_atlas_feature_principal_apical_detail">加压素调节管腔面水通道蛋白 AQP2 的数量。</string>
    <string name="health_atlas_feature_principal_body">主细胞胞体</string>
    <string name="health_atlas_feature_principal_body_detail">主细胞参与集合管的水分和电解质调节。</string>
    <string name="health_atlas_feature_type_a_pump">顶端质子泵</string>
    <string name="health_atlas_feature_type_a_pump_detail">A 型闰细胞通过顶端的质子泵将质子转运到管腔。</string>
    <string name="health_atlas_feature_intercalated_mito">线粒体</string>
    <string name="health_atlas_feature_intercalated_mito_detail">闰细胞富含线粒体，为主动转运提供能量。</string>
    <string name="health_atlas_feature_umbrella_surface">伞细胞</string>
    <string name="health_atlas_feature_umbrella_surface_detail">这种表层尿路上皮细胞可随尿路扩张而变扁。</string>
    <string name="health_atlas_feature_urothelial_apical">顶端屏障</string>
    <string name="health_atlas_feature_urothelial_apical_detail">顶端细胞膜与细胞间连接帮助将尿液与下方组织隔开。</string>
    <string name="health_atlas_type_a_intercalated_view">A 型闰细胞结构示意</string>
    <string name="health_atlas_umbrella_view">表层伞细胞结构示意</string>
