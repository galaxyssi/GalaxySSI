<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="health_atlas_pelvic_ring_title">骨盆如何传递载荷</string>
    <string name="health_atlas_pelvic_ring_choice">骨盆环的载荷传递</string>
    <string name="health_atlas_pelvic_ring_scope">前视投影与载荷路径示意。移动标记表示传递方向，不代表人体的受力大小或传播速度。</string>
    <string name="health_atlas_pelvic_ring_orient">认识骨盆环</string>
    <string name="health_atlas_pelvic_ring_orient_caption">骶骨在后方经两侧骶髂关节与髋骨相接；两侧髋骨在前方经耻骨联合相连。向外的髋臼与股骨头相接。</string>
    <string name="health_atlas_pelvic_ring_bilateral">追踪双侧传递</string>
    <string name="health_atlas_pelvic_ring_bilateral_caption">双侧支撑站立时，上方传来的载荷到达骶骨，再经过骨盆环传向两侧髋关节与股骨。</string>
    <string name="health_atlas_pelvic_ring_shift">重心向一侧偏移</string>
    <string name="health_atlas_pelvic_ring_shift_caption">较宽的路径表示该侧支撑增加。实际髋关节接触力还与肌肉活动和姿势有关，本图不计算这些因素。</string>
    <string name="health_atlas_pelvic_ring_center">回到双侧支撑</string>
    <string name="health_atlas_pelvic_ring_center_caption">示例将加载位置移回中央，用以比较两侧分担的变化。骨盆环并没有张开，骨头也没有分离。</string>
    <string name="health_atlas_pelvic_ring_view">骨盆环与股骨近端</string>
    <string name="health_atlas_pelvic_ring_sacrum">骶骨</string>
    <string name="health_atlas_pelvic_ring_sacrum_detail">这块三角形骨骼将脊柱下端与骨盆环两侧相连。</string>
    <string name="health_atlas_pelvic_ring_joint">骶髂关节</string>
    <string name="health_atlas_pelvic_ring_joint_detail">骶骨与髂骨之间的关节，协助将脊柱传来的载荷传给髋骨。</string>
    <string name="health_atlas_pelvic_ring_socket">髋臼</string>
    <string name="health_atlas_pelvic_ring_socket_detail">股骨头位于髋骨外侧的这个关节窝中。</string>
    <string name="health_atlas_pelvic_ring_symphysis">耻骨联合</string>
    <string name="health_atlas_pelvic_ring_symphysis_detail">纤维软骨在骨盆环前方把左右耻骨连接起来。</string>
    <string name="health_atlas_pelvic_ring_incoming">躯干传来的载荷</string>
    <string name="health_atlas_pelvic_ring_ref_anatomy">骨盆带解剖</string>
    <string name="health_atlas_pelvic_ring_ref_load">骨盆载荷传递研究</string>
    <string name="health_atlas_subcutaneous_title">皮下组织如何缓冲</string>
    <string name="health_atlas_subcutaneous_choice">受压与卸载</string>
    <string name="health_atlas_subcutaneous_scope">组织变形示意。形变幅度和速度均为示意，不代表实测的组织反应。</string>
    <string name="health_atlas_subcutaneous_layers">定位皮下组织</string>
    <string name="health_atlas_subcutaneous_layers_caption">表皮和真皮下方是皮下组织，脂肪小叶由结缔组织间隔分开。图中较深的筋膜位于肌肉上方。</string>
    <string name="health_atlas_subcutaneous_press">表面受力</string>
    <string name="health_atlas_subcutaneous_press_caption">表面发生凹陷，脂肪小叶和周围结缔组织一起变形。在这个示意中，深层边界移动较少。</string>
    <string name="health_atlas_subcutaneous_spread">载荷向周围分散</string>
    <string name="health_atlas_subcutaneous_spread_caption">组织在一片区域内变形，而不是只有一个点。线条表示示意性的传递方向，不是实际压力分布图。</string>
    <string name="health_atlas_subcutaneous_release">移开载荷</string>
    <string name="health_atlas_subcutaneous_release_caption">虚线标出初始表面。这个简化的可逆示例在载荷撤去后逐渐恢复原来的形状。</string>
    <string name="health_atlas_subcutaneous_view">皮肤与下方的脂肪小叶</string>
    <string name="health_atlas_subcutaneous_epidermis">表皮</string>
    <string name="health_atlas_subcutaneous_lobule">脂肪小叶</string>
    <string name="health_atlas_subcutaneous_lobule_detail">储存脂质的脂肪细胞在皮下组织内成组分布。</string>
    <string name="health_atlas_subcutaneous_septa">结缔组织间隔</string>
    <string name="health_atlas_subcutaneous_septa_detail">纤维性间隔分隔相邻的脂肪小叶，并连接不同层的组织。</string>
    <string name="health_atlas_subcutaneous_fascia">深筋膜</string>
    <string name="health_atlas_subcutaneous_fascia_detail">这里所示的较深结缔组织边界覆盖在肌肉上方。</string>
    <string name="health_atlas_subcutaneous_deep_muscle">下方的肌肉</string>
    <string name="health_atlas_subcutaneous_load">表面载荷</string>
    <string name="health_atlas_subcutaneous_force_spread">示意：载荷向两侧分散</string>
    <string name="health_atlas_subcutaneous_reference_surface">虚线：初始表面</string>
    <string name="health_atlas_subcutaneous_ref_skin">皮肤分层与皮下组织</string>
    <string name="health_atlas_subcutaneous_ref_strain">人体脂肪组织的受压反应</string>
    <string name="health_atlas_pelvis_model_title">模型右侧支撑力</string>
    <string name="health_atlas_pelvis_model_scope">模型用无自重的刚性梁和两个支点演示静力平衡，不用于估算髋关节受力、步态或个人指标。</string>
    <string name="health_atlas_pelvis_model_formula">右侧支撑力 = 加载力 ×（1 + 位置 / 100）÷ 2</string>
    <string name="health_atlas_pelvis_model_load">加载力</string>
    <string name="health_atlas_pelvis_model_position">加载位置（左侧 −100，右侧 +100）</string>
    <string name="health_atlas_pelvis_model_left_value">模型左侧支撑力：%1$s N</string>
    <string name="health_atlas_pelvis_model_left_support">左支点</string>
    <string name="health_atlas_pelvis_model_right_support">右支点</string>
    <string name="health_atlas_pelvis_model_diagram">梁上施加向下的力，两侧支点提供向上的支撑力。加载位置向右移动时，右侧支撑增大，左侧减小。</string>
    <string name="health_atlas_cushion_model_title">平均接触压强</string>
    <string name="health_atlas_cushion_model_scope">在均匀加载的理想接触面上比较平均压强，不估算局部峰值、组织形变或损伤。</string>
    <string name="health_atlas_cushion_model_formula">平均压强（kPa）= 10 × 力（N）÷ 面积（cm²）</string>
    <string name="health_atlas_cushion_model_load">垂直接触力</string>
    <string name="health_atlas_cushion_model_area">接触面积</string>
    <string name="health_atlas_cushion_model_reference_value">同一力作用在 40 cm² 上：%1$s kPa</string>
    <string name="health_atlas_cushion_model_standard_pad">40 cm² 对照面</string>
    <string name="health_atlas_cushion_model_changed_pad">所选面积</string>
    <string name="health_atlas_cushion_model_diagram">两个接触面承受同一大小的力。平均压强越大，接触处的色带越深。</string>
</resources>
