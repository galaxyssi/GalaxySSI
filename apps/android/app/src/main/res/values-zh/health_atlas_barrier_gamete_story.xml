<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="health_atlas_barrier_title">皮肤如何锁住水分</string>
    <string name="health_atlas_barrier_choice">皮肤屏障</string>
    <string name="health_atlas_barrier_choice_sweat">汗液降温</string>
    <string name="health_atlas_barrier_scope">表皮更新与角质层的科普示意。水分路径用于比较，不代表实际失水量。</string>
    <string name="health_atlas_barrier_birth">基底层补充新细胞</string>
    <string name="health_atlas_barrier_birth_caption">表皮基底层不断产生新的角质形成细胞，把较早形成的细胞推向表面。</string>
    <string name="health_atlas_barrier_flatten">细胞逐渐变扁</string>
    <string name="health_atlas_barrier_flatten_caption">角质形成细胞向表面分化，逐渐变扁。最外层的角质细胞不再有细胞核。</string>
    <string name="health_atlas_barrier_lipids">脂质填入细胞间隙</string>
    <string name="health_atlas_barrier_lipids_caption">颗粒层细胞把脂质释放到细胞外，脂质排列成薄层，包围扁平的角质细胞。</string>
    <string name="health_atlas_barrier_water">完整角质层减慢水分流失</string>
    <string name="health_atlas_barrier_water_caption">水分仍会缓慢向外扩散。细胞间脂质层受损时，水分较容易穿过角质层。</string>
    <string name="health_atlas_barrier_shed">表面脱落，底部补充</string>
    <string name="health_atlas_barrier_shed_caption">最外侧的角质细胞会脱落，下方不断有新分化的细胞补上。这是持续更新的屏障。</string>
    <string name="health_atlas_barrier_basal">基底层</string>
    <string name="health_atlas_barrier_cornea">角质层</string>
    <string name="health_atlas_barrier_granular">颗粒层</string>
    <string name="health_atlas_barrier_intercellular">细胞间脂质</string>
    <string name="health_atlas_barrier_intact">结构完整</string>
    <string name="health_atlas_barrier_disrupted">脂质层受损</string>
    <string name="health_atlas_barrier_source_lipids">角质层脂质排列研究</string>
    <string name="health_atlas_barrier_source_secretion">表皮分化与脂质释放研究</string>
    <string name="health_atlas_sperm_flow_title">精子如何形成、成熟和运输</string>
    <string name="health_atlas_sperm_flow_scope">男性生殖道与细胞变化的科普示意。运动幅度和用时不代表实际个体数据。</string>
    <string name="health_atlas_sperm_flow_form">曲细精管内形成</string>
    <string name="health_atlas_sperm_flow_form_caption">生殖细胞在支持细胞旁逐步发育，经过减数分裂和形态变化，最后由管壁释放到管腔。</string>
    <string name="health_atlas_sperm_flow_transfer">进入附睾头</string>
    <string name="health_atlas_sperm_flow_transfer_caption">管内液体帮助把精子从曲细精管送入睾丸网，再经输出小管进入附睾头。</string>
    <string name="health_atlas_sperm_flow_mature">在附睾内进一步成熟</string>
    <string name="health_atlas_sperm_flow_mature_caption">通过盘曲的附睾管时，精子的细胞膜与运动能力逐渐变化，获得向前运动的能力。</string>
    <string name="health_atlas_sperm_flow_store">在附睾尾暂存</string>
    <string name="health_atlas_sperm_flow_store_caption">成熟的精子可暂存在附睾尾。获得运动能力，不等于要靠精子自己游完整个生殖道。</string>
    <string name="health_atlas_sperm_flow_move">输精管收缩推动运输</string>
    <string name="health_atlas_sperm_flow_move_caption">射精时，输精管壁的平滑肌收缩，使管内液体和精子沿输精管向前移动。</string>
    <string name="health_atlas_sperm_flow_lumen">曲细精管腔</string>
    <string name="health_atlas_sperm_flow_sertoli">支持细胞</string>
    <string name="health_atlas_sperm_flow_rete">睾丸网</string>
    <string name="health_atlas_sperm_flow_efferent">输出小管</string>
    <string name="health_atlas_sperm_flow_head">附睾头</string>
    <string name="health_atlas_sperm_flow_tail">附睾尾</string>
    <string name="health_atlas_sperm_flow_vas">输精管</string>
    <string name="health_atlas_sperm_flow_wall">平滑肌收缩</string>
    <string name="health_atlas_sperm_flow_source_mature">人附睾内的精子成熟研究</string>
    <string name="health_atlas_sperm_flow_source_storage">附睾成熟与储存研究</string>
    <string name="health_atlas_ovum_flow_title">卵母细胞如何排出并进入输卵管</string>
    <string name="health_atlas_ovum_flow_scope">排卵与输卵管运输的科普示意，不用于预测排卵日或受孕。</string>
    <string name="health_atlas_ovum_flow_grow">卵泡发育</string>
    <string name="health_atlas_ovum_flow_grow_caption">卵巢里发育中的卵泡逐渐增大。卵母细胞仍位于卵泡内，外面包着一圈支持它的卵丘细胞。</string>
    <string name="health_atlas_ovum_flow_release">卵泡破裂，释放卵母细胞</string>
    <string name="health_atlas_ovum_flow_release_caption">排卵时，卵泡壁在靠近卵巢表面处打开，卵母细胞与周围的卵丘细胞一起释放。</string>
    <string name="health_atlas_ovum_flow_pickup">输卵管伞端接取</string>
    <string name="health_atlas_ovum_flow_pickup_caption">卵巢和输卵管口没有直接接在一起。伞端靠近卵巢，表面的纤毛帮助把卵母细胞带入管口。</string>
    <string name="health_atlas_ovum_flow_cilia">纤毛摆动，管壁协助</string>
    <string name="health_atlas_ovum_flow_cilia_caption">管内的纤毛有方向地摆动，输卵管平滑肌也会收缩；两者参与管内运输。</string>
    <string name="health_atlas_ovum_flow_ampulla">到达输卵管壶腹部</string>
    <string name="health_atlas_ovum_flow_ampulla_caption">卵母细胞被带到输卵管较宽的壶腹部，这里是通常发生受精的位置。排卵本身不代表受精，也不代表着床。</string>
