    <string name="health_atlas_ependymal_story_plate_caption">带纤毛的室管膜内衬切面</string>
    <string name="health_atlas_ependymal_story_feature_lumen">脑室腔</string>
    <string name="health_atlas_ependymal_story_feature_lumen_detail">这里充满脑脊液。图中只展示一处脑室壁的小区域。</string>
    <string name="health_atlas_ependymal_story_feature_cilia">运动纤毛</string>
    <string name="health_atlas_ependymal_story_feature_cilia_detail">成簇的纤毛伸入脑脊液，协调摆动会影响近壁液流。</string>
    <string name="health_atlas_ependymal_story_feature_bases">纤毛根部</string>
    <string name="health_atlas_ependymal_story_feature_bases_detail">每根纤毛都固定在细胞朝向脑室腔的一侧，也就是顶端表面。</string>
    <string name="health_atlas_ependymal_story_feature_lining">室管膜细胞层</string>
    <string name="health_atlas_ependymal_story_feature_lining_detail">相邻细胞并排相接，在这个切面中形成一层细胞厚的内衬。</string>
    <string name="health_atlas_ependymal_story_feature_tissue">下方的脑组织</string>
    <string name="health_atlas_ependymal_story_feature_tissue_detail">在背向脑室腔的一侧，室管膜内衬直接与神经组织相邻。</string>
