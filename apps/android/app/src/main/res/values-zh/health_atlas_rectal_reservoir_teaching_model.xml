    <string name="health_atlas_rectal_reservoir_title">经肛管排出的体积</string>
    <string name="health_atlas_rectal_reservoir_initial_volume">直肠内的初始体积</string>
    <string name="health_atlas_rectal_reservoir_release_share">排出比例</string>
