<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="health_atlas_clitoral_sensory_title">阴蒂感觉传导通路</string>
    <string name="health_atlas_clitoral_sensory_scope">成人解剖。剖视图和神经示意图展示结构与正常感觉信号的传导方向，未按比例绘制。</string>
    <string name="health_atlas_clitoral_sensory_choice">追踪感觉信号</string>
    <string name="health_atlas_clitoral_sensory_cutaway">阴蒂剖视图</string>
    <string name="health_atlas_clitoral_sensory_cutaway_caption">阴蒂体位于中线，远端为阴蒂头。两侧阴蒂脚从阴蒂体沿耻骨弓延伸。前庭球位于阴蒂脚内侧，是不同的结构。</string>
    <string name="health_atlas_clitoral_sensory_endings">感觉神经末梢</string>
    <string name="health_atlas_clitoral_sensory_endings_caption">感觉神经纤维分支的末梢位于阴蒂头组织内。图中展示一个信号从外周神经末梢传向所属神经。</string>
    <string name="health_atlas_clitoral_sensory_dorsal_route">阴蒂背神经通路</string>
    <string name="health_atlas_clitoral_sensory_dorsal_route_caption">两侧阴蒂背神经分别将阴蒂头和阴蒂体的感觉信号传向阴部神经。图中追踪其中一侧。</string>
    <string name="health_atlas_clitoral_sensory_sacral_entry">进入脊髓</string>
    <string name="health_atlas_clitoral_sensory_sacral_entry_caption">阴部神经中的感觉纤维经骶脊神经返回。信号经脊神经后根进入脊髓。图中展示一条通路。</string>
    <string name="health_atlas_clitoral_sensory_body">阴蒂体</string>
    <string name="health_atlas_clitoral_sensory_body_detail">成对的阴蒂海绵体构成中央的阴蒂体，其远端与阴蒂头相连。</string>
    <string name="health_atlas_clitoral_sensory_glans">阴蒂头</string>
    <string name="health_atlas_clitoral_sensory_glans_detail">阴蒂头是阴蒂圆钝的远端部分，含有感觉神经末梢。</string>
    <string name="health_atlas_clitoral_sensory_crura">成对的阴蒂脚</string>
    <string name="health_atlas_clitoral_sensory_crura_detail">每侧阴蒂脚由同侧阴蒂海绵体延续而成，沿同侧耻骨弓走行。</string>
    <string name="health_atlas_clitoral_sensory_bulbs">前庭球</string>
    <string name="health_atlas_clitoral_sensory_bulbs_detail">前庭球是位于前庭两侧、阴蒂脚内侧的一对独立勃起组织。</string>
    <string name="health_atlas_clitoral_sensory_afferent">感觉神经纤维</string>
    <string name="health_atlas_clitoral_sensory_dorsal_nerve">阴蒂背神经</string>
    <string name="health_atlas_clitoral_sensory_pudendal">阴部神经</string>
    <string name="health_atlas_clitoral_sensory_dorsal_root">骶脊神经后根</string>
    <string name="health_atlas_clitoral_sensory_cord">脊髓</string>
    <string name="health_atlas_clitoral_sensory_ref_anatomy">成人阴蒂的磁共振解剖</string>
    <string name="health_atlas_clitoral_sensory_ref_nerve">阴蒂背神经及其分布</string>
    <string name="health_atlas_clitoral_sensory_ref_route">阴蒂背神经的走行</string>
    <string name="health_atlas_clitoral_sensory_ref_sacral">阴部神经及其与骶神经的连接</string>

    <string name="health_atlas_vestibular_gland_title">前庭大腺分泌</string>
    <string name="health_atlas_vestibular_gland_scope">成人解剖。示意图展示腺体位置、显微结构和正常黏液流动的方向，未按比例绘制。</string>
    <string name="health_atlas_vestibular_gland_choice">追踪导管内的黏液</string>
    <string name="health_atlas_vestibular_gland_map">前庭大腺与导管</string>
    <string name="health_atlas_vestibular_gland_map_caption">两个小腺体位于阴道口后部两侧的深层组织。导管开口于前庭的后外侧缘，与位置更靠前的尿道外口分开。</string>
    <string name="health_atlas_vestibular_gland_acini">分泌黏液的腺泡</string>
    <string name="health_atlas_vestibular_gland_acini_caption">每个腺体都由多簇称为腺泡的小分泌单位组成。腺泡内衬分泌黏液的上皮细胞，黏液释放到腺泡中央的腔内。</string>
    <string name="health_atlas_vestibular_gland_collection">导管汇流</string>
    <string name="health_atlas_vestibular_gland_collection_caption">分支导管将各腺泡的黏液汇入该侧腺体的主导管。移动的轨迹表示黏液在管腔内的流向。</string>
    <string name="health_atlas_vestibular_gland_outlet">导管开口于前庭</string>
    <string name="health_atlas_vestibular_gland_outlet_caption">黏液经两侧短主导管流出，到达阴道口旁的前庭表面。两条导管均不通入尿道或阴道内。</string>
    <string name="health_atlas_vestibular_gland_urethral">尿道外口</string>
    <string name="health_atlas_vestibular_gland_urethral_detail">这是独立的开口，位于阴道口和两个腺体导管开口的前方。</string>
    <string name="health_atlas_vestibular_gland_pair">成对腺体</string>
    <string name="health_atlas_vestibular_gland_pair_detail">两个前庭大腺（巴氏腺）位于深层组织内，各含许多分泌黏液的小腺泡。</string>
    <string name="health_atlas_vestibular_gland_duct">腺体导管</string>
    <string name="health_atlas_vestibular_gland_duct_detail">每侧腺体都有一条细长的主导管，将黏液输送到前庭表面。</string>
    <string name="health_atlas_vestibular_gland_pores">成对导管开口</string>
    <string name="health_atlas_vestibular_gland_pores_detail">导管开口位于阴道口的后外侧，在此视图中约为四点钟和八点钟方向。</string>
    <string name="health_atlas_vestibular_gland_cells">分泌细胞</string>
    <string name="health_atlas_vestibular_gland_lumen">腺泡腔</string>
    <string name="health_atlas_vestibular_gland_branches">分支导管</string>
    <string name="health_atlas_vestibular_gland_main_duct">腺体主导管</string>
    <string name="health_atlas_vestibular_gland_ref_anatomy">成人前庭的解剖与组织学</string>
    <string name="health_atlas_vestibular_gland_ref_histology">前庭大腺与导管的组织学</string>
</resources>
