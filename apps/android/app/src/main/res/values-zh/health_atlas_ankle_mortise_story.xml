    <string name="health_atlas_ankle_mortise_dorsiflex">脚尖向上</string>
    <string name="health_atlas_ankle_mortise_neutral">回到接近中立位</string>
    <string name="health_atlas_ankle_mortise_exaggerated">细小位移已放大</string>
