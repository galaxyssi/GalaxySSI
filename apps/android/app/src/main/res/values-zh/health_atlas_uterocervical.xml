    <string name="health_atlas_uterocervical_endometrium_detail">子宫内膜衬在宫腔表面。</string>
    <string name="health_atlas_uterocervical_myometrium_detail">交错排列的平滑肌构成子宫体壁的主体。</string>
    <string name="health_atlas_uterocervical_perimetrium_detail">这层薄浆膜覆盖子宫外表面的一部分。</string>
    <string name="health_atlas_uterocervical_internal_os_detail">宫腔与宫颈管相接处的上端狭窄开口。</string>
    <string name="health_atlas_uterocervical_canal_detail">宫颈内的通道有腺上皮衬里，周围组织富含胶原。</string>
    <string name="health_atlas_uterocervical_external_os_detail">宫颈管的下端开口通向阴道上部。</string>
