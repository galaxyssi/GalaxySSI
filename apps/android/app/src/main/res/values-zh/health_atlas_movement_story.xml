    <string name="health_atlas_motion_calcium">肌纤维内释放钙</string>
    <string name="health_atlas_motion_calcium_caption">兴奋沿横管向内传递，促使肌浆网将钙离子释放到肌纤维内部。</string>
    <string name="health_atlas_motion_slide">肌丝滑动</string>
    <string name="health_atlas_motion_slide_caption">肌球蛋白头抓住肌动蛋白并向内拉动。新的 ATP 使两者分离，ATP 水解使头部复位。缩短的是肌节，两种肌丝长度不变。</string>
    <string name="health_atlas_motion_bridge_bind">肌球蛋白头结合肌动蛋白</string>
    <string name="health_atlas_motion_bridge_pull">动力冲程：拉动肌动蛋白</string>
    <string name="health_atlas_motion_bridge_detach">ATP 结合：肌球蛋白头脱离</string>
    <string name="health_atlas_motion_bridge_reset">ATP 水解：肌球蛋白头复位</string>
    <string name="health_atlas_motion_pull">肌腱带动前臂</string>
    <string name="health_atlas_motion_pull_caption">肱二头肌收缩，肌腱将拉力传给桡骨，前臂绕肘关节抬起。</string>
    <string name="health_atlas_motion_release">舒张与伸肘</string>
    <string name="health_atlas_motion_release_caption">钙回到肌浆网，肱二头肌舒张。肱三头肌收缩，通过肌腱拉动尺骨，使肘伸直。</string>
    <string name="health_atlas_bone_sense">骨细胞感知变化</string>
    <string name="health_atlas_bone_sense_caption">埋在骨内的骨细胞可感知受力或局部损伤的变化，参与调节重塑。</string>
    <string name="health_atlas_bone_remove">破骨细胞吸收旧骨</string>
    <string name="health_atlas_bone_remove_caption">多核的破骨细胞贴附骨表面，分解矿物和有机基质，留下吸收凹陷。</string>
    <string name="health_atlas_bone_prepare">转换阶段</string>
    <string name="health_atlas_bone_prepare_caption">部分骨表面细胞清理吸收区并为新骨形成做准备。吸收和准备可在相邻区域重叠。</string>
    <string name="health_atlas_bone_fill">成骨细胞形成新基质</string>
    <string name="health_atlas_bone_fill_caption">成骨细胞分泌尚未矿化的骨基质（类骨质），局部凹陷逐步填充。</string>
    <string name="health_atlas_bone_mineral">新骨基质矿化</string>
    <string name="health_atlas_bone_mineral_caption">新基质逐步矿化。部分成骨细胞被包入基质并成为骨细胞。</string>
