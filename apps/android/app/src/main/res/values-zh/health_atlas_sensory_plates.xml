<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="health_atlas_sensory_oligo_process">髓鞘形成突起</string>
    <string name="health_atlas_sensory_oligo_process_detail">一个少突胶质细胞可伸出多个突起，为中枢神经系统的多个轴突节段形成髓鞘。</string>
    <string name="health_atlas_sensory_oligo_myelin">髓鞘节段</string>
    <string name="health_atlas_sensory_oligo_myelin_detail">包裹层为轴突节段提供绝缘。髓鞘之间的间隙是郎飞结，轴突本身没有断开。</string>
    <string name="health_atlas_sensory_microglia_surveillance">巡查突起</string>
    <string name="health_atlas_sensory_microglia_surveillance_detail">小胶质细胞的突起可持续巡查周围组织。</string>
    <string name="health_atlas_sensory_microglia_body">胞体</string>
    <string name="health_atlas_sensory_microglia_body_detail">小胶质细胞是中枢神经系统的常驻免疫细胞，也能清除碎片。</string>
    <string name="health_atlas_sensory_ependymal_cilia">面向脑室的纤毛</string>
    <string name="health_atlas_sensory_ependymal_cilia_detail">运动纤毛帮助脑脊液沿脑室表面局部流动。</string>
    <string name="health_atlas_sensory_ependymal_lining">脑室衬里</string>
    <string name="health_atlas_sensory_ependymal_lining_detail">室管膜细胞衬在脑室腔内。图中不是脉络丛专门分泌脑脊液的上皮。</string>
    <string name="health_atlas_sensory_satellite_glial_shell">卫星胶质细胞</string>
    <string name="health_atlas_sensory_satellite_glial_shell_detail">扁平的卫星胶质细胞包绕外周神经节内的神经元胞体。</string>
    <string name="health_atlas_sensory_satellite_neuron">神经节神经元胞体</string>
    <string name="health_atlas_sensory_satellite_neuron_detail">中央神经元用于位置参照；周围的胶质细胞不同于轴突上的施万细胞。</string>
    <string name="health_atlas_sensory_rod_discs">外节盘膜</string>
    <string name="health_atlas_sensory_rod_discs_detail">视杆细胞外节吸收的光子可启动感光转导。视杆对昏暗视觉尤其重要。</string>
    <string name="health_atlas_sensory_rod_spherule">视杆球形突触末端</string>
    <string name="health_atlas_sensory_rod_spherule_detail">光改变这里的谷氨酸释放。视神经传递的动作电位在下游产生。</string>
    <string name="health_atlas_sensory_cone_outer_segment">锥形外节</string>
    <string name="health_atlas_sensory_cone_outer_segment_detail">不同视锥类型对波长的敏感性不同。比较它们的响应有助于形成色觉。</string>
    <string name="health_atlas_sensory_cone_pedicle">视锥突触末端</string>
    <string name="health_atlas_sensory_cone_pedicle_detail">较宽的突触末端通过递质释放的变化传递渐变信号。</string>
    <string name="health_atlas_sensory_rpe_apical">顶端突起</string>
    <string name="health_atlas_sensory_rpe_apical_detail">顶端突起邻近感光细胞外节。色素上皮参与视觉循环，也处理脱落的外节物质。</string>
    <string name="health_atlas_sensory_rpe_pigment">色素颗粒</string>
    <string name="health_atlas_sensory_rpe_pigment_detail">含黑色素的颗粒有助于减少杂散光。</string>
    <string name="health_atlas_sensory_rgc_dendrites">视网膜内的树突</string>
    <string name="health_atlas_sensory_rgc_dendrites_detail">树突在视网膜内层接收处理后的信息。</string>
    <string name="health_atlas_sensory_rgc_axon">输出轴突</string>
    <string name="health_atlas_sensory_rgc_axon_detail">神经节细胞的轴突传出动作电位，并汇聚成视神经。</string>
    <string name="health_atlas_sensory_hair_bundle">静纤毛束</string>
    <string name="health_atlas_sensory_hair_bundle_detail">纤毛束偏转会改变机械敏感通道的活动。这里展示耳蜗内毛细胞示例。</string>
    <string name="health_atlas_sensory_hair_afferent_contact">传入神经接点</string>
    <string name="health_atlas_sensory_hair_afferent_contact_detail">毛细胞向感觉神经末梢释放递质，动作电位由神经纤维传出。</string>
    <string name="health_atlas_sensory_olfactory_cilia_field">嗅纤毛</string>
    <string name="health_atlas_sensory_olfactory_cilia_field_detail">气味分子接触自树突顶端伸出的、带有受体的嗅纤毛。</string>
    <string name="health_atlas_sensory_olfactory_basal_axon">基底侧轴突</string>
    <string name="health_atlas_sensory_olfactory_basal_axon_detail">轴突从上皮基底侧通向嗅球。</string>
    <string name="health_atlas_sensory_taste_microvilli">味孔内的微绒毛</string>
    <string name="health_atlas_sensory_taste_microvilli_detail">顶端微绒毛接触溶解在唾液中的分子。</string>
    <string name="health_atlas_sensory_taste_afferent">感觉神经接点</string>
    <string name="health_atlas_sensory_taste_afferent_detail">味觉细胞将信号传向感觉神经纤维，传递机制因细胞亚型而异。</string>
    <string name="health_atlas_sensory_cornea_apical">角膜上皮表层</string>
    <string name="health_atlas_sensory_cornea_apical_detail">浅表细胞参与维持朝向泪膜的角膜屏障。</string>
    <string name="health_atlas_sensory_cornea_epithelial_basal">角膜上皮基底细胞</string>
    <string name="health_atlas_sensory_cornea_epithelial_basal_detail">基底细胞靠近基底膜，位于较扁平的表层细胞下方。</string>
    <string name="health_atlas_sensory_merkel_basal_cell">表皮基底层的梅克尔细胞</string>
    <string name="health_atlas_sensory_merkel_basal_cell_detail">梅克尔细胞位于表皮基底层，是触觉感受复合体的一部分。</string>
    <string name="health_atlas_sensory_merkel_afferent">感觉神经末梢</string>
    <string name="health_atlas_sensory_merkel_afferent_detail">感觉神经末梢与梅克尔细胞接触。该复合体参与持续触压和纹理感知。</string>
    <string name="health_atlas_sensory_bipolar_dendrites">感光细胞输入</string>
    <string name="health_atlas_sensory_bipolar_dendrites_detail">双极细胞接收感光细胞的输入。杆双极和锥双极细胞参与不同回路。</string>
    <string name="health_atlas_sensory_bipolar_terminal">中继突触末端</string>
    <string name="health_atlas_sensory_bipolar_terminal_detail">突触末端传递渐变信号。AII 无长突细胞是杆双极输出的重要中继。</string>
    <string name="health_atlas_sensory_aii_rod_input">杆双极细胞输入</string>
    <string name="health_atlas_sensory_aii_rod_input_detail">在经典昏暗视觉通路中，AII 无长突细胞接收杆双极细胞的信号。</string>
    <string name="health_atlas_sensory_aii_on_connection">ON 通路连接</string>
    <string name="health_atlas_sensory_aii_on_connection_detail">电性连接将信号传给 ON 锥双极细胞。图中未画其他 AII 连接。</string>
    <string name="health_atlas_sensory_retina_support_sheet">色素上皮</string>
    <string name="health_atlas_sensory_retina_support_sheet_detail">感光细胞外节邻近提供支持的色素上皮。入射光先穿过视网膜内层。</string>
    <string name="health_atlas_sensory_retina_relay_layer">中继层</string>
    <string name="health_atlas_sensory_retina_relay_layer_detail">双极和无长突细胞回路在神经节细胞输出前传递并处理信号。</string>
    <string name="health_atlas_sensory_retina_light_direction">入射光方向</string>
    <string name="health_atlas_sensory_retina_light_direction_detail">金色箭头从视网膜内侧指向感光细胞外节。</string>
    <string name="health_atlas_sensory_retina_signal_direction">信号传递方向</string>
    <string name="health_atlas_sensory_retina_signal_direction_detail">蓝色箭头指回神经节细胞层，与入射光方向不同。</string>
