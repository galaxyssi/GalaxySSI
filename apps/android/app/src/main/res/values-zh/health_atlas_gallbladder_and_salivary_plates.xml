<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="health_atlas_gallbladder_cutaway_caption">胆囊与肝外胆管</string>
    <string name="health_atlas_gallbladder_cutaway_selector">胆管走行</string>
    <string name="health_atlas_gallbladder_cutaway_fundus">胆囊底</string>
    <string name="health_atlas_gallbladder_cutaway_fundus_detail">胆囊底是胆囊圆钝的盲端，伸出肝下缘。</string>
    <string name="health_atlas_gallbladder_cutaway_body">胆囊体</string>
    <string name="health_atlas_gallbladder_cutaway_body_detail">胆囊中部较宽，贴在肝脏下方。剖面露出了储存胆汁的胆囊腔。</string>
    <string name="health_atlas_gallbladder_cutaway_neck">胆囊颈</string>
    <string name="health_atlas_gallbladder_cutaway_neck_detail">胆囊在此处逐渐变窄，与胆囊管相接。</string>
    <string name="health_atlas_gallbladder_cutaway_cystic">胆囊管</string>
    <string name="health_atlas_gallbladder_cutaway_cystic_detail">胆汁经这条短管进出胆囊。胆囊管与肝总管汇合后形成胆总管。</string>
    <string name="health_atlas_gallbladder_cutaway_common">胆总管</string>
    <string name="health_atlas_gallbladder_cutaway_common_detail">这条管道从胆囊管与肝总管的汇合处向下延伸，将胆汁送往十二指肠。</string>
    <string name="health_atlas_gallbladder_cutaway_papilla">十二指肠大乳头</string>
    <string name="health_atlas_gallbladder_cutaway_papilla_detail">这是十二指肠降部内壁上的小突起。通常胆总管与主胰管共用此处的开口，胆汁由此进入肠腔；图中未画出主胰管。</string>
    <string name="health_atlas_parotid_cutaway_caption">腮腺与颊部导管</string>
    <string name="health_atlas_parotid_cutaway_selector">腮腺管走行</string>
    <string name="health_atlas_parotid_cutaway_gland">腮腺</string>
    <string name="health_atlas_parotid_cutaway_gland_detail">腮腺左右各一，图中显示其中一侧。它位于耳的前下方，覆盖下颌骨后部。</string>
    <string name="health_atlas_parotid_cutaway_duct">腮腺管</string>
    <string name="health_atlas_parotid_cutaway_duct_detail">腮腺管（斯滕森管）从腮腺前缘出发，沿咀嚼用的咬肌外表面向前走行。</string>
    <string name="health_atlas_parotid_cutaway_turn">转入颊部</string>
    <string name="health_atlas_parotid_cutaway_turn_detail">腮腺管到达咬肌前缘后向内转弯，穿过组成颊壁的颊肌。</string>
    <string name="health_atlas_parotid_cutaway_papilla">腮腺管乳头</string>
    <string name="health_atlas_parotid_cutaway_papilla_detail">腮腺管开口于颊内侧的这个小突起，正对上颌第二磨牙。开口在颊黏膜上，并不在牙龈上。</string>
    <string name="health_atlas_submandibular_cutaway_caption">下颌下腺与口底</string>
    <string name="health_atlas_submandibular_cutaway_selector">口底导管走行</string>
    <string name="health_atlas_submandibular_cutaway_superficial">浅部</string>
    <string name="health_atlas_submandibular_cutaway_superficial_detail">下颌下腺的大部分位于下颌骨下方，在支撑口底的下颌舌骨肌下侧。</string>
    <string name="health_atlas_submandibular_cutaway_deep">深部</string>
    <string name="health_atlas_submandibular_cutaway_deep_detail">同一个腺体绕过下颌舌骨肌的游离后缘。较小的深部位于肌肉上方，并发出下颌下腺管。</string>
    <string name="health_atlas_submandibular_cutaway_mylohyoid">下颌舌骨肌</string>
    <string name="health_atlas_submandibular_cutaway_mylohyoid_detail">这片肌肉构成口底。下颌下腺浅部在肌肉下方，深部及相邻的舌下腺在肌肉上方。</string>
    <string name="health_atlas_submandibular_cutaway_duct">下颌下腺管</string>
    <string name="health_atlas_submandibular_cutaway_duct_detail">下颌下腺的主管又称沃顿管，沿相邻舌下腺靠舌的一侧向前走行，到达口底前部。</string>
    <string name="health_atlas_submandibular_cutaway_neighbor">舌下腺</string>
    <string name="health_atlas_submandibular_cutaway_neighbor_detail">这是紧贴口底黏膜下方的独立腺体，不是下颌下腺的深部。它的多条舌下腺小管沿隆起的舌下襞开口。</string>
    <string name="health_atlas_submandibular_cutaway_caruncle">舌下阜</string>
    <string name="health_atlas_submandibular_cutaway_caruncle_detail">舌系带旁的这个小突起虽然名为舌下阜，却是下颌下腺主管的开口处。图中未画出另一侧的对应开口。</string>
</resources>
