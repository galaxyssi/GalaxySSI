<resources>
    <string name="health_atlas_endocrine_thy_apical">胶质面</string>
    <string name="health_atlas_endocrine_thy_apical_detail">滤泡细胞围成含胶质的腔，胶质中储存甲状腺球蛋白。</string>
    <string name="health_atlas_endocrine_thy_basal">血管侧</string>
    <string name="health_atlas_endocrine_thy_basal_detail">促甲状腺激素（TSH）作用于基底侧，甲状腺激素释放到周围的微血管。</string>
    <string name="health_atlas_endocrine_c_cell_periphery">滤泡腔外</string>
    <string name="health_atlas_endocrine_c_cell_periphery_detail">图中 C 细胞紧邻滤泡上皮，不直接通向胶质所在的腔。</string>
    <string name="health_atlas_endocrine_c_cell_granules">降钙素颗粒</string>
    <string name="health_atlas_endocrine_c_cell_granules_detail">C 细胞分泌降钙素；T3 和 T4 则由滤泡细胞产生。</string>
    <string name="health_atlas_endocrine_chief_calcium_sensing">钙感知表面</string>
    <string name="health_atlas_endocrine_chief_calcium_sensing_detail">主细胞感知细胞外钙；血钙下降一般会促进甲状旁腺激素（PTH）释放。</string>
    <string name="health_atlas_endocrine_chief_pth_granules">PTH 颗粒</string>
    <string name="health_atlas_endocrine_chief_pth_granules_detail">PTH 进入局部血液循环，参与全身钙稳态调节。</string>
    <string name="health_atlas_endocrine_cortex_lipid">脂滴</string>
    <string name="health_atlas_endocrine_cortex_lipid_detail">束状带细胞示例。脂滴可储存胆固醇酯，为类固醇激素合成提供原料。</string>
    <string name="health_atlas_endocrine_cortex_mitochondrion">线粒体</string>
    <string name="health_atlas_endocrine_cortex_mitochondrion_detail">类固醇合成的部分步骤在线粒体中完成；皮质各区的分泌功能并不相同。</string>
    <string name="health_atlas_endocrine_chroma_neural_input">交感神经末梢</string>
    <string name="health_atlas_endocrine_chroma_neural_input_detail">交感节前神经输入可激活肾上腺髓质的嗜铬细胞。</string>
    <string name="health_atlas_endocrine_chroma_vesicles">儿茶酚胺囊泡</string>
    <string name="health_atlas_endocrine_chroma_vesicles_detail">致密颗粒储存肾上腺素或去甲肾上腺素等儿茶酚胺，随后释放入血。</string>
    <string name="health_atlas_endocrine_somatotroph_hormone">生长激素颗粒</string>
    <string name="health_atlas_endocrine_somatotroph_hormone_detail">生长激素（GH）直接或经 IGF-1 等信号参与生长与代谢。</string>
    <string name="health_atlas_endocrine_somatotroph_nucleus">细胞核</string>
    <string name="health_atlas_endocrine_somatotroph_nucleus_detail">此示意以分泌功能区分细胞，不能用形状或颜色鉴别真实组织中的细胞。</string>
    <string name="health_atlas_endocrine_lactotroph_hormone">催乳素颗粒</string>
    <string name="health_atlas_endocrine_lactotroph_hormone_detail">催乳素促进乳汁生成，与催产素介导的排乳不同。</string>
    <string name="health_atlas_endocrine_lactotroph_nucleus">细胞核</string>
    <string name="health_atlas_endocrine_lactotroph_nucleus_detail">此示意以分泌功能区分细胞，不能用形状或颜色鉴别真实组织中的细胞。</string>
    <string name="health_atlas_endocrine_corticotroph_hormone">促肾上腺皮质激素颗粒</string>
    <string name="health_atlas_endocrine_corticotroph_hormone_detail">ACTH 促进肾上腺皮质产生皮质醇，不是给肾上腺髓质的神经信号。</string>
    <string name="health_atlas_endocrine_corticotroph_nucleus">细胞核</string>
    <string name="health_atlas_endocrine_corticotroph_nucleus_detail">此示意以分泌功能区分细胞，不能用形状或颜色鉴别真实组织中的细胞。</string>
    <string name="health_atlas_endocrine_thyrotroph_hormone">促甲状腺激素颗粒</string>
    <string name="health_atlas_endocrine_thyrotroph_hormone_detail">TSH 刺激甲状腺滤泡细胞；甲状腺激素反馈有助于抑制 TSH 释放。</string>
    <string name="health_atlas_endocrine_thyrotroph_nucleus">细胞核</string>
    <string name="health_atlas_endocrine_thyrotroph_nucleus_detail">此示意以分泌功能区分细胞，不能用形状或颜色鉴别真实组织中的细胞。</string>
    <string name="health_atlas_endocrine_gonadotroph_hormone">促性腺激素颗粒</string>
    <string name="health_atlas_endocrine_gonadotroph_hormone_detail">促性腺激素细胞响应下丘脑信号，分泌 LH 和 FSH。</string>
    <string name="health_atlas_endocrine_gonadotroph_nucleus">细胞核</string>
    <string name="health_atlas_endocrine_gonadotroph_nucleus_detail">此示意以分泌功能区分细胞，不能用形状或颜色鉴别真实组织中的细胞。</string>
    <string name="health_atlas_endocrine_pineal_process">松果体细胞突起</string>
    <string name="health_atlas_endocrine_pineal_process_detail">松果体细胞的突起伸向腺体周围。褪黑素传递昼夜信息，图示不代表个人水平。</string>
    <string name="health_atlas_endocrine_pineal_body">松果体细胞胞体</string>
    <string name="health_atlas_endocrine_pineal_body_detail">松果体细胞是松果体中主要产生褪黑素的细胞。</string>
    <string name="health_atlas_endocrine_leydig_interstitium">间质细胞</string>
    <string name="health_atlas_endocrine_leydig_interstitium_detail">莱迪希细胞位于曲细精管之间，不属于支持精子发育的管内上皮。</string>
    <string name="health_atlas_endocrine_leydig_lipid">脂滴</string>
    <string name="health_atlas_endocrine_leydig_lipid_detail">莱迪希细胞响应 LH，利用胆固醇相关底物合成睾酮。</string>
    <string name="health_atlas_endocrine_granulosa_lining">颗粒细胞层</string>
    <string name="health_atlas_endocrine_granulosa_lining_detail">颗粒细胞位于卵泡内部，包围并支持卵母细胞。</string>
    <string name="health_atlas_endocrine_granulosa_oocyte">邻近卵母细胞</string>
    <string name="health_atlas_endocrine_granulosa_oocyte_detail">卵母细胞只作为位置参照，不属于颗粒细胞。</string>
    <string name="health_atlas_endocrine_theca_outer_zone">卵泡膜层</string>
    <string name="health_atlas_endocrine_theca_outer_zone_detail">卵泡膜环绕颗粒细胞层。图中高亮的是参与合成类固醇的内卵泡膜。</string>
    <string name="health_atlas_endocrine_theca_vascular_side">血管侧</string>
    <string name="health_atlas_endocrine_theca_vascular_side_detail">卵泡膜位于卵泡基底膜的血管侧，颗粒细胞层和卵泡腔位于内侧。</string>
    <string name="health_atlas_endocrine_thy_follicle_colloid">滤泡胶质</string>
    <string name="health_atlas_endocrine_thy_follicle_colloid_detail">甲状腺球蛋白在滤泡胶质中储存；这里不是血液激素检测的位置。</string>
    <string name="health_atlas_endocrine_para_pair_upper">上方甲状旁腺示例</string>
    <string name="health_atlas_endocrine_para_pair_upper_detail">甲状旁腺通常位于甲状腺背面，实际位置因人而异。</string>
    <string name="health_atlas_endocrine_para_pair_lower">下方甲状旁腺示例</string>
    <string name="health_atlas_endocrine_para_pair_lower_detail">这里展示常见的四腺体分布。甲状旁腺有独立功能，不属于甲状腺激素分泌路径。</string>
    <string name="health_atlas_endocrine_adrenal_capsule">被膜</string>
    <string name="health_atlas_endocrine_adrenal_capsule_detail">肾上腺外层包绕着结缔组织被膜。</string>
    <string name="health_atlas_endocrine_adrenal_cortex">皮质</string>
    <string name="health_atlas_endocrine_adrenal_cortex_detail">皮质不同区域分别产生不同的类固醇激素，高亮位置在皮质内。</string>
    <string name="health_atlas_endocrine_adrenal_medulla">髓质</string>
    <string name="health_atlas_endocrine_adrenal_medulla_detail">中央髓质含嗜铬细胞，与产生类固醇的皮质不同。</string>
    <string name="health_atlas_endocrine_pit_anterior">垂体前叶</string>
    <string name="health_atlas_endocrine_pit_anterior_detail">腺性前叶产生 ACTH、TSH、催乳素等激素。</string>
    <string name="health_atlas_endocrine_pit_posterior">垂体后叶</string>
    <string name="health_atlas_endocrine_pit_posterior_detail">后叶释放由下丘脑合成的催产素和加压素，后叶本身不合成这两种激素。</string>
    <string name="health_atlas_endocrine_pit_stalk">垂体柄</string>
    <string name="health_atlas_endocrine_pit_stalk_detail">垂体柄连接垂体与下丘脑，内有血管和神经纤维。</string>
