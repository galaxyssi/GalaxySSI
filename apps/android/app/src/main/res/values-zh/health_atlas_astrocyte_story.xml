    <string name="health_atlas_astrocyte_story_capillary">毛细血管</string>
    <string name="health_atlas_astrocyte_story_endfoot">星形胶质细胞终足</string>
    <string name="health_atlas_astrocyte_story_glutamate">谷氨酸</string>
    <string name="health_atlas_astrocyte_story_glutamine">谷氨酰胺</string>
    <string name="health_atlas_astrocyte_story_potassium">钾离子</string>
    <string name="health_atlas_astrocyte_story_ref_cycle">Lebon 等 · 人脑中的谷氨酸循环利用</string>
