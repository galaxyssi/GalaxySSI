<resources>
    <string name="health_atlas_context_mast_granules">含组胺颗粒</string>
    <string name="health_atlas_context_mast_granules_detail">肥大细胞的颗粒储存组胺等介质，免疫应答时可释放。</string>
    <string name="health_atlas_context_mast_resident">组织驻留细胞</string>
    <string name="health_atlas_context_mast_resident_detail">肥大细胞位于血管外组织，不是血中循环的嗜碱性粒细胞。</string>
    <string name="health_atlas_context_hsc_body">造血干细胞</string>
    <string name="health_atlas_context_hsc_body_detail">骨髓造血干细胞可自我更新，并产生不同血细胞谱系。不能仅凭形状判断细胞身份。</string>
    <string name="health_atlas_context_hsc_niche">骨髓微环境</string>
    <string name="health_atlas_context_hsc_niche_detail">周围细胞与血管环境共同参与维持造血干细胞的微环境。</string>
    <string name="health_atlas_context_helper_recognition">细胞接触区</string>
    <string name="health_atlas_context_helper_recognition_detail">图中展示辅助性 T 细胞与抗原呈递细胞的接触。</string>
    <string name="health_atlas_context_helper_coordination">协调信号</string>
    <string name="health_atlas_context_helper_coordination_detail">辅助性 T 细胞可传递信号，支持其他免疫细胞。颜色用于区分图示角色，并非染色结果。</string>
    <string name="health_atlas_context_cytotoxic_interface">靶细胞接触区</string>
    <string name="health_atlas_context_cytotoxic_interface_detail">图中展示对已识别靶细胞的接触，不代表不加区分地损伤细胞。</string>
    <string name="health_atlas_context_cytotoxic_granules">接触面附近颗粒</string>
    <string name="health_atlas_context_cytotoxic_granules_detail">活化的细胞毒性 T 细胞可诱导与其接触的靶细胞发生程序性死亡。</string>
    <string name="health_atlas_context_regulatory_contact">调节接触区</string>
    <string name="health_atlas_context_regulatory_contact_detail">调节性 T 细胞有助于约束某些免疫应答。这里是功能示意，不是病理样本。</string>
    <string name="health_atlas_context_regulatory_neighbor">邻近免疫细胞</string>
    <string name="health_atlas_context_regulatory_neighbor_detail">右侧仅为邻近免疫细胞，不是另一个调节性 T 细胞。</string>
    <string name="health_atlas_context_pericyte_outer">血管外侧周细胞</string>
    <string name="health_atlas_context_pericyte_outer_detail">周细胞位于微血管外侧，不处在血流中。</string>
    <string name="health_atlas_context_pericyte_wrap">包绕突起</string>
    <string name="health_atlas_context_pericyte_wrap_detail">突起沿血管延伸，参与微血管支撑和信号交流。</string>
    <string name="health_atlas_context_lymph_flap">重叠的内皮边缘</string>
    <string name="health_atlas_context_lymph_flap_detail">这里展示初始淋巴毛细管；内皮边缘重叠，组织液可从这里进入。</string>
    <string name="health_atlas_context_lymph_lumen">淋巴管腔</string>
    <string name="health_atlas_context_lymph_lumen_detail">管腔是组织液汇入后的空间。图中结构不是较大集合淋巴管的瓣膜。</string>
    <string name="health_atlas_context_sertoli_germ_support">发育中的生殖细胞</string>
    <string name="health_atlas_context_sertoli_germ_support_detail">支持细胞的胞质跨越曲细精管上皮的大部分厚度，与发育中的生殖细胞接触。</string>
    <string name="health_atlas_context_sertoli_junction">支持细胞连接</string>
    <string name="health_atlas_context_sertoli_junction_detail">相邻支持细胞的连接参与形成血睾屏障。</string>
    <string name="health_atlas_context_spermatogonia_basal">基底区</string>
    <string name="health_atlas_context_spermatogonia_basal_detail">精原细胞靠近基底膜，一部分自我更新，另一部分进入分化。</string>
    <string name="health_atlas_context_spermatogonia_lamina">基底膜</string>
    <string name="health_atlas_context_spermatogonia_lamina_detail">这条边界代表曲细精管上皮的基底膜。</string>
    <string name="health_atlas_context_spermatocyte_primary">初级精母细胞</string>
    <string name="health_atlas_context_spermatocyte_primary_detail">靠近管腔的这个示例处于减数第一次分裂阶段，不同于基底区精原细胞。</string>
    <string name="health_atlas_context_spermatocyte_bivalent">同源染色体配对</string>
    <string name="health_atlas_context_spermatocyte_bivalent_detail">图中简化了染色体配对，不代表全部染色体的实际数量或形态。</string>
    <string name="health_atlas_context_oviduct_cilia">运动纤毛</string>
    <string name="health_atlas_context_oviduct_cilia_detail">输卵管上皮纤毛与平滑肌运动一起参与管腔内运输。</string>
    <string name="health_atlas_context_oviduct_fold">上皮黏膜皱襞</string>
    <string name="health_atlas_context_oviduct_fold_detail">高亮细胞位于黏膜皱襞上，朝向输卵管腔。</string>
    <string name="health_atlas_context_endometrium_surface">面向宫腔的上皮面</string>
    <string name="health_atlas_context_endometrium_surface_detail">这里展示子宫内膜上皮，与下方的间质不同。</string>
    <string name="health_atlas_context_endometrium_gland">子宫腺上皮</string>
    <string name="health_atlas_context_endometrium_gland_detail">部分内膜上皮细胞衬在子宫腺内，并产生分泌物。</string>
    <string name="health_atlas_context_stroma_fibroblast">内膜间质细胞</string>
    <string name="health_atlas_context_stroma_fibroblast_detail">间质细胞位于内膜上皮下方，参与形成支撑组织。</string>
    <string name="health_atlas_context_stroma_matrix">细胞外基质</string>
    <string name="health_atlas_context_stroma_matrix_detail">周围基质参与组织结构的维持。图示不能推断个人周期阶段。</string>
    <string name="health_atlas_context_mammary_luminal_apex">面向乳腺腔的表面</string>
    <string name="health_atlas_context_mammary_luminal_apex_detail">腔面细胞衬在分泌单位内，向腺腔分泌乳汁成分。</string>
    <string name="health_atlas_context_mammary_myo_context">邻近肌上皮</string>
    <string name="health_atlas_context_mammary_myo_context_detail">外侧收缩层帮助排出已有乳汁，并非产生乳汁的腔面层。</string>
    <string name="health_atlas_context_trophoblast_syncytium">外层滋养组织</string>
    <string name="health_atlas_context_trophoblast_syncytium_detail">这是绒毛示例，多核外层与母体血液相邻。</string>
    <string name="health_atlas_context_trophoblast_villus">绒毛内部</string>
    <string name="health_atlas_context_trophoblast_villus_detail">绒毛内部含胎儿血管。图中母体和胎儿血液并未混合。</string>
    <string name="health_atlas_context_langerhans_dendrite">表皮内突起</string>
    <string name="health_atlas_context_langerhans_dendrite_detail">突起伸在角质形成细胞之间，可接触并采样表皮环境。</string>
    <string name="health_atlas_context_langerhans_body">朗格汉斯细胞胞体</string>
    <string name="health_atlas_context_langerhans_body_detail">这是表皮中的免疫细胞，不是感觉神经末梢。</string>
    <string name="health_atlas_context_sebocyte_lipid">脂滴</string>
    <string name="health_atlas_context_sebocyte_lipid_detail">皮脂腺细胞成熟时积累脂质，这些脂质是皮脂的组成部分。</string>
    <string name="health_atlas_context_sebocyte_duct">通向毛囊的出口</string>
    <string name="health_atlas_context_sebocyte_duct_detail">此例中腺体开口通向毛囊，与小汗腺导管不同。</string>
    <string name="health_atlas_context_eccrine_secretory_apex">分泌面</string>
    <string name="health_atlas_context_eccrine_secretory_apex_detail">小汗腺盘曲段的细胞向腔内分泌初始汗液，之后由导管调整其成分。</string>
    <string name="health_atlas_context_eccrine_lumen">盘曲部腔</string>
    <string name="health_atlas_context_eccrine_lumen_detail">这里展示汗腺分泌盘曲段的切面，不是皮肤表面汗孔。</string>
    <string name="health_atlas_context_hair_matrix_bulb">毛球内的毛母质</string>
    <string name="health_atlas_context_hair_matrix_bulb_detail">毛母质细胞分裂，后代参与形成毛发及其内根鞘。</string>
    <string name="health_atlas_context_hair_papilla_neighbor">相邻毛乳头</string>
    <string name="health_atlas_context_hair_papilla_neighbor_detail">毛乳头属于支撑性的真皮组织，不是毛母质细胞层。</string>
    <string name="health_atlas_context_muscle_satellite_body">肌卫星细胞</string>
    <string name="health_atlas_context_muscle_satellite_body_detail">高亮细胞位于基底膜与肌纤维细胞膜之间。</string>
    <string name="health_atlas_context_muscle_satellite_fiber">原有肌纤维</string>
    <string name="health_atlas_context_muscle_satellite_fiber_detail">肌纤维与肌卫星细胞是不同结构。肌卫星细胞的后代可参与修复，图示并不预测个人恢复。</string>
    <string name="health_atlas_context_tenocyte_nucleus">细长的细胞核</string>
    <string name="health_atlas_context_tenocyte_nucleus_detail">在这张纵切示意图中，细长的肌腱细胞位于胶原纤维束之间。</string>
    <string name="health_atlas_context_tenocyte_collagen">胶原纤维束</string>
    <string name="health_atlas_context_tenocyte_collagen_detail">这些细胞外纤维主要沿肌腱长轴排列。细胞突起接触周围的基质。</string>
    <string name="health_atlas_context_sweat_duct">汗腺导管</string>
    <string name="health_atlas_context_sweat_duct_detail">汗液沿导管向上流动，导管上皮可重吸收一部分盐。</string>
    <string name="health_atlas_context_sweat_pore">皮肤汗孔</string>
    <string name="health_atlas_context_sweat_pore_detail">导管开口于皮肤表面，蒸发的汗液可带走热量。</string>
    <string name="health_atlas_context_hair_section_shaft">毛干</string>
    <string name="health_atlas_context_hair_section_shaft_detail">露出皮肤的毛干主要由角化细胞构成，形成它的活细胞位于毛球。</string>
    <string name="health_atlas_context_hair_section_papilla">毛乳头</string>
    <string name="health_atlas_context_hair_section_papilla_detail">毛乳头位于毛球底部，含结缔组织和毛细血管。</string>
