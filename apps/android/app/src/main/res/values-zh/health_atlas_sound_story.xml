<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="health_atlas_hear_title">声音如何进入大脑</string>
    <string name="health_atlas_hear_sound">声波沿外耳道前进</string>
    <string name="health_atlas_hear_sound_caption">外耳收集声音，空气中的压力波沿外耳道传到鼓膜。</string>
    <string name="health_atlas_hear_middle">鼓膜和听小骨接力</string>
    <string name="health_atlas_hear_middle_caption">声波让鼓膜振动。锤骨、砧骨、镫骨依次传递振动，由镫骨推动耳蜗入口处的卵圆窗。</string>
    <string name="health_atlas_hear_cochlea">耳蜗内形成行波</string>
    <string name="health_atlas_hear_cochlea_caption">卵圆窗的振动带动耳蜗内液体，使基底膜产生行波。耳蜗底部对较高音调更敏感，靠近顶端的位置对较低音调更敏感。</string>
    <string name="health_atlas_hear_hair">毛细胞把振动变成信号</string>
    <string name="health_atlas_hear_hair_caption">毛束朝较高的静纤毛偏转，拉紧尖端连接。通道开放增加，钾离子从内淋巴流入；去极化促使释放递质。</string>
    <string name="health_atlas_hear_nerve">听神经信号传到大脑</string>
    <string name="health_atlas_hear_nerve_caption">听神经把电脉冲传到脑干。信号再经过多级中继到达听觉皮层，由大脑进一步处理声音。</string>
