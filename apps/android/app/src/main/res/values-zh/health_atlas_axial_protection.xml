    <string name="health_atlas_vertebral_motion_ref_facets">在体研究：腰椎小关节的运动</string>
    <string name="health_atlas_vertebral_motion_plate_title">腰椎运动节段</string>
    <string name="health_atlas_vertebral_motion_plate_caption">两块相邻腰椎 · 侧面观，椎间盘为剖面</string>
    <string name="health_atlas_vertebral_motion_plate_body">椎骨前方较大的部分，通过椎体终板与椎间盘相接。</string>
    <string name="health_atlas_vertebral_motion_plate_annulus_title">纤维环</string>
    <string name="health_atlas_vertebral_motion_plate_annulus">由多层纤维构成的环，包绕椎间盘较软的中央部分。</string>
    <string name="health_atlas_vertebral_motion_plate_nucleus_title">髓核</string>
    <string name="health_atlas_vertebral_motion_plate_nucleus">椎间盘含水丰富的中央部分，有助于分散椎体间的压力。</string>
    <string name="health_atlas_vertebral_motion_plate_pedicle_title">椎弓根</string>
    <string name="health_atlas_vertebral_motion_plate_pedicle">连接前方椎体和后方椎弓的短骨桥。</string>
    <string name="health_atlas_vertebral_motion_plate_facet">相邻椎弓上相对的关节面，构成该节段成对小关节中的一个。</string>
    <string name="health_atlas_vertebral_motion_plate_spinous_title">棘突</string>
    <string name="health_atlas_vertebral_motion_plate_spinous">从椎弓向后伸出的骨性突起。</string>
</resources>
