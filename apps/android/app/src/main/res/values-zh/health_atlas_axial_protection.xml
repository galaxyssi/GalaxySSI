<resources>
    <string name="health_atlas_skull_protection_title">颅盖如何包围大脑</string>
    <string name="health_atlas_skull_protection_choice">颅盖及其分层</string>
    <string name="health_atlas_skull_protection_scope">成人解剖示意。放大剖面中的薄层和间隙未按比例绘制。</string>
    <string name="health_atlas_skull_protection_orientation">从上方观察颅盖</string>
    <string name="health_atlas_skull_protection_orientation_caption">图上方为前额。颅盖在脑的上方隆起，并向后脑延伸。虚线标出这个弧形顶盖的剖切位置。</string>
    <string name="health_atlas_skull_protection_sutures">颅骨相接的位置</string>
    <string name="health_atlas_skull_protection_sutures_caption">冠状缝分隔额骨和两块顶骨。矢状缝位于两块顶骨之间，向后连到人字缝，顶骨在这里与枕骨相接。这些不规则的骨缝是纤维性连接，并不像铰链那样活动。</string>
    <string name="health_atlas_skull_protection_bone">内外骨板夹着松质骨</string>
    <string name="health_atlas_skull_protection_bone_caption">剖面中，两层密质骨之间夹着称为板障的松质骨。它们共同形成坚硬的骨壁，覆盖在较柔软的脑膜和脑组织上方。</string>
    <string name="health_atlas_skull_protection_meninges">脑膜与液体缓冲</string>
    <string name="health_atlas_skull_protection_meninges_caption">硬脑膜贴着颅盖内面。蛛网膜跨过脑沟，软脑膜则紧贴脑表面并深入脑沟。两层膜之间的脑脊液为脑提供浮力和缓冲。移动的圆点用于标示这个间隙，不表示实际流向。</string>
    <string name="health_atlas_skull_protection_art_anterior">前方 · 前额</string>
    <string name="health_atlas_skull_protection_art_posterior">后方 · 后脑</string>
    <string name="health_atlas_skull_protection_art_vault_section">颅盖剖切位置</string>
    <string name="health_atlas_skull_protection_art_coronal">冠状缝</string>
    <string name="health_atlas_skull_protection_art_sagittal">矢状缝</string>
    <string name="health_atlas_skull_protection_art_lambdoid">人字缝</string>
    <string name="health_atlas_skull_protection_art_outer">外板</string>
    <string name="health_atlas_skull_protection_art_diploe">板障</string>
    <string name="health_atlas_skull_protection_art_inner">内板</string>
    <string name="health_atlas_skull_protection_art_dura">硬脑膜</string>
    <string name="health_atlas_skull_protection_art_arachnoid">蛛网膜</string>
    <string name="health_atlas_skull_protection_art_pia">软脑膜</string>
    <string name="health_atlas_skull_protection_art_csf">脑脊液</string>
    <string name="health_atlas_skull_protection_art_brain">大脑皮层</string>
    <string name="health_atlas_skull_protection_ref_skull">OpenStax：颅骨与骨缝</string>
    <string name="health_atlas_skull_protection_ref_bone">OpenStax：骨的结构</string>
    <string name="health_atlas_skull_protection_ref_meninges">OpenStax：脑膜与脑脊液</string>
    <string name="health_atlas_skull_protection_plate_title">颅盖剖面</string>
    <string name="health_atlas_skull_protection_plate_caption">颅盖与脑表面 · 放大剖面</string>
    <string name="health_atlas_skull_protection_plate_outer">颅盖外侧的密质骨。</string>
    <string name="health_atlas_skull_protection_plate_diploe">两层密质骨板之间呈网状的松质骨。</string>
    <string name="health_atlas_skull_protection_plate_inner">颅盖内侧的密质骨，紧邻硬脑膜。</string>
    <string name="health_atlas_skull_protection_plate_dura">坚韧的外层脑膜，在此紧贴颅骨。</string>
    <string name="health_atlas_skull_protection_plate_arachnoid">跨过脑表面沟槽的一层薄膜。</string>
    <string name="health_atlas_skull_protection_plate_pia">纤薄的内层脑膜，紧贴脑回和脑沟。</string>
    <string name="health_atlas_skull_protection_plate_csf">位于蛛网膜和软脑膜之间的液体，通过浮力支撑脑组织。</string>
    <string name="health_atlas_skull_protection_plate_brain">大脑外侧呈褶皱的组织，表面直接覆盖软脑膜。</string>

    <string name="health_atlas_vertebral_motion_title">相邻的两块腰椎如何联动</string>
    <string name="health_atlas_vertebral_motion_choice">椎间盘与小关节的联动</string>
    <string name="health_atlas_vertebral_motion_scope">一个完整腰椎运动节段的侧面示意，成对的小关节仅显示一侧。动作幅度经过放大，不代表实测角度或距离。</string>
    <string name="health_atlas_vertebral_motion_fit">一个节段，三处连接</string>
    <string name="health_atlas_vertebral_motion_fit_caption">前方的椎间盘连接两个椎体。后方左右各有一个小关节，连接相邻的椎弓。椎间盘和小关节在同一节段联动。</string>
    <string name="health_atlas_vertebral_motion_flexion">屈曲：向前倾</string>
    <string name="health_atlas_vertebral_motion_flexion_caption">上方腰椎向前倾时，椎间隙前部变窄、后部变宽。上方椎骨的关节面相对下方的关节面向上滑移。虚线表示中立位。</string>
    <string name="health_atlas_vertebral_motion_extension">伸展：向后倾</string>
    <string name="health_atlas_vertebral_motion_extension_caption">同一对腰椎经过中立位后向后倾。此时椎间隙后部变窄、前部变宽，两侧相对的关节面彼此滑近，配合位置随之改变。</string>
