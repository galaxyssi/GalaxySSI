<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="health_atlas_hb_middle_ear_caption">中耳：从鼓膜到卵圆窗的斜向剖视</string>
    <string name="health_atlas_hb_middle_ear_selector">听骨链</string>
    <string name="health_atlas_hb_eardrum">鼓膜</string>
    <string name="health_atlas_hb_eardrum_detail">鼓膜把外耳道与含有空气的中耳腔隔开。锤骨柄附着于鼓膜最凹处，即鼓膜脐。</string>
    <string name="health_atlas_hb_malleus">锤骨</string>
    <string name="health_atlas_hb_malleus_detail">锤骨头在鼓膜上方与砧骨相接。锤骨柄沿鼓膜内侧向下延伸至鼓膜脐。</string>
    <string name="health_atlas_hb_incus">砧骨</string>
    <string name="health_atlas_hb_incus_detail">砧骨体在中耳上部与锤骨相接。砧骨长脚向下延伸，与镫骨头构成一个小关节。</string>
    <string name="health_atlas_hb_stapes">镫骨</string>
    <string name="health_atlas_hb_stapes_detail">镫骨的两条细脚呈马镫状，将与砧骨相接的镫骨头连至嵌在卵圆窗内的镫骨底板。</string>
    <string name="health_atlas_hb_oval_window">卵圆窗</string>
    <string name="health_atlas_hb_oval_window_detail">卵圆窗通向内耳前庭。环状韧带将镫骨底板与窗缘密封相连，同时允许底板活动。</string>
    <string name="health_atlas_hb_round_window">圆窗</string>
    <string name="health_atlas_hb_round_window_detail">圆窗位于卵圆窗下方、鼓阶的基底端，由可动的薄膜覆盖。镫骨推动内耳液体时，圆窗膜可以随之移动。</string>
    <string name="health_atlas_hb_cochlea_caption">耳蜗：单个蜗回的简化横断面</string>
    <string name="health_atlas_hb_cochlea_selector">耳蜗横断面</string>
    <string name="health_atlas_hb_scala_vestibuli">前庭阶</string>
    <string name="health_atlas_hb_scala_vestibuli_detail">前庭阶位于蜗管上方，内含外淋巴液，与蜗管之间隔着前庭膜。它在耳蜗基底端与前庭相通。</string>
    <string name="health_atlas_hb_reissners">前庭膜</string>
    <string name="health_atlas_hb_reissners_detail">这层倾斜的薄膜也称赖斯纳膜，构成蜗管的顶壁，隔开蜗管内的内淋巴液和前庭阶内的外淋巴液。</string>
    <string name="health_atlas_hb_cochlear_duct">蜗管</string>
    <string name="health_atlas_hb_cochlear_duct_detail">蜗管也称中阶，是含有内淋巴液的楔形腔。它的顶壁斜向外侧壁，底部承托柯蒂器。</string>
    <string name="health_atlas_hb_corti">柯蒂器</string>
    <string name="health_atlas_hb_corti_detail">柯蒂器是听觉感觉上皮，位于蜗管内的基底膜上。它的毛细胞位于盖膜下方。</string>
    <string name="health_atlas_hb_basilar">基底膜</string>
    <string name="health_atlas_hb_basilar_detail">基底膜从内侧的骨螺旋板延伸至外侧壁，承托柯蒂器，并将蜗管与下方的鼓阶隔开。</string>
    <string name="health_atlas_hb_scala_tympani">鼓阶</string>
    <string name="health_atlas_hb_scala_tympani_detail">鼓阶位于耳蜗分隔结构下方，含有外淋巴液。它在基底端止于圆窗，在蜗顶与前庭阶相通。</string>
    <string name="health_atlas_hb_vestibular_caption">前庭迷路：半规管与耳石器官</string>
    <string name="health_atlas_hb_vestibular_selector">半规管与耳石器官</string>
    <string name="health_atlas_hb_anterior_canal">前半规管</string>
    <string name="health_atlas_hb_anterior_canal_detail">前半规管向上拱起，内部的膜性半规管位于较陡的平面内，感知头部旋转。其无壶腹的一端与后膜半规管汇合成总脚。</string>
    <string name="health_atlas_hb_posterior_canal">后半规管</string>
    <string name="health_atlas_hb_posterior_canal_detail">后半规管内的膜性管道所在平面与前膜半规管不同。它的一端膨大成壶腹，另一端汇入总脚。</string>
    <string name="health_atlas_hb_lateral_canal">外侧半规管</string>
    <string name="health_atlas_hb_lateral_canal_detail">外侧半规管内的膜性管道较接近水平。它的两端分别开入椭圆囊，不经过另外两条膜性管道共用的总脚。</string>
    <string name="health_atlas_hb_ampulla">后半规管壶腹</string>
    <string name="health_atlas_hb_ampulla_detail">后膜半规管的这个膨大处内有一条感觉嵴，其上覆盖胶状的壶腹帽。头部旋转时，内淋巴液的相对运动使壶腹帽偏转。</string>
    <string name="health_atlas_hb_utricle">椭圆囊</string>
    <string name="health_atlas_hb_utricle_detail">上方扁平的椭圆囊与各膜半规管相通。其近水平的感觉斑上覆有耳石结晶，可感知直线加速度以及相对于重力方向的头部倾斜。</string>
    <string name="health_atlas_hb_saccule">球囊</string>
    <string name="health_atlas_hb_saccule_detail">较小的球囊位于椭圆囊下方。它的感觉斑更接近竖直，也覆有耳石结晶，对竖直方向的直线加速度尤为敏感。</string>
</resources>
