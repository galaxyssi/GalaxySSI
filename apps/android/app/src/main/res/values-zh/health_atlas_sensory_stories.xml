    <string name="health_atlas_sense_smell_title">气味如何到达大脑</string>
    <string name="health_atlas_sense_smell_scope">正常嗅觉的科普示意，颜色代表不同信号，不表示真实的浓度或嗅觉灵敏度。</string>
    <string name="health_atlas_sense_smell_air">吸气把气味带入鼻腔</string>
    <string name="health_atlas_sense_smell_air_caption">吸气带入含有气味分子的空气。只有一部分气流到达鼻腔上方的嗅区。</string>
    <string name="health_atlas_sense_smell_mucus">分子进入嗅上皮表面的黏液</string>
    <string name="health_atlas_sense_smell_mucus_caption">气味分子进入薄薄的黏液层，接近嗅觉感受神经元伸出的纤毛。</string>
    <string name="health_atlas_sense_smell_receptor">受体把化学刺激变成电信号</string>
    <string name="health_atlas_sense_smell_receptor_caption">气味分子激活部分纤毛上的受体，改变感受神经元的电活动。此时向上传递的是神经信号。</string>
    <string name="health_atlas_sense_smell_bulb">信号穿过筛板到嗅球</string>
    <string name="health_atlas_sense_smell_bulb_caption">感受神经元的轴突成束穿过筛板小孔，在嗅球的嗅小球汇合。气味分子本身不会沿这条路径进入脑内。</string>
    <string name="health_atlas_sense_smell_pattern">大脑结合不同通道识别气味</string>
    <string name="health_atlas_sense_smell_pattern_caption">不同气味可激活不同组合的嗅觉通道。嗅球将处理后的信号传到嗅皮层等区域。</string>
    <string name="health_atlas_sense_smell_ref_tissue">人体嗅上皮组织研究</string>
    <string name="health_atlas_sense_smell_ref_bulb">人体嗅球气味信号记录</string>
    <string name="health_atlas_sense_smell_cavity">鼻腔</string>
    <string name="health_atlas_sense_smell_patch">嗅上皮</string>
    <string name="health_atlas_sense_smell_layer">黏液层</string>
    <string name="health_atlas_sense_smell_cilia">嗅纤毛</string>
    <string name="health_atlas_sense_smell_plate">筛板</string>
    <string name="health_atlas_sense_smell_bulb_label">嗅球</string>
    <string name="health_atlas_sense_smell_cortex">嗅皮层</string>
    <string name="health_atlas_sense_taste_title">甜味如何从味蕾传到神经</string>
    <string name="health_atlas_sense_taste_scope">展示甜味的 II 型味觉细胞示例。酸味和咸味的感知路径不在这段动画中。</string>
    <string name="health_atlas_sense_taste_dissolve">甜味分子溶在唾液里</string>
    <string name="health_atlas_sense_taste_dissolve_caption">唾液中的甜味分子可接近舌乳头上味蕾的开口。味觉不由舌面的一张固定分区图决定。</string>
    <string name="health_atlas_sense_taste_pore">通过味孔接触微绒毛</string>
    <string name="health_atlas_sense_taste_pore_caption">甜味分子穿过小小的味孔，接触味觉细胞伸到开口处的微绒毛。</string>
    <string name="health_atlas_sense_taste_receptor">甜味受体激活 II 型细胞</string>
    <string name="health_atlas_sense_taste_receptor_caption">甜味分子激活相应受体，细胞内的信号使 II 型味觉细胞产生电活动。</string>
    <string name="health_atlas_sense_taste_atp">味觉细胞释放 ATP</string>
    <string name="health_atlas_sense_taste_atp_caption">II 型细胞的电活动打开 ATP 释放通道。ATP 到达邻近的味觉神经末梢。</string>
    <string name="health_atlas_sense_taste_relay">味觉神经送出信号</string>
    <string name="health_atlas_sense_taste_relay_caption">ATP 激活味觉神经末梢的受体。信号经味觉神经传向脑干，再由中枢处理。</string>
    <string name="health_atlas_sense_taste_ref_atp">甜、苦、鲜味的 ATP 释放研究（小鼠）</string>
    <string name="health_atlas_sense_taste_ref_channel">II 型味觉细胞通道研究（小鼠）</string>
    <string name="health_atlas_sense_taste_saliva">唾液</string>
    <string name="health_atlas_sense_taste_papilla">舌乳头</string>
    <string name="health_atlas_sense_taste_pore_label">味孔</string>
    <string name="health_atlas_sense_taste_cell">II 型味觉细胞</string>
    <string name="health_atlas_sense_taste_nerve">味觉神经</string>
    <string name="health_atlas_sense_touch_title">轻触怎样变成神经信号</string>
    <string name="health_atlas_sense_touch_scope">这是梅克尔细胞与神经末梢感知轻触的示例。压力与信号频率均为示意，不用于检测感觉能力。</string>
    <string name="health_atlas_sense_touch_contact">物体碰到皮肤</string>
    <string name="health_atlas_sense_touch_contact_caption">物体接触皮肤时，表面轻微凹陷，形变传到下方的感受结构。</string>
    <string name="health_atlas_sense_touch_deform">形变传到梅克尔细胞和末梢</string>
    <string name="health_atlas_sense_touch_deform_caption">表皮基底部的梅克尔细胞紧邻感觉神经末梢，两者均参与轻触感知。</string>
    <string name="health_atlas_sense_touch_channel">机械敏感通道参与转换</string>
    <string name="health_atlas_sense_touch_channel_caption">形变可打开 PIEZO2 等机械敏感通道，让离子进入并改变细胞电活动。</string>
    <string name="health_atlas_sense_touch_steady">持续轻压仍可传出信号</string>
    <string name="health_atlas_sense_touch_steady_caption">轻压保持不变时，这类感受结构仍可送出信号，但与刚接触时的信号模式不同。</string>
    <string name="health_atlas_sense_touch_release">压力撤去，信号回落</string>
    <string name="health_atlas_sense_touch_release_caption">物体移开后，皮肤形变逐渐解除，神经活动趋向原来的水平。</string>
    <string name="health_atlas_sense_touch_ref_human">人体机械感觉与 PIEZO2 研究</string>
    <string name="health_atlas_sense_touch_ref_merkel">梅克尔细胞轻触研究（小鼠）</string>
    <string name="health_atlas_sense_touch_surface">皮肤表面</string>
    <string name="health_atlas_sense_touch_merkel">梅克尔细胞</string>
