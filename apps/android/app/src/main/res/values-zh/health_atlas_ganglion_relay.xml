    <string name="health_atlas_ganglion_relay_ref_sensory">Shorey 等：斑马鱼感觉神经元分支</string>
    <string name="health_atlas_ganglion_relay_ref_autonomic">OpenStax：自主神经系统的分部</string>
    <string name="health_atlas_ganglion_relay_ref_synapse">Elfvin：猫自主神经节的超微结构</string>
