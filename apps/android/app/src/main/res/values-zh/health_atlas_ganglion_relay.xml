    <string name="health_atlas_ganglion_relay_ref_local">Tang 等：小鼠卫星胶质细胞的钾电导</string>
    <string name="health_atlas_autonomic_outflows_view">自主神经传出通路（示意）</string>
    <string name="health_atlas_autonomic_outflows_thoracolumbar">胸腰段传出</string>
    <string name="health_atlas_autonomic_outflows_thoracolumbar_detail">交感节前纤维起于胸段和上腰段脊髓，通常为 T1 至 L2 节段。图中仅画出代表性连接。</string>
    <string name="health_atlas_autonomic_outflows_chain">交感神经链</string>
    <string name="health_atlas_autonomic_outflows_chain_detail">两条由神经节串成的交感干位于脊柱两侧。纤维可在进入的节段换接，也可沿交感干上行或下行，或穿过交感干进入椎前神经节。</string>
    <string name="health_atlas_autonomic_outflows_cranial">脑干传出</string>
    <string name="health_atlas_autonomic_outflows_cranial_detail">副交感纤维随第 III、VII、IX 和 X 对脑神经离开脑干。第 X 对是迷走神经，通往胸腔及腹腔内的许多器官。图中合并显示了部分通路。</string>
    <string name="health_atlas_autonomic_outflows_sacral">骶段传出</string>
    <string name="health_atlas_autonomic_outflows_sacral_detail">副交感纤维起于脊髓 S2 至 S4 节段，经盆内脏神经通往远端肠道和盆腔器官。</string>
    <string name="health_atlas_autonomic_outflows_terminal">终末神经节</string>
    <string name="health_atlas_autonomic_outflows_terminal_detail">副交感纤维通常在靶器官附近或器官壁内换接。图中神经节之后的一小段表示节后纤维。</string>
</resources>
