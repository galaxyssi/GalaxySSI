    <string name="health_atlas_ganglion_relay_art_dendrite">接收信号的树突</string>
    <string name="health_atlas_ganglion_relay_art_post_soma">节后神经元胞体</string>
    <string name="health_atlas_ganglion_relay_art_post">节后轴突</string>
