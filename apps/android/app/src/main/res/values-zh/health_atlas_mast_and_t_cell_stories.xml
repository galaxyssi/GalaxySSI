    <string name="health_atlas_helper_t_story_title">辅助性 T 细胞如何协调免疫应答</string>
    <string name="health_atlas_helper_t_story_choice">辅助性 T 细胞的协调作用</string>
    <string name="health_atlas_helper_t_story_scope">这是成人免疫应答的教学模型。细胞大小、信号符号和时间均为示意，不是测量结果或个人数据。</string>
    <string name="health_atlas_helper_t_story_cue">接收免疫信号</string>
    <string name="health_atlas_helper_t_story_cue_caption">辅助性 T 细胞接收邻近免疫细胞提供的信号后可以活化。这里展示的协调过程由此开始。</string>
    <string name="health_atlas_helper_t_story_send">释放化学信号</string>
    <string name="health_atlas_helper_t_story_send_caption">活化的辅助性 T 细胞可释放称为细胞因子的化学信号，影响其他免疫细胞的活动。</string>
    <string name="health_atlas_helper_t_story_reach">信号到达不同细胞</string>
    <string name="health_atlas_helper_t_story_reach_caption">这里用 B 细胞和另一种 T 细胞举例，说明哪些细胞可以得到辅助。分支动画表示可能接收信号的细胞，而非信号在组织中的固定路线。</string>
    <string name="health_atlas_helper_t_story_coordinate">协调不同的免疫活动</string>
    <string name="health_atlas_helper_t_story_coordinate_caption">这类辅助可支持 B 细胞的抗体应答，也可增强其他 T 细胞的活动。不同的辅助性 T 细胞可支持不同的应答。</string>
    <string name="health_atlas_helper_t_story_label_cue_cell">提供信号的细胞</string>
    <string name="health_atlas_helper_t_story_label_helper">辅助性 T 细胞</string>
    <string name="health_atlas_helper_t_story_label_cytokines">细胞因子信号</string>
    <string name="health_atlas_helper_t_story_label_b">B 细胞</string>
    <string name="health_atlas_helper_t_story_label_other_t">另一种 T 细胞</string>
    <string name="health_atlas_helper_t_story_ref">OpenStax：辅助性 T 细胞及其细胞因子</string>

    <string name="health_atlas_cytotoxic_t_story_title">细胞毒性 T 细胞如何作用于异常细胞</string>
    <string name="health_atlas_cytotoxic_t_story_choice">细胞毒性 T 细胞与靶细胞接触</string>
    <string name="health_atlas_cytotoxic_t_story_scope">这是成人免疫应答的教学模型。细胞形状、接触和时间均为示意，不是测量结果或个人数据。不能仅凭形状判断细胞是否异常。</string>
    <string name="health_atlas_cytotoxic_t_story_approach">靠近一个异常的人体细胞</string>
    <string name="health_atlas_cytotoxic_t_story_approach_caption">活化的细胞毒性 T 细胞能识别某些异常的人体细胞。图中的靶细胞是人体自身的细胞，不同的形状仅用于区分图中的细胞。</string>
    <string name="health_atlas_cytotoxic_t_story_contact">与靶细胞紧密接触</string>
    <string name="health_atlas_cytotoxic_t_story_contact_caption">细胞毒性 T 细胞与靶细胞紧密接触。高亮线标出了两个细胞相接的位置。</string>
    <string name="health_atlas_cytotoxic_t_story_change">靶细胞开始程序性死亡</string>
    <string name="health_atlas_cytotoxic_t_story_change_caption">这种接触可使靶细胞启动称为凋亡的受控过程。图中靶细胞收缩并出现小突起，这两种变化都可能在凋亡过程中发生。</string>
    <string name="health_atlas_cytotoxic_t_story_separate">与靶细胞分离</string>
    <string name="health_atlas_cytotoxic_t_story_separate_caption">靶细胞继续解体时，细胞毒性 T 细胞可以离开。图中的邻近细胞仍保持完整。</string>
    <string name="health_atlas_cytotoxic_t_story_label_cell">细胞毒性 T 细胞</string>
    <string name="health_atlas_cytotoxic_t_story_label_target">异常的人体细胞</string>
    <string name="health_atlas_cytotoxic_t_story_label_contact">细胞接触面</string>
    <string name="health_atlas_cytotoxic_t_story_label_apoptosis">靶细胞凋亡</string>
    <string name="health_atlas_cytotoxic_t_story_label_neighbor">完整的邻近细胞</string>
    <string name="health_atlas_cytotoxic_t_story_ref">OpenStax：细胞毒性 T 细胞与凋亡</string>
    <string name="health_atlas_cytotoxic_t_story_ref_human">NCBI 电子书库：人体免疫应答</string>

    <string name="health_atlas_regulatory_t_story_title">调节性 T 细胞如何缓和免疫应答</string>
    <string name="health_atlas_regulatory_t_story_choice">调节性 T 细胞的调节作用</string>
    <string name="health_atlas_regulatory_t_story_scope">这是成人免疫应答的教学模型。细胞形状仅为示意。移动的带状图形表示活动，并非测量结果、时间刻度或个人数据。</string>
    <string name="health_atlas_regulatory_t_story_active">正在进行的免疫应答</string>
    <string name="health_atlas_regulatory_t_story_active_caption">组织中的多个免疫细胞已经开始应答。移动的带状图形表示这些细胞的整体活动。</string>
    <string name="health_atlas_regulatory_t_story_join">参与调节正在进行的应答</string>
    <string name="health_atlas_regulatory_t_story_join_caption">调节性 T 细胞在其他免疫细胞附近发挥作用。免疫应答在进行过程中也可以受到调节。</string>
    <string name="health_atlas_regulatory_t_story_moderate">抑制过强的活动</string>
    <string name="health_atlas_regulatory_t_story_moderate_caption">调节性 T 细胞可抑制其他免疫细胞过强的活动。带状图形变窄表示应答减弱，参与应答的细胞仍然存在。</string>
    <string name="health_atlas_regulatory_t_story_balance">应答继续并保持平衡</string>
    <string name="health_atlas_regulatory_t_story_balance_caption">缓和应答不等于关闭免疫系统。限制过强的活动有助于保护人体自身的组织，同时保留免疫活动。</string>
    <string name="health_atlas_regulatory_t_story_label_responders">正在应答的免疫细胞</string>
    <string name="health_atlas_regulatory_t_story_label_active">正在进行的应答</string>
    <string name="health_atlas_regulatory_t_story_label_moderated">缓和后的应答</string>
    <string name="health_atlas_regulatory_t_story_label_regulator">调节性 T 细胞</string>
    <string name="health_atlas_regulatory_t_story_ref">OpenStax：调节性 T 细胞</string>
</resources>
