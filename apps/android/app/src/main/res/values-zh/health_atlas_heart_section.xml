    <string name="health_atlas_ejection_scope">单个心室的容积演示，使用独立的示例输入，不是实测结果、参考范围或诊断。</string>
    <string name="health_atlas_valves_scope">简化心动周期。四个阶段用于演示，不代表实际时长或压力。</string>
    <string name="health_atlas_valves_filling">心室充盈</string>
    <string name="health_atlas_valves_contraction">等容收缩</string>
    <string name="health_atlas_valves_ejection">心室射血</string>
    <string name="health_atlas_valves_relaxation">等容舒张</string>
    <string name="health_atlas_valve_open">打开</string>
    <string name="health_atlas_valve_closed">关闭</string>
    <string name="health_atlas_valve_state">%1$s · %2$s</string>
    <string name="health_atlas_valves_cycle">一个心动周期中的瓣膜时序</string>
    <string name="health_atlas_valves_stage_0">二尖瓣和三尖瓣打开，心室充盈；两个流出瓣保持关闭。</string>
    <string name="health_atlas_valves_stage_1">四个瓣膜都关闭，心室压力升高，容积不变。</string>
    <string name="health_atlas_valves_stage_2">主动脉瓣和肺动脉瓣打开射血；两个房室瓣保持关闭。</string>
    <string name="health_atlas_valves_stage_3">两个流出瓣关闭。心室在容积不变的情况下舒张，四瓣短暂全部关闭。</string>
    <string name="health_atlas_aorta_name">主动脉</string>
    <string name="health_atlas_aorta_description">体循环的主干动脉，将左心室射出的血液输送至各分支。其弹性管壁帮助维持两次心搏之间的血流。</string>
    <string name="health_atlas_aorta_aliases">升主动脉 主动脉弓 降主动脉</string>
    <string name="health_atlas_aorta_process">主动脉受血与弹性回缩</string>
    <string name="health_atlas_aorta_stage_0">左心室压力升至高于主动脉压力。</string>
    <string name="health_atlas_aorta_stage_1">主动脉瓣打开，近端主动脉在射血时扩张。</string>
    <string name="health_atlas_aorta_stage_2">左心室压力下降后，主动脉瓣关闭。</string>
    <string name="health_atlas_aorta_stage_3">管壁弹性回缩帮助血液继续流向体循环分支。</string>
    <string name="health_atlas_pulmonary_trunk_name">肺动脉干</string>
    <string name="health_atlas_pulmonary_trunk_description">肺动脉通路的起始段，将右心室射出的血液分送到左右肺动脉。</string>
    <string name="health_atlas_pulmonary_trunk_aliases">主肺动脉 肺循环 肺动脉分叉</string>
    <string name="health_atlas_pulmonary_trunk_process">血液经肺动脉干分流</string>
    <string name="health_atlas_pulmonary_trunk_stage_0">右心室收缩，腔内压力升高。</string>
    <string name="health_atlas_pulmonary_trunk_stage_1">右心室压力超过肺动脉干压力，肺动脉瓣打开。</string>
    <string name="health_atlas_pulmonary_trunk_stage_2">血流经左右肺动脉分送至双肺。</string>
    <string name="health_atlas_pulmonary_trunk_stage_3">右心室压力下降后，肺动脉瓣关闭。</string>
    <string name="health_atlas_right_atrium_name">右心房</string>
    <string name="health_atlas_right_atrium_description">接收体循环静脉和冠状窦回流，再经三尖瓣向右心室供血。</string>
    <string name="health_atlas_right_atrium_aliases">右房 冠状窦 体静脉回流</string>
    <string name="health_atlas_right_atrium_process">右心房的充盈与排空</string>
    <string name="health_atlas_right_atrium_stage_0">腔静脉和冠状窦的血液回到右心房。</string>
    <string name="health_atlas_right_atrium_stage_1">三尖瓣打开时，血液进入舒张的右心室。</string>
    <string name="health_atlas_right_atrium_stage_2">右心房收缩，补充右心室的末期充盈。</string>
    <string name="health_atlas_right_atrium_stage_3">右心室收缩时三尖瓣关闭，右心房继续接受静脉回流。</string>
    <string name="health_atlas_left_atrium_name">左心房</string>
    <string name="health_atlas_left_atrium_description">接收肺静脉回流，并经二尖瓣将血液送入左心室。</string>
    <string name="health_atlas_left_atrium_aliases">左房 肺静脉回流</string>
    <string name="health_atlas_left_atrium_process">左心房向左心室输送血液</string>
    <string name="health_atlas_left_atrium_stage_0">肺静脉血回到左心房。</string>
    <string name="health_atlas_left_atrium_stage_1">左心房压力超过左心室压力时，二尖瓣打开。</string>
    <string name="health_atlas_left_atrium_stage_2">左心房收缩，完成左心室的末期充盈。</string>
    <string name="health_atlas_left_atrium_stage_3">二尖瓣关闭，将左心房与收缩中的左心室隔开。</string>
    <string name="health_atlas_right_ventricle_name">右心室</string>
    <string name="health_atlas_right_ventricle_description">经肺动脉瓣将血液泵入肺动脉干。右心室肌壁比左心室薄。</string>
    <string name="health_atlas_right_ventricle_aliases">右室 肺循环 右室流出道</string>
    <string name="health_atlas_right_ventricle_process">右心室泵血</string>
    <string name="health_atlas_right_ventricle_stage_0">血液经三尖瓣从右心房进入右心室。</string>
    <string name="health_atlas_right_ventricle_stage_1">三尖瓣关闭，右心室在射血前建立压力。</string>
    <string name="health_atlas_right_ventricle_stage_2">肺动脉瓣打开，血液进入肺动脉干。</string>
    <string name="health_atlas_right_ventricle_stage_3">右心室舒张，肺动脉瓣关闭以阻止返流。</string>
    <string name="health_atlas_left_ventricle_name">左心室</string>
    <string name="health_atlas_left_ventricle_description">厚实的肌壁产生压力，将血液经主动脉瓣送入体循环。</string>
    <string name="health_atlas_left_ventricle_aliases">左室 体循环 左室流出道</string>
    <string name="health_atlas_left_ventricle_process">左心室泵血</string>
    <string name="health_atlas_left_ventricle_stage_0">血液经打开的二尖瓣进入左心室。</string>
    <string name="health_atlas_left_ventricle_stage_1">二尖瓣关闭，左心室压力升高，但仍未射血。</string>
    <string name="health_atlas_left_ventricle_stage_2">主动脉瓣打开，血液进入主动脉，左心室容积下降。</string>
    <string name="health_atlas_left_ventricle_stage_3">左心室舒张，主动脉瓣关闭。</string>
    <string name="health_atlas_tricuspid_valve_name">三尖瓣</string>
    <string name="health_atlas_tricuspid_valve_description">右房室瓣控制右心房至右心室的血流。腱索和乳头肌帮助防止收缩时瓣叶翻向心房。</string>
    <string name="health_atlas_tricuspid_valve_aliases">右房室瓣 腱索</string>
    <string name="health_atlas_tricuspid_valve_process">三尖瓣的开闭</string>
    <string name="health_atlas_tricuspid_valve_stage_0">充盈期三尖瓣打开，血液流入右心室。</string>
    <string name="health_atlas_tricuspid_valve_stage_1">右心室压力升高，三尖瓣瓣叶闭合。</string>
    <string name="health_atlas_tricuspid_valve_stage_2">血液射入肺动脉干时，三尖瓣保持关闭。</string>
    <string name="health_atlas_tricuspid_valve_stage_3">等容舒张早期仍关闭，待右心室压力低于右心房压力后再打开。</string>
    <string name="health_atlas_mitral_valve_name">二尖瓣</string>
    <string name="health_atlas_mitral_valve_description">左房室瓣让血液由左心房进入左心室。它有两片瓣叶，由腱索和乳头肌支撑。</string>
    <string name="health_atlas_mitral_valve_aliases">左房室瓣 僧帽瓣</string>
    <string name="health_atlas_mitral_valve_process">二尖瓣的开闭</string>
    <string name="health_atlas_mitral_valve_stage_0">二尖瓣打开，左心室充盈。</string>
    <string name="health_atlas_mitral_valve_stage_1">左心室压力超过左心房压力时，瓣叶闭合。</string>
    <string name="health_atlas_mitral_valve_stage_2">左心室向主动脉射血时，二尖瓣保持关闭。</string>
    <string name="health_atlas_mitral_valve_stage_3">待舒张中的左心室压力低于左心房压力后，二尖瓣才重新打开。</string>
    <string name="health_atlas_pulmonary_valve_name">肺动脉瓣</string>
    <string name="health_atlas_pulmonary_valve_description">连接右心室与肺动脉干的半月瓣，射血后阻止血液回流至右心室。</string>
    <string name="health_atlas_pulmonary_valve_aliases">肺半月瓣 右室流出道</string>
    <string name="health_atlas_pulmonary_valve_process">肺动脉瓣与射血时序</string>
    <string name="health_atlas_pulmonary_valve_stage_0">右心室充盈时肺动脉瓣关闭。</string>
    <string name="health_atlas_pulmonary_valve_stage_1">收缩早期右心室压力升高，肺动脉瓣仍闭合。</string>
    <string name="health_atlas_pulmonary_valve_stage_2">右心室压力超过肺动脉干压力时，肺动脉瓣打开。</string>
    <string name="health_atlas_pulmonary_valve_stage_3">右心室压力降到肺动脉干压力以下时，瓣叶闭合。</string>
    <string name="health_atlas_aortic_valve_name">主动脉瓣</string>
    <string name="health_atlas_aortic_valve_description">左心室流出端的半月瓣，射血后阻止主动脉内的血液回到左心室。</string>
    <string name="health_atlas_aortic_valve_aliases">主动脉半月瓣 左室流出道</string>
    <string name="health_atlas_aortic_valve_process">主动脉瓣与射血时序</string>
    <string name="health_atlas_aortic_valve_stage_0">充盈期主动脉侧压力较高，瓣膜保持关闭。</string>
    <string name="health_atlas_aortic_valve_stage_1">心室收缩早期，主动脉瓣仍未打开。</string>
    <string name="health_atlas_aortic_valve_stage_2">左心室压力超过主动脉压力，瓣叶打开。</string>
    <string name="health_atlas_aortic_valve_stage_3">左心室压力下降，短暂的反向血流促使瓣叶闭合。</string>
</resources>
