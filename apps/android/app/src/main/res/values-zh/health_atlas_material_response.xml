    <string name="health_atlas_compression_title">关节软骨受压示例</string>
    <string name="health_atlas_compression_stress">施加压应力</string>
    <string name="health_atlas_compression_modulus">示例弹性模量</string>
    <string name="health_atlas_compression_remaining">剩余厚度：%1$s%%</string>
    <string name="health_atlas_compression_formula">压缩应变（百分比）= 100 × 压应力 ÷ 弹性模量，两者使用相同单位。</string>
    <string name="health_atlas_compression_scope">该示例将关节软骨简化为均匀的小应变弹性材料，不考虑液体流动、时间效应或组织分层。它描述组织而不是单个软骨细胞，不能推断损伤或关节健康。</string>
    <string name="health_atlas_compression_diagram">关节软骨受压前后的对照，图中放大了形变。</string>
    <string name="health_atlas_compression_unloaded">未受压</string>
    <string name="health_atlas_compression_loaded">受压后</string>
