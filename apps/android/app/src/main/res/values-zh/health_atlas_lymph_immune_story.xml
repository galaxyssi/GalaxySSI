    <string name="health_atlas_lymph_flow_filling">充盈：入口打开</string>
    <string name="health_atlas_lymph_flow_holding">两侧瓣膜关闭</string>
    <string name="health_atlas_lymph_flow_contracting">收缩：出口打开</string>
