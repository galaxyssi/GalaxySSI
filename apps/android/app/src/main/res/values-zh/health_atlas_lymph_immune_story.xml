<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="health_atlas_lymph_flow_title">淋巴怎样回到血液</string>
    <string name="health_atlas_lymph_flow_scope">以经胸导管回流的一条路线为例。颗粒表示流向，不代表流速或个人淋巴功能。</string>
    <string name="health_atlas_lymph_flow_tissue">组织液的形成</string>
    <string name="health_atlas_lymph_flow_tissue_caption">水和部分小分子从血毛细血管滤出，进入细胞间隙。血细胞通常留在血管内。</string>
    <string name="health_atlas_lymph_flow_entry">进入淋巴毛细管</string>
    <string name="health_atlas_lymph_flow_entry_caption">组织液可从相邻内皮细胞之间的瓣状边缘进入盲端淋巴毛细管，进入后称为淋巴。</string>
    <string name="health_atlas_lymph_flow_pump">分段收缩，向前推进</string>
    <string name="health_atlas_lymph_flow_pump_caption">集合淋巴管可分段充盈和收缩。瓣膜随局部压力变化开合，帮助减少回流。</string>
    <string name="health_atlas_lymph_flow_node">经过淋巴结</string>
    <string name="health_atlas_lymph_flow_node_caption">淋巴由输入管流入淋巴结，经窦道流向输出管。免疫细胞能在这里接触并检查部分随淋巴带来的物质。</string>
    <string name="health_atlas_lymph_flow_return">回到静脉</string>
    <string name="health_atlas_lymph_flow_return_caption">来自身体大部分区域的淋巴汇入胸导管，通常在左侧颈内静脉与锁骨下静脉交界附近回流。</string>
    <string name="health_atlas_lymph_flow_anatomy">淋巴系统解剖与回流</string>
    <string name="health_atlas_lymph_flow_entry_source">淋巴毛细管内皮研究</string>
    <string name="health_atlas_lymph_flow_blood">血毛细血管</string>
