    <string name="health_atlas_intestinal_stem_renewal_title">肠干细胞更新小肠上皮</string>
    <string name="health_atlas_intestinal_stem_renewal_scope">正常成人小肠。本图仅用于教学；细胞数量、距离与时间为示意，未按组织实际比例绘制，也不依据个人测量。</string>
    <string name="health_atlas_intestinal_stem_renewal_choice">肠上皮更新</string>
    <string name="health_atlas_intestinal_stem_renewal_niche">隐窝底部的干细胞微环境</string>
    <string name="health_atlas_intestinal_stem_renewal_niche_caption">肠干细胞位于隐窝底部，与潘氏细胞等相邻。</string>
    <string name="health_atlas_intestinal_stem_renewal_division">分裂与更新</string>
    <string name="health_atlas_intestinal_stem_renewal_division_caption">干细胞分裂既维持底部的干细胞群，也产生新的后代细胞。图中展示其中一种更新过程。</string>
    <string name="health_atlas_intestinal_stem_renewal_upward">沿隐窝壁向上移动</string>
    <string name="health_atlas_intestinal_stem_renewal_upward_caption">许多后代细胞沿上皮层向绒毛移动，干细胞群则留在隐窝底部附近。</string>
    <string name="health_atlas_intestinal_stem_renewal_villus">更新绒毛上皮</string>
    <string name="health_atlas_intestinal_stem_renewal_villus_caption">部分后代细胞成熟为具有刷状缘的吸收细胞，替换绒毛上皮中的老细胞。</string>
    <string name="health_atlas_intestinal_stem_renewal_cell">肠干细胞</string>
    <string name="health_atlas_intestinal_stem_renewal_paneth">邻近的潘氏细胞</string>
    <string name="health_atlas_intestinal_stem_renewal_toward_villus">朝向绒毛</string>
    <string name="health_atlas_intestinal_stem_renewal_lining">绒毛上皮</string>
