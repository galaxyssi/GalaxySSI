<resources>
    <string name="health_atlas_cell_morphology">代表性细胞结构</string>
    <string name="health_atlas_cell_receptor_scheme">细胞表面受体示意</string>
    <string name="health_atlas_platelet_disc">静息血小板碎片</string>
    <string name="health_atlas_feature_context">图中标注：%1$s</string>
    <string name="health_atlas_phagocytosis_scope">此图以示例颗粒为对象。过程仅用于教学，不代表实测大小或时间。</string>
    <string name="health_atlas_phagocytosis_visual_stage">吞噬示意：%1$s</string>
    <string name="health_atlas_granulocyte_stage">细胞反应：%1$s</string>
    <string name="health_atlas_neutrophil_scope">教学示意：穿出血管后，吞入并处理示例目标。图中大小和时间不代表实测。</string>
    <string name="health_atlas_eosinophil_scope">教学示意：接触示例目标的表面并释放颗粒内容物。图中大小和时间不代表实测。</string>
    <string name="health_atlas_basophil_scope">教学示意：释放介质与局部血管反应。图中大小和时间不代表实测。</string>
    <string name="health_atlas_monocyte_lesson_scope">教学示意：单核细胞从血液被招募到组织，部分可分化为巨噬细胞。这是可能的去向之一。</string>
    <string name="health_atlas_dendritic_lesson_scope">教学示意：树突状细胞处理物质并向 T 细胞呈递抗原片段。图标不代表分子比例。</string>
    <string name="health_atlas_plasma_lesson_scope">教学示意：浆细胞产生并释放抗体。浅色高尔基区和蛋白质合成相关结构为示意。</string>
    <string name="health_atlas_t_lesson_scope">教学示意：T 细胞响应呈递的抗原和激活信号，后续作用取决于细胞亚型。</string>
    <string name="health_atlas_b_lesson_scope">教学示意：一种依赖 T 细胞的途径可形成浆细胞或记忆 B 细胞。受体形态为示意。</string>
    <string name="health_atlas_nk_lesson_scope">教学示意：自然杀伤细胞响应示例异常细胞。图中符号和时间为示意。</string>
    <string name="health_atlas_mega_lesson_scope">教学示意：巨核细胞在血管附近形成胞质突起并释放血小板碎片。图中比例和时序为示意。</string>
    <string name="health_atlas_platelet_lesson_scope">教学示意：活化血小板在血管损伤处聚集并参与形成血小板栓。不用于评估凝血或指导治疗。</string>
    <string name="health_atlas_feature_lobulated">分叶核</string>
    <string name="health_atlas_feature_lobulated_detail">成熟中性粒细胞的细胞核通常分成数叶，之间由细丝连接。</string>
    <string name="health_atlas_feature_fine_granules">细颗粒</string>
    <string name="health_atlas_feature_fine_granules_detail">胞质中的细颗粒储存蛋白质，帮助细胞处理已吞入的物质。</string>
    <string name="health_atlas_feature_bilobed">双叶核</string>
    <string name="health_atlas_feature_bilobed_detail">细胞核常见两个核叶，由狭窄的连接相连。</string>
    <string name="health_atlas_feature_eosin_granules">嗜酸性颗粒</string>
    <string name="health_atlas_feature_eosin_granules_detail">较粗大的颗粒经伊红染色常呈橙红色。</string>
    <string name="health_atlas_feature_obscured_nucleus">部分被遮挡的核</string>
    <string name="health_atlas_feature_obscured_nucleus_detail">粗大的嗜碱性颗粒常使下方的分叶核不易辨认。</string>
    <string name="health_atlas_feature_baso_granules">嗜碱性颗粒</string>
    <string name="health_atlas_feature_baso_granules_detail">深染的颗粒含有组胺等介质。</string>
    <string name="health_atlas_feature_kidney_nucleus">凹陷的细胞核</string>
    <string name="health_atlas_feature_kidney_nucleus_detail">单核细胞的细胞核常呈凹陷或肾形。</string>
    <string name="health_atlas_feature_monocyte_cytoplasm">胞质与空泡</string>
    <string name="health_atlas_feature_monocyte_cytoplasm_detail">单核细胞有较宽的灰蓝色胞质，部分细胞可见小空泡。</string>
    <string name="health_atlas_feature_cell_projection">细胞突起</string>
    <string name="health_atlas_feature_cell_projection_detail">细胞改变膜的形状以移动，并围住将要吞入的物质。</string>
    <string name="health_atlas_feature_vesicle">胞内囊泡</string>
    <string name="health_atlas_feature_vesicle_detail">吞入的物质先被膜包裹，随后在细胞内处理。</string>
    <string name="health_atlas_feature_t_receptor">T 细胞受体</string>
    <string name="health_atlas_feature_t_receptor_detail">T 细胞受体识别其他细胞呈递的特定抗原。这是受体示意，不是血涂片识别方法。</string>
    <string name="health_atlas_feature_b_receptor">B 细胞受体</string>
    <string name="health_atlas_feature_b_receptor_detail">膜表面的免疫球蛋白可结合抗原。该图不表示能靠外形区分 B 细胞与 T 细胞。</string>
    <string name="health_atlas_feature_lymphocyte_nucleus">淋巴细胞核</string>
    <string name="health_atlas_feature_lymphocyte_nucleus_detail">静息淋巴细胞的细胞核常呈圆形，占细胞较大部分。</string>
    <string name="health_atlas_feature_cytotoxic_granules">细胞毒颗粒</string>
    <string name="health_atlas_feature_cytotoxic_granules_detail">自然杀伤细胞在颗粒中储存可使特定靶细胞死亡的分子。</string>
    <string name="health_atlas_feature_plasma_nucleus">偏心核</string>
    <string name="health_atlas_feature_plasma_nucleus_detail">位于一侧的细胞核，其边缘常可见团块状染色质。</string>
    <string name="health_atlas_feature_golgi_zone">高尔基体区</string>
    <string name="health_atlas_feature_golgi_zone_detail">这一较浅的区域靠近加工分泌蛋白的细胞结构。</string>
    <string name="health_atlas_feature_rough_er">粗面内质网</string>
    <string name="health_atlas_feature_rough_er_detail">丰富的粗面内质网支持浆细胞合成抗体。</string>
    <string name="health_atlas_feature_polyploid">多倍体核</string>
    <string name="health_atlas_feature_polyploid_detail">巨核细胞成熟时，可在不分裂的情况下复制 DNA，形成巨大的分叶状细胞核。</string>
    <string name="health_atlas_feature_proplatelet">胞质延伸</string>
    <string name="health_atlas_feature_proplatelet_detail">成熟中的巨核细胞可伸出胞质延伸，血小板由这些延伸形成。</string>
    <string name="health_atlas_feature_anucleate">无核圆盘</string>
    <string name="health_atlas_feature_anucleate_detail">静息血小板是小型胞质碎片，不具有细胞核。</string>
    <string name="health_atlas_feature_platelet_granules">血小板颗粒</string>
    <string name="health_atlas_feature_platelet_granules_detail">中央颗粒储存可在血小板活化时释放的物质。</string>
    <string name="health_atlas_feature_dendritic_process">树突状突起</string>
    <string name="health_atlas_feature_dendritic_process_detail">延伸的胞膜突起是本图的示意特征，可随树突状细胞所处的状态而变化。</string>
    <string name="health_atlas_feature_dendritic_nucleus">细胞核</string>
    <string name="health_atlas_feature_dendritic_nucleus_detail">细胞核包含细胞的遗传物质；本图不用于区分树突状细胞亚型。</string>
</resources>
