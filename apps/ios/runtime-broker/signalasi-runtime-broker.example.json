{
  "session_key_b64": "replace-with-the-same-32-byte-or-longer-base64-key-entered-in-the-ios-app",
  "linux_command_prefix": [
    "/var/jb/usr/bin/proot",
    "-r",
    "/var/mobile/Containers/Shared/SystemGroup/signalasi-linux-rootfs",
    "-b",
    "{workspace}:/workspace",
    "-w",
    "/workspace",
    "--"
  ],
  "workspace_root": "/var/mobile/Library/SignalASI/runtime-projects",
  "linux_base_version": "1.3.9",
  "distribution": "SignalASI jailbreak Linux 1.3.9",
  "ready_command": [
    "/bin/sh",
    "-lc",
    "test -x /bin/sh && command -v apt-get >/dev/null"
  ]
}
