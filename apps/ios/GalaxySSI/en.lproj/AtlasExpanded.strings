"health_atlas_biceps_brachii_anterior_caption" = "Front of the right upper arm: two heads join above the elbow.";
"health_atlas_biceps_brachii_anterior_selector" = "Biceps heads";
"health_atlas_biceps_brachii_distal_tendon" = "Distal tendon";
"health_atlas_biceps_brachii_distal_tendon_detail" = "This tendon crosses the front of the elbow and attaches to the radial tuberosity near the top of the radius. The biceps bends the elbow and helps turn the palm upward.";
"health_atlas_biceps_brachii_long_head" = "Long head";
"health_atlas_biceps_brachii_long_head_detail" = "The outer head starts at the upper edge of the shoulder socket. Its tendon runs through a groove at the front of the humerus.";
"health_atlas_biceps_brachii_short_head" = "Short head";
"health_atlas_biceps_brachii_short_head_detail" = "The inner head starts at the coracoid process, a projection of the shoulder blade. It joins the long head toward the elbow.";
"health_atlas_bowmans_capsule_parietal" = "Parietal layer";
"health_atlas_bowmans_capsule_parietal_detail" = "A single layer of flat cells forms the outer wall. At the urinary pole it becomes continuous with the lining of the proximal tubule.";
"health_atlas_bowmans_capsule_poles_selector" = "Capsule layers";
"health_atlas_bowmans_capsule_poles_view" = "Bowman's capsule and its urinary pole";
"health_atlas_bowmans_capsule_space" = "Capsular space";
"health_atlas_bowmans_capsule_space_detail" = "Filtrate collects in the gap between the two layers and enters the proximal tubule at the urinary pole, opposite the vascular pole.";
"health_atlas_bowmans_capsule_visceral" = "Visceral layer";
"health_atlas_bowmans_capsule_visceral_detail" = "Podocytes form the inner layer. Their branching processes wrap individual glomerular capillaries rather than lining the outer wall.";
"health_atlas_cerebrum_medial_callosum" = "Corpus callosum";
"health_atlas_cerebrum_medial_callosum_detail" = "This curved bundle of white matter crosses the midline to connect the left and right cerebral hemispheres.";
"health_atlas_cerebrum_medial_cingulate" = "Cingulate gyrus";
"health_atlas_cerebrum_medial_cingulate_detail" = "This fold of cortex follows the upper curve of the corpus callosum. The cingulate sulcus lies just above it.";
"health_atlas_cerebrum_medial_cortex" = "Cerebral cortex";
"health_atlas_cerebrum_medial_cortex_detail" = "Cortical gray matter forms the folded outer layer of the hemisphere. Its ridges are gyri, and the grooves between them are sulci.";
"health_atlas_cerebrum_medial_cutaway_selector" = "Medial cutaway";
"health_atlas_cerebrum_medial_cutaway_view" = "Medial view of one cerebral hemisphere, with the front at left. A small cutaway in the frontal lobe reveals white matter beneath the cortex.";
"health_atlas_cerebrum_medial_parieto_occipital" = "Parieto-occipital sulcus";
"health_atlas_cerebrum_medial_parieto_occipital_detail" = "This deep groove marks the boundary between the parietal and occipital lobes on the medial surface.";
"health_atlas_cerebrum_medial_white_matter" = "Subcortical white matter";
"health_atlas_cerebrum_medial_white_matter_detail" = "Beneath the cortex, bundles of axons connect different regions of the same hemisphere, the opposite hemisphere, and deeper structures.";
"health_atlas_dermis_two_layers" = "Layers of the dermis";
"health_atlas_dorsal_root_ganglion_capsule" = "Connective tissue capsule";
"health_atlas_dorsal_root_ganglion_capsule_detail" = "A connective tissue coat surrounds the ganglion and continues along the dorsal root at its ends.";
"health_atlas_dorsal_root_ganglion_cutaway_selector" = "Sensory ganglion";
"health_atlas_dorsal_root_ganglion_cutaway_view" = "A dorsal root ganglion opened lengthwise, with the spinal cord side at left and the spinal nerve side at right. This is one example of a sensory ganglion.";
"health_atlas_dorsal_root_ganglion_fiber_bundles" = "Sensory fiber bundles";
"health_atlas_dorsal_root_ganglion_fiber_bundles_detail" = "Bundles of sensory axons pass mainly through the center of the ganglion and continue toward the spinal cord on one side and the spinal nerve on the other.";
"health_atlas_dorsal_root_ganglion_soma" = "Sensory neuron cell body";
"health_atlas_dorsal_root_ganglion_soma_detail" = "Most of these large, round cell bodies lie near the outer part of the ganglion. Satellite glial cells form a thin coat around each cell body.";
"health_atlas_dorsal_root_ganglion_t_junction" = "T-shaped sensory axon";
"health_atlas_dorsal_root_ganglion_t_junction_detail" = "A single process leaves the cell body and divides into two branches. One extends to the periphery, and the other enters the spinal cord. The sensory signal does not need a synapse in the ganglion.";
"health_atlas_endometrial_basal_layer" = "Basal layer";
"health_atlas_endometrial_basal_layer_detail" = "This deep portion of the endometrium lies against the myometrium. It remains after menstruation and gives rise to the next functional layer.";
"health_atlas_endometrial_functional_layer" = "Functional layer";
"health_atlas_endometrial_functional_layer_detail" = "The portion nearest the cavity contains stroma, glands, and spiral arterioles. It grows during the cycle and is shed at menstruation.";
"health_atlas_endometrial_layers_selector" = "Lining layers";
"health_atlas_endometrial_layers_view" = "Magnified cutaway of the uterine lining in the proliferative phase, with the uterine cavity above. Lining thickness varies over the cycle.";
"health_atlas_endometrial_luminal_epithelium" = "Surface epithelium";
"health_atlas_endometrial_luminal_epithelium_detail" = "A single layer of columnar cells faces the uterine cavity and continues into the openings of the uterine glands.";
"health_atlas_endometrial_myometrium_bed" = "Myometrium";
"health_atlas_endometrial_myometrium_bed_detail" = "Interlacing smooth muscle bundles form the thick uterine wall under the endometrium. Only a shallow part is shown here.";
"health_atlas_endometrial_uterine_gland" = "Uterine gland";
"health_atlas_endometrial_uterine_gland_detail" = "The tubular glands open onto the surface and extend through the functional layer into the basal layer. They are relatively straight in the proliferative phase.";
"health_atlas_epidermis_thick_layers" = "Palm and sole epidermis";
"health_atlas_femur_landmarks_caption" = "Right femur, anterior view";
"health_atlas_femur_landmarks_head" = "Femoral head";
"health_atlas_femur_landmarks_head_detail" = "The rounded head fits into the hip socket.";
"health_atlas_femur_landmarks_neck" = "Femoral neck";
"health_atlas_femur_landmarks_neck_detail" = "This narrowed segment angles from the head toward the shaft.";
"health_atlas_femur_landmarks_patellar_surface" = "Patellar surface";
"health_atlas_femur_landmarks_patellar_surface_detail" = "The kneecap glides along this smooth groove on the front of the lower femur.";
"health_atlas_femur_landmarks_selector" = "Anterior landmarks";
"health_atlas_femur_landmarks_shaft" = "Femoral shaft";
"health_atlas_femur_landmarks_shaft_detail" = "The long central portion angles inward from the hip toward the knee.";
"health_atlas_femur_landmarks_trochanter" = "Greater trochanter";
"health_atlas_femur_landmarks_trochanter_detail" = "This large outer projection provides attachment for several hip muscles.";
"health_atlas_foot_bones_landmarks_calcaneus" = "Calcaneus";
"health_atlas_foot_bones_landmarks_calcaneus_detail" = "The largest tarsal bone forms the heel beneath and behind the talus.";
"health_atlas_foot_bones_landmarks_caption" = "Bones of the right foot, viewed from above";
"health_atlas_foot_bones_landmarks_metatarsals" = "Metatarsals";
"health_atlas_foot_bones_landmarks_metatarsals_detail" = "Five long bones link the tarsal bones to the bases of the toes.";
"health_atlas_foot_bones_landmarks_navicular" = "Navicular";
"health_atlas_foot_bones_landmarks_navicular_detail" = "This curved bone lies between the head of the talus and the three cuneiform bones.";
"health_atlas_foot_bones_landmarks_phalanges" = "Toe phalanges";
"health_atlas_foot_bones_landmarks_phalanges_detail" = "The great toe has two phalanges; each of the other toes typically has three.";
"health_atlas_foot_bones_landmarks_selector" = "Dorsal landmarks";
"health_atlas_foot_bones_landmarks_talus" = "Talus";
"health_atlas_foot_bones_landmarks_talus_detail" = "The talus sits over the heel bone and meets the tibia and fibula at the ankle.";
"health_atlas_glomerulus_afferent" = "Afferent arteriole";
"health_atlas_glomerulus_afferent_detail" = "Blood enters at the vascular pole through this arteriole, which branches into the capillary tuft.";
"health_atlas_glomerulus_efferent" = "Efferent arteriole";
"health_atlas_glomerulus_efferent_detail" = "Capillary branches reunite and blood leaves through this arteriole at the same pole.";
"health_atlas_glomerulus_loops" = "Capillary loops";
"health_atlas_glomerulus_loops_detail" = "The tuft is a branching network of capillaries. Their porous endothelial lining, basement membrane, and the podocyte foot processes together form the filtration barrier.";
"health_atlas_glomerulus_tuft_selector" = "Capillary tuft";
"health_atlas_glomerulus_tuft_view" = "Glomerular tuft and its blood vessels";
"health_atlas_hamstrings_biceps_femoris_long_head" = "Biceps femoris: long head";
"health_atlas_hamstrings_biceps_femoris_long_head_detail" = "This outer hamstring head starts at the ischial tuberosity, the sitting bone. Its tendon runs to the head of the fibula on the outside of the knee.";
"health_atlas_hamstrings_biceps_femoris_short_head" = "Biceps femoris: short head";
"health_atlas_hamstrings_biceps_femoris_short_head_detail" = "The short head starts on the back of the femur, not on the pelvis. It lies partly beneath the long head and joins its tendon near the knee.";
"health_atlas_hamstrings_posterior_caption" = "Back of the right thigh: the hamstrings pass to either side of the knee.";
"health_atlas_hamstrings_posterior_selector" = "Hamstring muscles";
"health_atlas_hamstrings_semimembranosus" = "Semimembranosus";
"health_atlas_hamstrings_semimembranosus_detail" = "This broad muscle lies deeper than the semitendinosus. It attaches to the back of the inner tibial condyle near the knee.";
"health_atlas_hamstrings_semitendinosus" = "Semitendinosus";
"health_atlas_hamstrings_semitendinosus_detail" = "This muscle shares an attachment at the sitting bone with the long head of the biceps femoris. Its long lower tendon wraps to the inner side of the upper tibia.";
"health_atlas_la_appendage" = "Atrial appendage";
"health_atlas_la_appendage_detail" = "The left atrial appendage is a narrow muscular pouch. Its inner surface has comb-like pectinate ridges that stay within the pouch.";
"health_atlas_la_cutaway_selector" = "Left atrium cutaway";
"health_atlas_la_cutaway_view" = "Left atrium · Opened from the front, body left at image right";
"health_atlas_la_left_veins" = "Left pulmonary veins";
"health_atlas_la_left_veins_detail" = "The superior and inferior veins from the left lung usually enter through separate openings behind the left atrial appendage.";
"health_atlas_la_posterior_wall" = "Smooth back wall";
"health_atlas_la_posterior_wall_detail" = "The back wall around the four pulmonary vein openings is smooth. Blood entering here passes through the atrium and down through the mitral valve to the left ventricle.";
"health_atlas_la_right_veins" = "Right pulmonary veins";
"health_atlas_la_right_veins_detail" = "The two openings on this side usually receive oxygen-rich blood from the right lung. The upper opening is for the superior vein and the lower opening is for the inferior vein.";
"health_atlas_lv_chordae" = "Tendinous cords";
"health_atlas_lv_chordae_detail" = "These fine cords join the mitral leaflets to the papillary muscles. They help hold the leaflets in place when the ventricle contracts. The aortic valve has no such cords.";
"health_atlas_lv_cutaway_selector" = "Left ventricle cutaway";
"health_atlas_lv_cutaway_view" = "Left ventricle · Oblique long-axis cutaway, apex at lower right";
"health_atlas_lv_myocardium" = "Thick muscle wall";
"health_atlas_lv_myocardium_detail" = "The muscular wall is thicker than in the right ventricle. It surrounds the long chamber, which tapers toward the apex of the heart.";
"health_atlas_lv_papillary" = "Papillary muscles";
"health_atlas_lv_papillary_detail" = "Two groups of papillary muscles project from the ventricular wall. Their tips anchor the cords attached to both mitral leaflets.";
"health_atlas_nephron_loop_limb_selector" = "Loop limbs";
"health_atlas_nephron_loop_limb_view" = "Long nephron loop from cortex to medulla and back";
"health_atlas_nephron_loop_thick_ascending" = "Thick ascending limb";
"health_atlas_nephron_loop_thick_ascending_detail" = "The ascending wall becomes a single layer of cuboidal cells. The thick limb continues into the cortex and then becomes the distal convoluted tubule.";
"health_atlas_nephron_loop_thin_ascending" = "Thin ascending limb";
"health_atlas_nephron_loop_thin_ascending_detail" = "At the hairpin turn of this long loop, the thin-walled tubule reverses direction. The thin ascending limb runs back toward the cortex before its wall thickens.";
"health_atlas_nephron_loop_thin_descending" = "Thin descending limb";
"health_atlas_nephron_loop_thin_descending_detail" = "Below the proximal straight segment, the tubule narrows. A single layer of flat cells lines this limb as it runs deeper into the medulla.";
"health_atlas_outer_ear_canal" = "Ear canal";
"health_atlas_outer_ear_canal_detail" = "The canal curves inward from the concha. Its outer portion is supported by cartilage; its inner portion runs through the temporal bone.";
"health_atlas_outer_ear_concha" = "Concha";
"health_atlas_outer_ear_concha_detail" = "This deep bowl of the auricle funnels sound toward the opening of the ear canal, beside the tragus.";
"health_atlas_outer_ear_eardrum" = "Eardrum";
"health_atlas_outer_ear_eardrum_detail" = "The thin, slanted tympanic membrane closes the inner end of the canal and separates it from the middle ear.";
"health_atlas_outer_ear_helix" = "Helix";
"health_atlas_outer_ear_helix_detail" = "This rolled cartilage rim curves around the upper and back edges of the auricle.";
"health_atlas_outer_ear_selector" = "Ear canal cutaway";
"health_atlas_outer_ear_view" = "Auricle and ear canal, from the outer rim to the eardrum";
"health_atlas_outer_inner_ear_loops" = "Semicircular canals";
"health_atlas_outer_inner_ear_loops_detail" = "Three bony loops lie in different planes and house ducts that sense head rotation. The two upright canals share one limb near the vestibule.";
"health_atlas_outer_inner_ear_nerve" = "Vestibulocochlear nerve";
"health_atlas_outer_inner_ear_nerve_detail" = "Vestibular and cochlear fibers run together through the internal acoustic canal toward the brainstem, carrying balance and hearing signals.";
"health_atlas_outer_inner_ear_selector" = "Bony labyrinth";
"health_atlas_outer_inner_ear_vestibule" = "Vestibule";
"health_atlas_outer_inner_ear_vestibule_detail" = "This chamber lies between the semicircular canals and cochlea. It houses the utricle and saccule, which sense linear motion and head tilt.";
"health_atlas_outer_inner_ear_view" = "Inner ear in oblique view: canals, vestibule, cochlea and nerve";
"health_atlas_outer_nose_inferior_concha" = "Inferior nasal concha";
"health_atlas_outer_nose_inferior_concha_detail" = "The lowest and largest shelf runs above the hard palate. The nasal passage opens behind it into the nasopharynx.";
"health_atlas_outer_nose_middle_concha" = "Middle nasal concha";
"health_atlas_outer_nose_middle_concha_detail" = "This curved shelf on the side wall lies between the smaller superior concha and the larger inferior concha. The passage directly beneath it is the middle meatus.";
"health_atlas_outer_nose_selector" = "Nasal wall cutaway";
"health_atlas_outer_nose_vestibule" = "Nasal vestibule";
"health_atlas_outer_nose_vestibule_detail" = "Just inside the nostril, this short skin-lined entrance leads back into the nasal cavity.";
"health_atlas_outer_nose_view" = "Side view of the nose, with the septum removed to reveal one lateral wall";
"health_atlas_outer_tongue_muscle" = "Intrinsic tongue muscle";
"health_atlas_outer_tongue_muscle_detail" = "Lengthwise, crosswise and vertical muscle fibers interweave beneath the surface. These fibers change the shape of the tongue.";
"health_atlas_outer_tongue_selector" = "Dorsal cutaway";
"health_atlas_outer_tongue_sulcus" = "Terminal sulcus";
"health_atlas_outer_tongue_sulcus_detail" = "This V-shaped groove points back toward the throat. It separates the front two-thirds of the tongue from the root.";
"health_atlas_outer_tongue_tonsil" = "Lingual tonsil";
"health_atlas_outer_tongue_tonsil_detail" = "Small clusters of lymphoid tissue form low nodules in the mucosa of the tongue root, behind the terminal sulcus.";
"health_atlas_outer_tongue_vallate" = "Vallate papillae";
"health_atlas_outer_tongue_vallate_detail" = "These large, ringed papillae form a row just in front of the terminal sulcus. They contain microscopic taste buds, as do the smaller fungiform papillae scattered farther forward.";
"health_atlas_outer_tongue_view" = "Tongue from above, with the root at the top and a muscle cutaway along one side";
"health_atlas_ovarian_antral_follicle" = "Antral follicle";
"health_atlas_ovarian_antral_follicle_detail" = "Fluid fills the antrum of this larger follicle. The oocyte sits off center in a mound of supporting cells against the follicle wall.";
"health_atlas_ovarian_cortex_band" = "Ovarian cortex";
"health_atlas_ovarian_cortex_band_detail" = "The outer region of the ovary, just under its thin connective tissue capsule, contains follicles at different stages.";
"health_atlas_ovarian_hilum" = "Ovarian hilum";
"health_atlas_ovarian_hilum_detail" = "Blood vessels and nerves pass between the mesovarium and the medulla at the attached edge of the ovary.";
"health_atlas_ovarian_medulla_core" = "Ovarian medulla";
"health_atlas_ovarian_medulla_core_detail" = "The inner connective tissue contains branching blood vessels, lymphatic vessels, and nerves.";
"health_atlas_ovarian_section_selector" = "Ovary cutaway";
"health_atlas_ovarian_section_view" = "Longitudinal section of one adult ovary. The nearby uterine tube is shown for orientation. Scale bar: about 1 cm.";
"health_atlas_ovarian_small_follicle" = "Growing follicle";
"health_atlas_ovarian_small_follicle_detail" = "In this small cortical follicle, supporting cells surround the oocyte. A large fluid cavity has not yet formed.";
"health_atlas_patella_landmarks_apex" = "Patellar apex";
"health_atlas_patella_landmarks_apex_detail" = "The pointed lower tip gives attachment to the patellar ligament.";
"health_atlas_patella_landmarks_base" = "Patellar base";
"health_atlas_patella_landmarks_base_detail" = "The quadriceps tendon attaches along this broad upper edge.";
"health_atlas_patella_landmarks_caption" = "Right patella, posterior view with side detail at the knee";
"health_atlas_patella_landmarks_lateral_facet" = "Lateral facet";
"health_atlas_patella_landmarks_lateral_facet_detail" = "This outer joint surface is usually broader than the medial facet.";
"health_atlas_patella_landmarks_medial_facet" = "Medial facet";
"health_atlas_patella_landmarks_medial_facet_detail" = "This smooth area on the inner side faces the medial side of the femoral groove.";
"health_atlas_patella_landmarks_ridge" = "Vertical ridge";
"health_atlas_patella_landmarks_ridge_detail" = "This ridge separates the two main facets and tracks along the femoral groove.";
"health_atlas_patella_landmarks_selector" = "Patellar facets";
"health_atlas_peripheral_nerve_endoneurium" = "Endoneurium";
"health_atlas_peripheral_nerve_endoneurium_detail" = "This delicate connective tissue surrounds individual nerve fibers within a fascicle. It lies outside the Schwann cells associated with the axons.";
"health_atlas_peripheral_nerve_epineurium" = "Epineurium";
"health_atlas_peripheral_nerve_epineurium_detail" = "This outer connective tissue encloses the whole nerve and extends between its fascicles.";
"health_atlas_peripheral_nerve_fascicle" = "Nerve fascicle";
"health_atlas_peripheral_nerve_fascicle_cutaway_selector" = "Nerve cutaway";
"health_atlas_peripheral_nerve_fascicle_cutaway_view" = "A peripheral nerve trunk opened along its length and across its end. One fascicle is shown with individual fibers exposed.";
"health_atlas_peripheral_nerve_fascicle_detail" = "A fascicle is a bundle of nerve fibers that runs lengthwise within the nerve.";
"health_atlas_peripheral_nerve_perineurium" = "Perineurium";
"health_atlas_peripheral_nerve_perineurium_detail" = "This layered sheath encloses a single fascicle, not the entire nerve.";
"health_atlas_proximal_tubule_brush_selector" = "Brush border";
"health_atlas_proximal_tubule_brush_view" = "Proximal tubule: cortical coils and open wall";
"health_atlas_proximal_tubule_coil" = "Cortical coil";
"health_atlas_proximal_tubule_coil_detail" = "The proximal convoluted tubule begins at the urinary pole. It winds through the cortex and continues as a straighter segment before narrowing into the thin descending limb.";
"health_atlas_proximal_tubule_cuboidal" = "Cuboidal lining";
"health_atlas_proximal_tubule_cuboidal_detail" = "A single layer of cuboidal cells surrounds the lumen. Their apical surfaces face inward, and their bases rest on a basement membrane.";
"health_atlas_proximal_tubule_microvilli" = "Brush border";
"health_atlas_proximal_tubule_microvilli_detail" = "Dense microvilli project from the apical surface into the lumen. They give the lining a brush-like edge and increase its surface area.";
"health_atlas_quadriceps_femoris_anterior_caption" = "Front of the right thigh, with a separate inset of the deep vastus intermedius.";
"health_atlas_quadriceps_femoris_anterior_selector" = "Quadriceps layers";
"health_atlas_quadriceps_rectus_femoris" = "Rectus femoris";
"health_atlas_quadriceps_rectus_femoris_detail" = "This long, central muscle lies over the vastus intermedius. It starts on the pelvis and helps bend the hip as well as straighten the knee.";
"health_atlas_quadriceps_tendon" = "Quadriceps tendon";
"health_atlas_quadriceps_tendon_detail" = "The four muscles converge into this tendon above the kneecap. Below the kneecap, the patellar ligament continues to the tibia.";
"health_atlas_quadriceps_vastus_intermedius" = "Vastus intermedius";
"health_atlas_quadriceps_vastus_intermedius_detail" = "The inset shows this muscle on the front of the femur with the overlying rectus femoris omitted. Like the other three muscles, it helps straighten the knee.";
"health_atlas_quadriceps_vastus_lateralis" = "Vastus lateralis";
"health_atlas_quadriceps_vastus_lateralis_detail" = "This broad muscle starts on the femur and forms the outer part of the quadriceps. It helps straighten the knee.";
"health_atlas_quadriceps_vastus_medialis" = "Vastus medialis";
"health_atlas_quadriceps_vastus_medialis_detail" = "This muscle forms the inner part of the quadriceps. Its lower fibers form a rounded bulge just above the inside of the kneecap.";
"health_atlas_ra_cutaway_selector" = "Right atrium cutaway";
"health_atlas_ra_cutaway_view" = "Right atrium · Opened and spread, front wall at image left";
"health_atlas_ra_fossa" = "Fossa ovalis";
"health_atlas_ra_fossa_detail" = "This shallow oval depression lies in the wall between the atria. It marks the former site of the fetal opening between the two chambers.";
"health_atlas_ra_ivc" = "Lower caval opening";
"health_atlas_ra_ivc_detail" = "The inferior vena cava enters from below, returning blood from the abdomen, pelvis, and lower limbs. The smaller coronary sinus opening lies just above and toward the septum.";
"health_atlas_ra_pectinate" = "Pectinate muscles";
"health_atlas_ra_pectinate_detail" = "These comb-like ridges fan across the front wall and right atrial appendage. The raised terminal crest separates them from the smooth region that receives the venae cavae.";
"health_atlas_ra_svc" = "Upper caval opening";
"health_atlas_ra_svc_detail" = "The superior vena cava enters from above, returning blood from the head, neck, upper limbs, and chest to the smooth back of the atrium.";
"health_atlas_rv_cutaway_selector" = "Right ventricle cutaway";
"health_atlas_rv_cutaway_view" = "Right ventricle · Opened from the front, inlet at image left";
"health_atlas_rv_infundibulum" = "Outflow tract";
"health_atlas_rv_infundibulum_detail" = "The smooth muscular outflow tract, or infundibulum, narrows upward to the pulmonary valve. Blood passes through that valve into the pulmonary trunk.";
"health_atlas_rv_moderator_band" = "Moderator band";
"health_atlas_rv_moderator_band_detail" = "This muscular bridge crosses from the wall between the ventricles to the base of the anterior papillary muscle on the free-wall side.";
"health_atlas_rv_trabeculae" = "Trabeculae carneae";
"health_atlas_rv_trabeculae_detail" = "Coarse muscle ridges line the lower part of the chamber. They give its inner surface a rough texture unlike the smooth upper outflow tract.";
"health_atlas_skin_cross_section" = "Skin cross-section";
"health_atlas_skin_layers_basale" = "Stratum basale";
"health_atlas_skin_layers_basale_detail" = "Dividing cells at the base supply new keratinocytes to the layers above.";
"health_atlas_skin_layers_capillary_loop" = "Capillary loop";
"health_atlas_skin_layers_capillary_loop_detail" = "Small vascular loops reach into dermal papillae. Nutrients diffuse from the dermis into the overlying epidermis.";
"health_atlas_skin_layers_corneum" = "Stratum corneum";
"health_atlas_skin_layers_corneum_detail" = "Flattened cells surrounded by lipids make up the outer barrier that limits water loss.";
"health_atlas_skin_layers_follicle" = "Hair follicle";
"health_atlas_skin_layers_follicle_detail" = "A tube of epithelium extends into the dermis and surrounds the root of the hair.";
"health_atlas_skin_layers_granulosum" = "Stratum granulosum";
"health_atlas_skin_layers_granulosum_detail" = "Flattening keratinocytes contain visible granules as they mature toward the surface.";
"health_atlas_skin_layers_lucidum" = "Stratum lucidum";
"health_atlas_skin_layers_lucidum_detail" = "A pale layer beneath the stratum corneum is visible in the thick skin of palms and soles.";
"health_atlas_skin_layers_papillary" = "Papillary dermis";
"health_atlas_skin_layers_papillary_detail" = "Superficial loose connective tissue forms small projections into the base of the epidermis.";
"health_atlas_skin_layers_reticular" = "Reticular dermis";
"health_atlas_skin_layers_reticular_detail" = "Thicker bundles of collagen and elastic fibers give the deeper dermis strength and flexibility.";
"health_atlas_skin_layers_sensory_fiber" = "Sensory fiber";
"health_atlas_skin_layers_sensory_fiber_detail" = "Branches of sensory nerves pass through the dermis and carry signals from skin receptors.";
"health_atlas_skin_layers_spinosum" = "Stratum spinosum";
"health_atlas_skin_layers_spinosum_detail" = "Cell junctions hold neighboring keratinocytes together. They contribute to the spiny appearance seen under a microscope.";
"health_atlas_skin_layers_sweat_duct" = "Sweat duct";
"health_atlas_skin_layers_sweat_duct_detail" = "The duct of this eccrine gland carries sweat from its coiled base to a pore on the surface.";
"health_atlas_skin_layers_vessels" = "Dermal vessels";
"health_atlas_skin_layers_vessels_detail" = "Blood vessels run through the dermis, not through the epidermis above it.";
"health_atlas_spinal_nerve_dorsal_ramus" = "Dorsal ramus";
"health_atlas_spinal_nerve_dorsal_ramus_detail" = "This smaller mixed branch supplies deep back muscles and carries sensation from skin over the back.";
"health_atlas_spinal_nerve_dorsal_root" = "Dorsal root";
"health_atlas_spinal_nerve_dorsal_root_detail" = "Sensory fibers enter the back of the spinal cord through this root. Their neuron cell bodies lie in the swelling along it, the dorsal root ganglion.";
"health_atlas_spinal_nerve_mixed_trunk" = "Mixed spinal nerve";
"health_atlas_spinal_nerve_mixed_trunk_detail" = "Where the two roots unite, their sensory and motor fibers run together in a short trunk before it branches.";
"health_atlas_spinal_nerve_roots_and_rami_selector" = "Roots and rami";
"health_atlas_spinal_nerve_roots_and_rami_view" = "One side of a spinal cord segment, with the back at the top. The two roots meet in a short spinal nerve, which then divides into two primary branches, or rami.";
"health_atlas_spinal_nerve_ventral_ramus" = "Ventral ramus";
"health_atlas_spinal_nerve_ventral_ramus_detail" = "This larger mixed branch carries fibers to and from the front and sides of the trunk and, at limb levels, to and from the limbs.";
"health_atlas_spinal_nerve_ventral_root" = "Ventral root";
"health_atlas_spinal_nerve_ventral_root_detail" = "Motor fibers leave the front of the spinal cord through this root. It has no ganglion and joins the dorsal root beyond the dorsal root ganglion.";
"health_atlas_testicular_rete" = "Rete testis";
"health_atlas_testicular_rete_detail" = "This network lies within the posterior mediastinum. Efferent ductules leave its upper end and enter the head of the epididymis.";
"health_atlas_testicular_section_selector" = "Testis cutaway";
"health_atlas_testicular_section_view" = "Longitudinal section of one adult testis, with its posterior border on the right. Scale bar: about 1 cm.";
"health_atlas_testicular_septum" = "Testicular septum";
"health_atlas_testicular_septum_detail" = "Thin partitions extend inward from the capsule toward the mediastinum, dividing the interior into lobules. Only a few lobules are shown.";
"health_atlas_testicular_tubules" = "Seminiferous tubules";
"health_atlas_testicular_tubules_detail" = "These tightly coiled tubes lie within the lobules. Near the mediastinum, short straight tubules connect them to the rete testis.";
"health_atlas_testicular_tunica_albuginea" = "Tunica albuginea";
"health_atlas_testicular_tunica_albuginea_detail" = "A dense, pale connective tissue capsule surrounds the testis and thickens at its posterior border to form the mediastinum.";
"health_atlas_triceps_brachii_distal_tendon" = "Triceps tendon";
"health_atlas_triceps_brachii_distal_tendon_detail" = "The tendon attaches at the olecranon, the bony point of the ulna at the back of the elbow. The triceps pulls here to straighten the elbow.";
"health_atlas_triceps_brachii_lateral_head" = "Lateral head";
"health_atlas_triceps_brachii_lateral_head_detail" = "This superficial head starts high on the back of the humerus and forms the outer part of the triceps.";
"health_atlas_triceps_brachii_long_head" = "Long head";
"health_atlas_triceps_brachii_long_head_detail" = "The long head starts just below the shoulder socket on the shoulder blade. It crosses both the shoulder and the elbow.";
"health_atlas_triceps_brachii_medial_head" = "Medial head";
"health_atlas_triceps_brachii_medial_head_detail" = "This head starts lower on the back of the humerus. Most of it lies beneath the other two heads, with a portion exposed near the elbow.";
"health_atlas_triceps_brachii_posterior_caption" = "Back of the right upper arm: the deep medial head is visible near the elbow.";
"health_atlas_triceps_brachii_posterior_selector" = "Triceps heads";
"health_atlas_tubal_ampulla" = "Ampulla";
"health_atlas_tubal_ampulla_detail" = "The long, wide segment between the infundibulum and the isthmus has especially elaborate mucosal folds.";
"health_atlas_tubal_fimbriae" = "Fimbriae";
"health_atlas_tubal_fimbriae_detail" = "These fingerlike extensions fringe the opening of the tube. They lie near the ovary without sealing the space between the tube and the ovary.";
"health_atlas_tubal_infundibulum" = "Infundibulum";
"health_atlas_tubal_infundibulum_detail" = "The flared outer end of the tube opens into the peritoneal cavity beside the ovary.";
"health_atlas_tubal_isthmus" = "Isthmus";
"health_atlas_tubal_isthmus_detail" = "This narrow segment joins the wider ampulla to the short portion that passes through the uterine wall and opens into the uterine cavity.";
"health_atlas_tubal_mucosal_folds" = "Mucosal folds";
"health_atlas_tubal_mucosal_folds_detail" = "Branching ridges of the lining project into the ampullary lumen. A ring of smooth muscle surrounds the folded mucosa.";
"health_atlas_ulna_landmarks_caption" = "Right ulna, lateral view with front view of the forearm bones";
"health_atlas_ulna_landmarks_coronoid" = "Coronoid process";
"health_atlas_ulna_landmarks_coronoid_detail" = "This forward-pointing lip forms the lower rim of the trochlear notch.";
"health_atlas_ulna_landmarks_head" = "Ulnar head";
"health_atlas_ulna_landmarks_head_detail" = "The rounded wrist end of the ulna meets the radius at the distal radioulnar joint.";
"health_atlas_ulna_landmarks_olecranon" = "Olecranon";
"health_atlas_ulna_landmarks_olecranon_detail" = "This upper projection forms the bony tip of the elbow.";
"health_atlas_ulna_landmarks_selector" = "Lateral landmarks";
"health_atlas_ulna_landmarks_styloid" = "Ulnar styloid";
"health_atlas_ulna_landmarks_styloid_detail" = "This small projection extends from the back of the ulnar head near the wrist.";
"health_atlas_ulna_landmarks_trochlear_notch" = "Trochlear notch";
"health_atlas_ulna_landmarks_trochlear_notch_detail" = "This curved surface cups the trochlea of the humerus at the elbow.";
"health_atlas_uterine_tube_cutaway_selector" = "Tube cutaway";
"health_atlas_uterine_tube_cutaway_view" = "One uterine tube opened along its length, from the ovary side at left to the uterine corner at right. The inset enlarges a cross section through the ampulla.";
"health_atlas_valve_detail_aortic_left" = "Left coronary cusp";
"health_atlas_valve_detail_aortic_left_detail" = "The left cusp sits beneath the left aortic sinus, a pocket in the root wall. The left coronary artery begins at an opening in that sinus, not in the cusp itself.";
"health_atlas_valve_detail_aortic_noncoronary" = "Noncoronary cusp";
"health_atlas_valve_detail_aortic_noncoronary_detail" = "The posterior cusp borders a sinus with no coronary opening. Its free edge meets the other two as the ventricle relaxes, closing the route back into the left ventricle.";
"health_atlas_valve_detail_aortic_ostium" = "Left coronary ostium";
"health_atlas_valve_detail_aortic_ostium_detail" = "This small opening in the sinus wall is the entrance to the left coronary artery. A second opening above the right cusp leads to the right coronary artery.";
"health_atlas_valve_detail_aortic_right" = "Right coronary cusp";
"health_atlas_valve_detail_aortic_right_detail" = "The right cusp sits beneath the right aortic sinus. The dark opening just above this cusp leads into the right coronary artery.";
"health_atlas_valve_detail_aortic_selector" = "Aortic valve cutaway";
"health_atlas_valve_detail_aortic_view" = "Aortic root · Oblique view from above and behind, cusps closed";
"health_atlas_valve_detail_mitral_anterior" = "Anterior leaflet";
"health_atlas_valve_detail_mitral_anterior_detail" = "The longer, sail-shaped leaflet hinges beside the left ventricular outflow tract. Its base shares a fibrous connection with the aortic valve.";
"health_atlas_valve_detail_mitral_chordae" = "Chordae tendineae";
"health_atlas_valve_detail_mitral_chordae_detail" = "Cords from each papillary muscle group reach both leaflets. They help hold the leaflet edges together when the left ventricle contracts.";
"health_atlas_valve_detail_mitral_papillary" = "Papillary muscles";
"health_atlas_valve_detail_mitral_papillary_detail" = "Two groups, anterolateral and posteromedial, project from the left ventricular wall. The chordae rise from their tips to the leaflets.";
"health_atlas_valve_detail_mitral_posterior" = "Posterior leaflet";
"health_atlas_valve_detail_mitral_posterior_detail" = "This shorter leaflet wraps around more of the opening, along the ventricular free wall. Its free edge has scallops rather than a single smooth curve.";
"health_atlas_valve_detail_mitral_selector" = "Mitral valve cutaway";
"health_atlas_valve_detail_mitral_view" = "Left-heart inflow · Oblique cutaway, left atrium above";
"health_atlas_valve_detail_pulmonary_anterior" = "Anterior cusp";
"health_atlas_valve_detail_pulmonary_anterior_detail" = "The front cusp borders the near side of the opening. All three cusps open toward the pulmonary trunk as the right ventricle ejects blood. They have no chordae.";
"health_atlas_valve_detail_pulmonary_left" = "Left cusp";
"health_atlas_valve_detail_pulmonary_left_detail" = "The left cusp is at image right. Like the right cusp, it faces the nearby aortic root, which lies behind the pulmonary root and is not shown.";
"health_atlas_valve_detail_pulmonary_right" = "Right cusp";
"health_atlas_valve_detail_pulmonary_right_detail" = "The right cusp is at image left in this anterior view. A shallow sinus lies between the cusp and the pulmonary trunk wall on its arterial side.";
"health_atlas_valve_detail_pulmonary_selector" = "Pulmonary valve cutaway";
"health_atlas_valve_detail_pulmonary_view" = "Pulmonary root · Oblique view from above and in front, cusps open";
"health_atlas_valve_detail_tricuspid_anterior" = "Anterior leaflet";
"health_atlas_valve_detail_tricuspid_anterior_detail" = "The broad anterior leaflet hinges along the front of the right atrioventricular opening. It opens into the right ventricle as blood enters from the right atrium.";
"health_atlas_valve_detail_tricuspid_chordae" = "Chordae tendineae";
"health_atlas_valve_detail_tricuspid_chordae_detail" = "These thin cords run from papillary muscles to the ventricular side of the leaflets. They keep the closing leaflets from folding back into the atrium when the right ventricle contracts.";
"health_atlas_valve_detail_tricuspid_posterior" = "Posterior leaflet";
"health_atlas_valve_detail_tricuspid_posterior_detail" = "Also called the inferior leaflet, it hinges along the lower part of the opening. Here it forms the near rim of the gap between the three open leaflets.";
"health_atlas_valve_detail_tricuspid_selector" = "Tricuspid valve cutaway";
"health_atlas_valve_detail_tricuspid_septal" = "Septal leaflet";
"health_atlas_valve_detail_tricuspid_septal_detail" = "This leaflet hinges beside the wall that separates the ventricles. Some of its chordae attach directly to that wall.";
"health_atlas_valve_detail_tricuspid_view" = "Right-heart inflow · Oblique cutaway, right atrium above";
