"health_atlas_cardiac_phase_time_companion" = "Whole cardiac cycle: %1$@ ms";
"health_atlas_cardiac_phase_time_filling_percent" = "Assumed filling percentage of the cycle";
"health_atlas_cardiac_phase_time_formula" = "Whole cycle (ms) = 60,000 ÷ heart rate (bpm). Simulated filling time = whole cycle × (filling percentage ÷ 100).";
"health_atlas_cardiac_phase_time_rate" = "Simulated heart rate";
"health_atlas_cardiac_phase_time_scope" = "In a normally beating human heart, blood flows from the atria into the ventricles during filling. This simulation assumes a steady heart rate. The filling percentage is a share of time chosen independently, not a prediction from heart rate or a share of blood volume. The model does not predict filling in any individual or estimate cardiac output.";
"health_atlas_cardiac_phase_time_title" = "Simulated ventricular filling time";
"health_atlas_diaphragm_demo_area" = "Effective projected area";
"health_atlas_diaphragm_demo_current" = "Lowered";
"health_atlas_diaphragm_demo_descent" = "Downward displacement";
"health_atlas_diaphragm_demo_diagram" = "Schematic chest cross-section, not to scale. Blue dashed line: resting diaphragm. Solid teal line: lowered diaphragm.";
"health_atlas_diaphragm_demo_formula" = "Volume change = projected area × displacement (converted to cm)";
"health_atlas_diaphragm_demo_per_mm" = "Extra space per 1 mm of descent: %1$@ mL";
"health_atlas_diaphragm_demo_resting" = "Resting";
"health_atlas_diaphragm_demo_scope" = "The chest is simplified to a fixed cross-section with a moving floor. This shows only the geometric space made by the diaphragm. It omits rib motion and tissue deformation and does not estimate how much air a person breathes.";
"health_atlas_diaphragm_demo_title" = "Diaphragm descent and chest volume";
"health_atlas_duct_transit_companion" = "Model time per length unit: %1$@ TU/LU";
"health_atlas_duct_transit_formula" = "Model time (TU) = path length (LU) ÷ marker speed (LU/TU).";
"health_atlas_duct_transit_length" = "Model path length";
"health_atlas_duct_transit_scope" = "The epididymis, vas deferens, and ejaculatory ducts are parts of the male reproductive tract. Smooth muscle helps move contents through the epididymis and vas deferens. This model follows an ideal marker moving at constant speed through a single representative straightened duct segment. The geometry is invented, with arbitrary units for length (LU) and time (TU). Marker transport does not represent sperm motility or fertility. The model does not simulate ejaculation or conception, or estimate actual transit duration.";
"health_atlas_duct_transit_speed" = "Constant marker speed";
"health_atlas_duct_transit_title" = "Idealized duct transit time";
"health_atlas_hormone_signal_elapsed" = "Time since secretion stopped (example ticks)";
"health_atlas_hormone_signal_formula" = "Percent of starting signal remaining = 100 × 2^(−elapsed time ÷ half-life).";
"health_atlas_hormone_signal_half_life" = "Half-life (example ticks)";
"health_atlas_hormone_signal_removed" = "Starting signal removed: %1$@%%";
"health_atlas_hormone_signal_scope" = "This simulation starts when secretion of a generic circulating signal stops. It sets the starting level to 100 percent and assumes a constant half-life: each half-life removes half of what remains. The ticks are arbitrary, not physical time units. This is not the half-life of any named hormone or a patient result, and it does not model ongoing secretion or feedback.";
"health_atlas_hormone_signal_title" = "Circulating signal remaining";
"health_atlas_immune_composition_companion" = "Other white blood cells: %1$@ cells";
"health_atlas_immune_composition_formula" = "Selected count = fraction × sample size, where fraction = selected percentage ÷ 100. At the same fraction, a larger sample contains more selected cells unless the fraction is zero.";
"health_atlas_immune_composition_sample_size" = "Total white blood cells in the sample";
"health_atlas_immune_composition_scope" = "This classroom model counts only white blood cells (leukocytes) in a simulated sample. Sample sizes and percentages are invented, not clinical measurements or reference ranges. Neutrophils, eosinophils, and basophils are granulocytes. T cells, B cells, and natural killer cells are lymphocytes. Monocytes are a separate group.";
"health_atlas_immune_composition_selected_percent" = "Percentage in the selected group";
"health_atlas_immune_composition_title" = "Selected white blood cell count";
"health_atlas_knee_moment_arm" = "Perpendicular moment arm";
"health_atlas_knee_moment_arm_meters" = "Moment arm: %1$@ m";
"health_atlas_knee_moment_force" = "Synthetic extensor force";
"health_atlas_knee_moment_formula" = "Knee extension moment (N·m) = F × (d / 100)\nF: synthetic extensor force (N). d: perpendicular distance from the knee axis to the line of action of the force (cm). Dividing by 100 converts cm to m.";
"health_atlas_knee_moment_scope" = "The patella helps redirect the pull of the quadriceps so force is transmitted to the tibia through the patellar tendon. This example uses synthetic inputs for a single force about a fixed knee axis. The moment is proportional to either input when the other is held fixed. The example does not simulate patellar tracking, knee motion, or injury, estimate patient forces, or guide training.";
"health_atlas_knee_moment_title" = "Knee extension moment";
"health_atlas_model_visual_angle_distance" = "Viewing distance (D)";
"health_atlas_model_visual_angle_formula" = "Visual angle (degrees) = 2 × arctan(W / (2 × D)) × 180 / π. W is the object width and D is the distance from the viewing point to its center, both in cm.";
"health_atlas_model_visual_angle_half" = "Half-angle (line of sight to either edge): %1$@°";
"health_atlas_model_visual_angle_scope" = "This vision-only example uses synthetic widths and distances in two dimensions. The object is centered on and perpendicular to the line of sight. In normal vision, the eye focuses light on the retina; this model only calculates the angle at the viewing point. It does not predict visual acuity or refractive error or assess eye health.";
"health_atlas_model_visual_angle_title" = "Central visual angle";
"health_atlas_model_visual_angle_width" = "Object width (W)";
"health_atlas_oviduct_ciliary_cycles_companion" = "Time per beat cycle: %1$@ ms";
"health_atlas_oviduct_ciliary_cycles_formula" = "Cycles elapsed = beat rate (Hz) × elapsed time (s), including any partial cycle. Time per cycle (ms) = 1,000 ÷ beat rate (Hz).";
"health_atlas_oviduct_ciliary_cycles_rate" = "Simulated beat rate";
"health_atlas_oviduct_ciliary_cycles_scope" = "This teaching model simulates one motile cilium in the ciliated epithelium of a human uterine tube, beating at a constant rate. The inputs are synthetic examples, not medical measurements or reference ranges. The model does not predict egg-cell (ovum) velocity, ovulation, conception, pregnancy, or individual fertility.";
"health_atlas_oviduct_ciliary_cycles_time" = "Simulated elapsed time";
"health_atlas_oviduct_ciliary_cycles_title" = "Uterine tube ciliary beat cycles";
"health_atlas_serial_absorption_companion" = "Still in the lumen after B: %1$@%% of the starting amount";
"health_atlas_serial_absorption_formula" = "Let a and b be the slider percentages divided by 100. For a starting amount M, A absorbs M × a and B absorbs M × (1 − a) × b. The plot shows the sum as a percentage of M. The amount left in the lumen is M × (1 − a) × (1 − b).";
"health_atlas_serial_absorption_scope" = "This bookkeeping model follows an already dissolved generic nutrient through two representative small-intestinal segments in sequence. Both stages represent combined uptake across a segment, not a measured rate for a single enterocyte. A and B do not stand for named anatomical regions. The percentages are invented, not reference values. The model ignores digestion, transit time, and what happens after absorption; it does not predict real uptake.";
"health_atlas_serial_absorption_stage_a" = "A: uptake from the starting amount";
"health_atlas_serial_absorption_stage_b" = "B: uptake from what remains after A";
"health_atlas_serial_absorption_title" = "Two-stage intestinal absorption";
