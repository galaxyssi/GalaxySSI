"health_atlas_arterial_continuity_area" = "Lumen area: %1$@ cm²";
"health_atlas_arterial_continuity_diagram" = "The circle shows the lumen cross-section. The arrow length represents mean speed, not individual cells or the speed at each point in the lumen.";
"health_atlas_arterial_continuity_diameter" = "Model lumen diameter";
"health_atlas_arterial_continuity_flow" = "Model volume flow";
"health_atlas_arterial_continuity_formula" = "Mean speed = volume flow ÷ lumen area. For a round lumen, area = π × (diameter ÷ 2)².";
"health_atlas_arterial_continuity_scope" = "A rigid circular tube illustrates steady flow in one section of the aorta or pulmonary trunk. The example does not model the heartbeat, vessel wall motion, pressure, or a personal measurement.";
"health_atlas_arterial_continuity_section" = "Lumen cross-section";
"health_atlas_arterial_continuity_speed" = "Mean flow speed";
"health_atlas_arterial_continuity_title" = "Flow through an arterial section";
"health_atlas_bone_section_area" = "Cortical cross-sectional area: %1$@ mm²";
"health_atlas_bone_section_force" = "Axial compressive force";
"health_atlas_bone_section_formula" = "The outer radius is fixed at 5 mm. Inner radius = outer radius − wall thickness. Cortical area = π × (outer radius² − inner radius²). Nominal compressive stress = force ÷ cortical area (1 N/mm² = 1 MPa).";
"health_atlas_bone_section_scope" = "Compact (cortical) bone forms the wall around the marrow cavity in a long-bone shaft. The model represents only a short shaft segment as a straight, circular tube: for example, part of the clavicle midshaft, a metacarpal in the hand, or a metatarsal in the foot. The force acts along the centerline. At the same force, a thicker wall spreads the load over more area and lowers the average stress. All values are synthetic. The model ignores variations in shape, bending and twisting; it does not estimate stress or fracture risk in a real bone.";
"health_atlas_bone_section_title" = "Nominal axial compressive stress";
"health_atlas_bone_section_wall_thickness" = "Cortical wall thickness";
"health_atlas_colonic_water_balance_companion" = "Net water absorbed: %1$@ mL";
"health_atlas_colonic_water_balance_formula" = "Net water absorbed (mL) = starting water volume (mL) × (net absorbed percentage ÷ 100). Water remaining (mL) = starting water volume (mL) − net water absorbed (mL).";
"health_atlas_colonic_water_balance_net_absorbed" = "Net absorbed percentage";
"health_atlas_colonic_water_balance_scope" = "The colon absorbs much of the water left in the contents arriving from the small intestine. This model starts with an example volume of water in the colon. The chosen percentage summarizes net uptake (absorption minus secretion) as a share of that starting volume. The values are for teaching only; they are not reference ranges and do not predict individual absorption or stool output.";
"health_atlas_colonic_water_balance_starting_volume" = "Starting water volume";
"health_atlas_colonic_water_balance_title" = "Water remaining in the colon";
"health_atlas_endocrine_dilution_amount" = "Tracer amount";
"health_atlas_endocrine_dilution_companion" = "Tracer amount conserved: %1$@ TU";
"health_atlas_endocrine_dilution_formula" = "Tracer concentration = tracer amount ÷ final volume. Doubling only the volume halves the concentration. Doubling only the amount doubles it.";
"health_atlas_endocrine_dilution_scope" = "After secretion, hormones can travel in the blood. Some signals also act on nearby cells, as in pancreatic islets. This analogy compares evenly mixed samples with no tracer loss. TU and VU are imaginary units of tracer amount and volume. This model does not simulate mixing in the body or hormone kinetics, and it cannot predict blood hormone levels.";
"health_atlas_endocrine_dilution_title" = "Tracer concentration after dilution";
"health_atlas_endocrine_dilution_volume" = "Final volume";
"health_atlas_glial_capacitance_area" = "Relative inner surface area";
"health_atlas_glial_capacitance_formula" = "Relative capacitance = relative area × ln(1.5) ÷ ln(1 + relative thickness ÷ 2), where ln is the natural logarithm.";
"health_atlas_glial_capacitance_per_area" = "Relative capacitance per inner area: %1$@ ×";
"health_atlas_glial_capacitance_scope" = "Myelinating Schwann cells wrap axons in the peripheral nervous system; oligodendrocytes do so in the central nervous system. This model replaces one myelinated segment with an ideal cylindrical capacitor and holds the inner radius and insulating material fixed. Area changes with segment length. Values are multiples of a synthetic baseline in which shell thickness is half the inner radius. A thicker shell reduces capacitance, so it stores less charge at the same voltage and area. The model does not estimate nerve conduction speed or support diagnosis.";
"health_atlas_glial_capacitance_thickness" = "Relative shell thickness";
"health_atlas_glial_capacitance_title" = "Ideal myelin-shell capacitance";
"health_atlas_keratin_growth_companion" = "Demo time to add 1 mm: %1$@ d";
"health_atlas_keratin_growth_formula" = "Added shaft length (mm) = example growth rate (mm/d) × elapsed demo time (d).";
"health_atlas_keratin_growth_rate" = "Example growth rate";
"health_atlas_keratin_growth_scope" = "During active growth, hair matrix cells divide in the follicle. Some of the new cells become part of the keratinized shaft as it moves outward. This demo assumes a constant rate and does not model the hair cycle. The rate and time are invented for teaching and do not measure or predict individual hair growth.";
"health_atlas_keratin_growth_time" = "Elapsed demo time";
"health_atlas_keratin_growth_title" = "Hair shaft length added";
"health_atlas_lymph_particle_transport_companion" = "Dye mass carried in 5 min: %1$@ µg";
"health_atlas_lymph_particle_transport_concentration" = "Dye concentration in lymph";
"health_atlas_lymph_particle_transport_flow" = "Model lymph flow";
"health_atlas_lymph_particle_transport_formula" = "Dye mass rate (µg/min) = concentration (µg/mL) × lymph flow (mL/min).";
"health_atlas_lymph_particle_transport_scope" = "Lymphatic endothelial cells line the capillaries where tissue fluid enters to become lymph. Lymph leaves a node through efferent vessels, and the thoracic duct usually returns lymph to the bloodstream where the left internal jugular and left subclavian veins meet. This model starts with imaginary dye already mixed evenly into a single steady stream, such as in a vessel leaving a node. No dye is added, lost, or stored along the segment, so the same dye mass enters and leaves each minute. At a fixed concentration, more lymph per minute carries more dye per minute. The values are made up and do not estimate dye entry into lymph, lymph node filtration, or actual lymph flow.";
"health_atlas_lymph_particle_transport_title" = "Dye carried by lymph";
"health_atlas_muscle_shortening_count" = "Sarcomere count in series";
"health_atlas_muscle_shortening_formula" = "ΔL = N × s / 1000\nL = N × (2.5 − s) / 1000\nN: number of sarcomeres in series; s: shortening per sarcomere (µm). Each sarcomere starts at a synthetic length of 2.5 µm. ΔL is segment shortening and L is remaining segment length, both in mm.";
"health_atlas_muscle_shortening_per_sarcomere" = "Shortening per sarcomere";
"health_atlas_muscle_shortening_remaining_length" = "Remaining segment length: %1$@ mm";
"health_atlas_muscle_shortening_scope" = "This demo assumes all sarcomeres in one straight myofibril segment shorten by the same amount. The inputs are synthetic, not measurements of any person or selected muscle. The model does not account for muscle architecture, whole-muscle or joint displacement, or force. It does not estimate exercise performance or predict patient outcomes.";
"health_atlas_muscle_shortening_title" = "Myofibril segment shortening";
"health_atlas_retinal_convergence_companion" = "Expected unlit sample count: %1$@";
"health_atlas_retinal_convergence_formula" = "Expected lit count = pooled sample count × (lit percentage ÷ 100). Each sample contributes 1 if lit and 0 otherwise. The expected lit and unlit counts add up to the pool size.";
"health_atlas_retinal_convergence_lit_percent" = "Simulated chance each sample is lit";
"health_atlas_retinal_convergence_samples" = "Pooled sample count";
"health_atlas_retinal_convergence_scope" = "In some retinal circuits, bipolar cells combine photoreceptor signals, and ganglion cells pool signals from multiple bipolar cells. This teaching example adds equally weighted binary samples into one pool. At the same nonzero lit chance, a larger pool has more lit samples on average. The expected count is a long-run average, so it can be fractional. The model omits ON/OFF signaling and center-surround interactions. The samples do not represent separate human receptive fields, and the output is neither a vision threshold nor a firing rate.";
"health_atlas_retinal_convergence_title" = "Expected lit sample count";
