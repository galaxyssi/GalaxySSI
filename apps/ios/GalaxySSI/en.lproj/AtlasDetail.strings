"health_atlas_aortic_arch" = "Aortic arch";
"health_atlas_aortic_arch_detail" = "The arch turns backward and toward the left side of the body. The three usual branches leave its upper curve in the order shown.";
"health_atlas_aortic_ascending" = "Ascending aorta";
"health_atlas_aortic_ascending_detail" = "Above the widened root, this segment rises from the sinotubular junction to the first arch branch, carrying oxygen-rich blood from the left ventricle.";
"health_atlas_aortic_brachiocephalic" = "Brachiocephalic trunk";
"health_atlas_aortic_brachiocephalic_detail" = "The first arch branch heads to the right and divides into the right common carotid and right subclavian arteries beyond this view.";
"health_atlas_aortic_descending" = "Descending aorta";
"health_atlas_aortic_descending_detail" = "Beyond the left subclavian origin, the arch turns down into the descending thoracic aorta behind the heart.";
"health_atlas_aortic_left_carotid" = "Left common carotid";
"health_atlas_aortic_left_carotid_detail" = "The second arch branch rises toward the left side of the neck and carries blood toward the head and neck.";
"health_atlas_aortic_left_subclavian" = "Left subclavian";
"health_atlas_aortic_left_subclavian_detail" = "The third arch branch turns toward the left shoulder and carries blood toward the left upper limb.";
"health_atlas_aortic_root_arch_selector" = "Aortic root and arch";
"health_atlas_aortic_root_arch_view" = "Aortic cutaway · Front view, body right at image left";
"health_atlas_aortic_root_sinus" = "Aortic sinus";
"health_atlas_aortic_root_sinus_detail" = "This pocket immediately above a valve cusp is one of the three aortic sinuses. The right and left coronary arteries begin in two of these sinuses.";
"health_atlas_aortic_root_valve" = "Aortic valve";
"health_atlas_aortic_root_valve_detail" = "The pale cusps mark the boundary between the left ventricular outflow and the aortic root. They open toward the aorta.";
"health_atlas_brainstem_section_aqueduct" = "Cerebral aqueduct";
"health_atlas_brainstem_section_aqueduct_detail" = "This narrow channel passes through the midbrain and carries cerebrospinal fluid from the third ventricle to the fourth.";
"health_atlas_brainstem_section_fourth_ventricle" = "Fourth ventricle";
"health_atlas_brainstem_section_fourth_ventricle_detail" = "This fluid-filled space lies between the cerebellum behind it and the pons and upper medulla in front of it.";
"health_atlas_brainstem_section_medulla" = "Medulla";
"health_atlas_brainstem_section_medulla_detail" = "The medulla lies below the pons and tapers into the spinal cord.";
"health_atlas_brainstem_section_midbrain" = "Midbrain";
"health_atlas_brainstem_section_midbrain_detail" = "The upper part of the brainstem surrounds the cerebral aqueduct and lies just above the pons.";
"health_atlas_brainstem_section_pons" = "Pons";
"health_atlas_brainstem_section_pons_detail" = "The middle part of the brainstem forms the rounded bulge at the front. Its back helps form the floor of the fourth ventricle.";
"health_atlas_brainstem_section_selector" = "Midline section";
"health_atlas_brainstem_section_view" = "Brainstem, midline section (front at left)";
"health_atlas_cerebellum_section_anterior_lobe" = "Anterior lobe";
"health_atlas_cerebellum_section_anterior_lobe_detail" = "In this midline view, the smaller anterior lobe lies above and in front of the primary fissure.";
"health_atlas_cerebellum_section_arbor_vitae" = "Arbor vitae";
"health_atlas_cerebellum_section_arbor_vitae_detail" = "Branches of white matter extend from the center into the folds, forming a tree-like pattern in this section.";
"health_atlas_cerebellum_section_folia" = "Folia";
"health_atlas_cerebellum_section_folia_detail" = "These narrow, leaf-like folds give the outer cerebellar cortex its ridged surface.";
"health_atlas_cerebellum_section_posterior_lobe" = "Posterior lobe";
"health_atlas_cerebellum_section_posterior_lobe_detail" = "The larger posterior lobe extends behind and below the primary fissure.";
"health_atlas_cerebellum_section_primary_fissure" = "Primary fissure";
"health_atlas_cerebellum_section_primary_fissure_detail" = "This deep groove separates the anterior and posterior lobes of the cerebellum.";
"health_atlas_cerebellum_section_selector" = "Vermis section";
"health_atlas_cerebellum_section_view" = "Cerebellum, midline section through the vermis (front at left)";
"health_atlas_coronary_circumflex" = "Circumflex artery";
"health_atlas_coronary_circumflex_detail" = "From the left main division, the circumflex follows the left atrioventricular groove between the left atrium and left ventricle, then wraps out of view.";
"health_atlas_coronary_lad" = "LAD";
"health_atlas_coronary_lad_detail" = "The left anterior descending artery runs toward the apex in the anterior interventricular groove, between the right and left ventricles.";
"health_atlas_coronary_left_main" = "Left main coronary";
"health_atlas_coronary_left_main_detail" = "The short stem starts at the left aortic sinus, passes between the pulmonary trunk and left atrial appendage, then divides into the LAD and circumflex. The overlying trunk is muted to expose the origin.";
"health_atlas_coronary_right_marginal" = "Right marginal branch";
"health_atlas_coronary_right_marginal_detail" = "This branch leaves the right coronary artery at the lower right border of the heart and runs toward the apex along the right ventricular surface.";
"health_atlas_coronary_right_route" = "Right coronary artery";
"health_atlas_coronary_right_route_detail" = "From the right aortic sinus, this red artery tracks between the right atrium and right ventricle in the right atrioventricular groove. The red routes carry oxygen-rich blood to the heart muscle.";
"health_atlas_coronary_routes_selector" = "Epicardial coronary routes";
"health_atlas_coronary_routes_view" = "Coronary surface cutaway · Front view, body right at image left";
"health_atlas_gallbladder_cutaway_body" = "Body";
"health_atlas_gallbladder_cutaway_body_detail" = "The broad middle of the gallbladder lies against the underside of the liver. Its cut surface exposes the lumen where bile is stored.";
"health_atlas_gallbladder_cutaway_caption" = "Gallbladder and extrahepatic bile ducts";
"health_atlas_gallbladder_cutaway_common" = "Common bile duct";
"health_atlas_gallbladder_cutaway_common_detail" = "Below the junction of the cystic and common hepatic ducts, this shared channel carries bile toward the duodenum.";
"health_atlas_gallbladder_cutaway_cystic" = "Cystic duct";
"health_atlas_gallbladder_cutaway_cystic_detail" = "Bile passes through this short duct both into and out of the gallbladder. The duct joins the common hepatic duct to form the common bile duct.";
"health_atlas_gallbladder_cutaway_fundus" = "Fundus";
"health_atlas_gallbladder_cutaway_fundus_detail" = "The rounded, blind end of the gallbladder projects below the lower edge of the liver.";
"health_atlas_gallbladder_cutaway_neck" = "Neck";
"health_atlas_gallbladder_cutaway_neck_detail" = "This tapered end of the gallbladder is continuous with the cystic duct.";
"health_atlas_gallbladder_cutaway_papilla" = "Major duodenal papilla";
"health_atlas_gallbladder_cutaway_papilla_detail" = "This small bump is on the inner wall of the descending duodenum. In the usual arrangement, bile enters the intestine here through an opening shared with the main pancreatic duct, which is not shown.";
"health_atlas_gallbladder_cutaway_selector" = "Bile duct route";
"health_atlas_hb_ampulla" = "Posterior ampulla";
"health_atlas_hb_ampulla_detail" = "This swelling of the posterior duct contains a sensory ridge capped by a gelatinous cupula. During head rotation, relative endolymph motion deflects the cupula.";
"health_atlas_hb_anterior_canal" = "Anterior canal";
"health_atlas_hb_anterior_canal_detail" = "This upward arch houses the anterior semicircular duct, one of the two steeply oriented ducts that sense head rotation. Its non-ampullary end joins the posterior duct in a shared branch.";
"health_atlas_hb_basilar" = "Basilar membrane";
"health_atlas_hb_basilar_detail" = "This membrane spans from the inner bony shelf to the outer wall. It supports the organ of Corti and separates the cochlear duct from the scala tympani below.";
"health_atlas_hb_cochlea_caption" = "Cochlea: simplified cross-section through one turn";
"health_atlas_hb_cochlea_selector" = "Cochlear cross-section";
"health_atlas_hb_cochlear_duct" = "Cochlear duct";
"health_atlas_hb_cochlear_duct_detail" = "Also called the scala media, this wedge-shaped chamber contains endolymph. Its roof slopes toward the outer wall, and the organ of Corti sits on its floor.";
"health_atlas_hb_corti" = "Organ of Corti";
"health_atlas_hb_corti_detail" = "The hearing sensory epithelium sits inside the cochlear duct on the basilar membrane. Its hair cells lie beneath the tectorial membrane.";
"health_atlas_hb_eardrum" = "Eardrum";
"health_atlas_hb_eardrum_detail" = "The tympanic membrane separates the ear canal from the air-filled middle ear. The malleus handle attaches to it at the umbo, the deepest point of the membrane.";
"health_atlas_hb_incus" = "Incus";
"health_atlas_hb_incus_detail" = "The body of the incus meets the malleus high in the middle ear. Its long process descends to a small joint with the head of the stapes.";
"health_atlas_hb_lateral_canal" = "Lateral canal";
"health_atlas_hb_lateral_canal_detail" = "The lateral canal houses the more nearly horizontal semicircular duct. Both ends open into the utricle separately from the shared branch of the other two ducts.";
"health_atlas_hb_malleus" = "Malleus";
"health_atlas_hb_malleus_detail" = "The head of the malleus meets the incus above the eardrum. Its handle extends down along the inner side of the eardrum to the umbo.";
"health_atlas_hb_middle_ear_caption" = "Middle ear: oblique cutaway from eardrum to oval window";
"health_atlas_hb_middle_ear_selector" = "Ossicular chain";
"health_atlas_hb_oval_window" = "Oval window";
"health_atlas_hb_oval_window_detail" = "The oval window opens into the inner-ear vestibule. A flexible ring seals the stapes footplate to its rim while allowing the footplate to move.";
"health_atlas_hb_posterior_canal" = "Posterior canal";
"health_atlas_hb_posterior_canal_detail" = "The posterior semicircular duct runs in a different steep plane from the anterior duct. One end widens into an ampulla and the other joins the shared branch.";
"health_atlas_hb_reissners" = "Reissner’s membrane";
"health_atlas_hb_reissners_detail" = "This thin, sloping membrane forms the roof of the cochlear duct. It separates the duct’s endolymph from the perilymph of the scala vestibuli.";
"health_atlas_hb_round_window" = "Round window";
"health_atlas_hb_round_window_detail" = "A flexible membrane covers this opening below the oval window, at the basal end of the scala tympani. It can move as the stapes displaces inner-ear fluid.";
"health_atlas_hb_saccule" = "Saccule";
"health_atlas_hb_saccule_detail" = "The smaller sac sits below the utricle. Its sensory patch is more nearly vertical and also carries otoconia; it is especially sensitive to vertical linear acceleration.";
"health_atlas_hb_scala_tympani" = "Scala tympani";
"health_atlas_hb_scala_tympani_detail" = "This perilymph-filled chamber lies below the cochlear partition. At the base it ends at the round window; at the tip of the coil it joins the scala vestibuli.";
"health_atlas_hb_scala_vestibuli" = "Scala vestibuli";
"health_atlas_hb_scala_vestibuli_detail" = "This perilymph-filled chamber lies above the cochlear duct, separated from it by Reissner’s membrane. Toward the base it opens into the vestibule.";
"health_atlas_hb_stapes" = "Stapes";
"health_atlas_hb_stapes_detail" = "Two slender branches give the stapes its stirrup shape. They join the head, which touches the incus, to the footplate seated in the oval window.";
"health_atlas_hb_utricle" = "Utricle";
"health_atlas_hb_utricle_detail" = "The flattened upper sac receives the semicircular ducts. Crystals called otoconia overlie its mostly horizontal sensory patch, which responds to linear acceleration and tilt relative to gravity.";
"health_atlas_hb_vestibular_caption" = "Vestibular labyrinth: semicircular canals and otolith organs";
"health_atlas_hb_vestibular_selector" = "Canals and otolith organs";
"health_atlas_hide_labels" = "Hide labels";
"health_atlas_humerus_landmarks_capitulum" = "Capitulum";
"health_atlas_humerus_landmarks_capitulum_detail" = "This round joint surface on the outer side of the lower humerus meets the head of the radius.";
"health_atlas_humerus_landmarks_caption" = "Right humerus, anterior view";
"health_atlas_humerus_landmarks_deltoid" = "Deltoid tuberosity";
"health_atlas_humerus_landmarks_deltoid_detail" = "The deltoid muscle attaches to this rough patch on the outer side of the shaft.";
"health_atlas_humerus_landmarks_greater_tubercle" = "Greater tubercle";
"health_atlas_humerus_landmarks_greater_tubercle_detail" = "This bump lies on the outer side of the upper humerus. Three rotator cuff tendons attach here.";
"health_atlas_humerus_landmarks_head" = "Humeral head";
"health_atlas_humerus_landmarks_head_detail" = "The rounded upper end faces inward and meets the glenoid cavity of the scapula.";
"health_atlas_humerus_landmarks_selector" = "Anterior landmarks";
"health_atlas_humerus_landmarks_shaft" = "Shaft";
"health_atlas_humerus_landmarks_shaft_detail" = "This long central portion connects the rounded shoulder end to the widened elbow end.";
"health_atlas_humerus_landmarks_trochlea" = "Trochlea";
"health_atlas_humerus_landmarks_trochlea_detail" = "This pulley-shaped surface lies on the inner side of the lower humerus and meets the ulna.";
"health_atlas_larynx_inlet_plate_caption" = "Larynx cutaway, looking down from above. The front of the larynx is at the top.";
"health_atlas_larynx_inlet_plate_epiglottis" = "Epiglottis";
"health_atlas_larynx_inlet_plate_epiglottis_detail" = "This leaf-shaped flap of elastic cartilage forms the front edge of the laryngeal inlet, above the folds. It tips back over the inlet during swallowing.";
"health_atlas_larynx_inlet_plate_glottic_opening" = "Glottic opening";
"health_atlas_larynx_inlet_plate_glottic_opening_detail" = "This gap lies between the inner edges of the true vocal folds. It is wider toward the back in this view of the open airway.";
"health_atlas_larynx_inlet_plate_selector" = "Laryngeal inlet";
"health_atlas_larynx_inlet_plate_vestibular_folds" = "Vestibular folds";
"health_atlas_larynx_inlet_plate_vestibular_folds_detail" = "These paired pink ridges sit above and farther out than the paler true vocal folds. They are also called false vocal folds.";
"health_atlas_larynx_inlet_plate_vocal_folds" = "True vocal folds";
"health_atlas_larynx_inlet_plate_vocal_folds_detail" = "These pale folds sit below the vestibular folds. Their free inner edges border the glottic opening and vibrate to produce voice.";
"health_atlas_locator_view" = "Locator";
"health_atlas_main_bronchi_plate_caption" = "Front view of the main bronchial split. The right side of the body is on the left of the image.";
"health_atlas_main_bronchi_plate_carina" = "Carina";
"health_atlas_main_bronchi_plate_carina_detail" = "This raised ridge inside the lower trachea separates the openings of the right and left main bronchi.";
"health_atlas_main_bronchi_plate_distal_trachea" = "Lower trachea";
"health_atlas_main_bronchi_plate_distal_trachea_detail" = "Above the carina, the lower trachea is a single air passage. It continues into both main bronchi at the split.";
"health_atlas_main_bronchi_plate_left" = "Left main bronchus";
"health_atlas_main_bronchi_plate_left_detail" = "This branch on the right of the image leads to the left lung. It is typically narrower, longer, and more oblique than the right main bronchus.";
"health_atlas_main_bronchi_plate_right" = "Right main bronchus";
"health_atlas_main_bronchi_plate_right_detail" = "This branch on the left of the image leads to the right lung. It is typically wider, shorter, and more vertical than the left main bronchus.";
"health_atlas_main_bronchi_plate_selector" = "Main bronchial split";
"health_atlas_optics_cornea_aqueous" = "Aqueous humor";
"health_atlas_optics_cornea_aqueous_detail" = "Fluid in the anterior chamber contacts the inner surface of the cornea.";
"health_atlas_optics_cornea_bowman" = "Bowman layer";
"health_atlas_optics_cornea_bowman_detail" = "A thin, dense layer lies between the epithelium and the main stroma.";
"health_atlas_optics_cornea_descemet" = "Descemet membrane";
"health_atlas_optics_cornea_descemet_detail" = "The basement membrane of the endothelium lies at the back of the stroma.";
"health_atlas_optics_cornea_detail" = "Layers of the cornea";
"health_atlas_optics_cornea_endothelium" = "Endothelium";
"health_atlas_optics_cornea_endothelium_detail" = "A single layer of cells faces the aqueous humor and helps regulate fluid in the cornea.";
"health_atlas_optics_cornea_epithelium" = "Epithelium";
"health_atlas_optics_cornea_epithelium_detail" = "Several layers of epithelial cells cover the front of the cornea, beneath the tear film.";
"health_atlas_optics_cornea_stroma" = "Stroma";
"health_atlas_optics_cornea_stroma_detail" = "Organized collagen sheets make up most of the thickness. Layer thickness in this drawing is exaggerated for clarity.";
"health_atlas_optics_cornea_tear" = "Tear film";
"health_atlas_optics_cornea_tear_detail" = "The thin liquid film covers the exposed surface and helps smooth the first optical interface.";
"health_atlas_optics_lens_capsule" = "Lens capsule";
"health_atlas_optics_lens_capsule_detail" = "A clear capsule envelopes the lens and provides a surface for zonular attachments.";
"health_atlas_optics_lens_ciliary" = "Ciliary processes";
"health_atlas_optics_lens_ciliary_detail" = "The diagram shows projections of the ciliary body and their position beside the lens equator.";
"health_atlas_optics_lens_cortex" = "Lens cortex";
"health_atlas_optics_lens_cortex_detail" = "Outer fiber layers surround the central nucleus.";
"health_atlas_optics_lens_detail" = "Lens fibers and zonules";
"health_atlas_optics_lens_epithelium" = "Anterior epithelium";
"health_atlas_optics_lens_epithelium_detail" = "The epithelial layer is on the anterior side just inside the capsule. It is not continuous across the back surface.";
"health_atlas_optics_lens_nucleus" = "Lens nucleus";
"health_atlas_optics_lens_nucleus_detail" = "The central region contains older lens fibers. It is not a cellular nucleus.";
"health_atlas_optics_lens_zonules" = "Zonular fibers";
"health_atlas_optics_lens_zonules_detail" = "Suspensory fibers between the ciliary body and lens capsule transmit tension to the lens.";
"health_atlas_outflow_bladder_detrusor" = "Detrusor";
"health_atlas_outflow_bladder_detrusor_detail" = "Interwoven bundles of smooth muscle form this thick layer outside the lining and its supporting tissue. They contract to empty the bladder.";
"health_atlas_outflow_bladder_folds" = "Mucosal folds";
"health_atlas_outflow_bladder_folds_detail" = "The lining outside the trigone can form ridges when the bladder is relatively empty. The ridges flatten as the wall stretches during filling.";
"health_atlas_outflow_bladder_outlet" = "Bladder outlet";
"health_atlas_outflow_bladder_outlet_detail" = "The internal urethral opening is the lower point of the trigone. At this point the bladder neck opens into the urethra.";
"health_atlas_outflow_bladder_selector" = "Wall and trigone";
"health_atlas_outflow_bladder_trigone" = "Trigone";
"health_atlas_outflow_bladder_trigone_detail" = "This smooth triangular area at the bladder base lies between the two ureteric openings and the internal opening of the urethra.";
"health_atlas_outflow_bladder_ureteric_orifice" = "Ureteric opening";
"health_atlas_outflow_bladder_ureteric_orifice_detail" = "Each ureter empties into the bladder through its own opening. The two openings form the upper corners of the trigone.";
"health_atlas_outflow_bladder_urothelium" = "Urothelium";
"health_atlas_outflow_bladder_urothelium_detail" = "This urine-facing epithelium lines the bladder. It stretches during filling while maintaining a barrier between urine and the underlying tissue.";
"health_atlas_outflow_bladder_view" = "Bladder wall and trigone cutaway";
"health_atlas_outflow_ureter_iliac_crossing" = "Iliac crossing";
"health_atlas_outflow_ureter_iliac_crossing_detail" = "The ureter passes in front of the iliac vessels near the common iliac artery bifurcation as it crosses the pelvic brim.";
"health_atlas_outflow_ureter_intramural" = "Intramural ureter";
"health_atlas_outflow_ureter_intramural_detail" = "The terminal ureter runs at a slant through the bladder wall before it opens inside. Bladder wall pressure can flatten this tunnel and limit backward flow.";
"health_atlas_outflow_ureter_lumen" = "Folded lumen";
"health_atlas_outflow_ureter_lumen_detail" = "Urine travels through this central space. In cross-section, folds of the relaxed mucosa can give the lumen a star-like shape.";
"health_atlas_outflow_ureter_muscle" = "Smooth muscle";
"health_atlas_outflow_ureter_muscle_detail" = "Smooth muscle surrounds the mucosa and its supporting connective tissue. Waves of contraction propel urine toward the bladder.";
"health_atlas_outflow_ureter_pelvis_junction" = "Renal pelvis junction";
"health_atlas_outflow_ureter_pelvis_junction_detail" = "The funnel of the renal pelvis narrows into the ureter at the kidney hilum. The ureter then descends behind the peritoneum.";
"health_atlas_outflow_ureter_selector" = "Course and wall";
"health_atlas_outflow_ureter_urothelium" = "Urothelium";
"health_atlas_outflow_ureter_urothelium_detail" = "This innermost lining follows the folds around the lumen and forms a barrier between urine and the tissues of the ureter wall.";
"health_atlas_outflow_ureter_view" = "Ureter course and wall cross-section";
"health_atlas_outflow_urethra_external" = "External opening";
"health_atlas_outflow_urethra_external_detail" = "The female urethra opens into the vestibule, in front of and separate from the vaginal opening.";
"health_atlas_outflow_urethra_internal" = "Internal opening";
"health_atlas_outflow_urethra_internal_detail" = "The female urethra begins at this opening in the bladder neck, where the bladder cavity narrows into the urinary channel.";
"health_atlas_outflow_urethra_lumen" = "Urethral lumen";
"health_atlas_outflow_urethra_lumen_detail" = "This passage inside the urethra carries urine from the bladder neck to the external opening. It is separate from the vaginal canal.";
"health_atlas_outflow_urethra_selector" = "Channel (female anatomy)";
"health_atlas_outflow_urethra_sphincter" = "External sphincter";
"health_atlas_outflow_urethra_sphincter_detail" = "Striated muscle around the middle portion of the urethra helps close the urinary channel and contributes to voluntary control of urine flow.";
"health_atlas_outflow_urethra_vaginal_wall" = "Anterior vaginal wall";
"health_atlas_outflow_urethra_vaginal_wall_detail" = "This wall lies just behind the female urethra and helps support it. The urinary and vaginal passages do not connect.";
"health_atlas_outflow_urethra_view" = "Urinary channel (female sagittal cutaway)";
"health_atlas_parotid_cutaway_caption" = "Parotid gland and cheek duct";
"health_atlas_parotid_cutaway_duct" = "Stensen duct";
"health_atlas_parotid_cutaway_duct_detail" = "The main parotid duct leaves the front of the gland and runs forward across the outer surface of the masseter, a chewing muscle.";
"health_atlas_parotid_cutaway_gland" = "Parotid gland";
"health_atlas_parotid_cutaway_gland_detail" = "One of the paired parotid glands is shown in front of and below the ear, over the back of the lower jaw.";
"health_atlas_parotid_cutaway_papilla" = "Parotid papilla";
"health_atlas_parotid_cutaway_papilla_detail" = "Stensen duct opens at this small bump on the inner cheek, opposite the second upper molar. The opening is in the cheek, not on the gum.";
"health_atlas_parotid_cutaway_selector" = "Cheek duct route";
"health_atlas_parotid_cutaway_turn" = "Turn into the cheek";
"health_atlas_parotid_cutaway_turn_detail" = "At the front edge of the masseter, the duct turns inward and passes through the buccinator, the muscle of the cheek.";
"health_atlas_pulmonary_bifurcation_selector" = "Pulmonary trunk bifurcation";
"health_atlas_pulmonary_bifurcation_view" = "Pulmonary outflow cutaway · Front view, body right at image left";
"health_atlas_pulmonary_branch_point" = "Bifurcation";
"health_atlas_pulmonary_branch_point_detail" = "Just beneath the aortic arch, the pulmonary trunk splits into the right and left pulmonary arteries, one to each lung.";
"health_atlas_pulmonary_left_branch" = "Left pulmonary artery";
"health_atlas_pulmonary_left_branch_detail" = "The shorter branch passes in front of the descending aorta and above the left main bronchus on its way to the left lung.";
"health_atlas_pulmonary_main_trunk" = "Pulmonary trunk";
"health_atlas_pulmonary_main_trunk_detail" = "This short blue vessel rises from the right ventricle, in front of and then to the left of the ascending aorta. Blue denotes oxygen-poor blood headed to the lungs.";
"health_atlas_pulmonary_right_branch" = "Right pulmonary artery";
"health_atlas_pulmonary_right_branch_detail" = "The longer branch runs toward the right lung behind the ascending aorta. The muted red aorta is partly transparent to reveal that crossing.";
"health_atlas_pulmonary_trunk_valve" = "Pulmonary valve";
"health_atlas_pulmonary_trunk_valve_detail" = "The pale cusps sit between the right ventricular outflow and the base of the pulmonary trunk. They open toward the trunk.";
"health_atlas_renal_cortex_capsule" = "Fibrous capsule";
"health_atlas_renal_cortex_capsule_detail" = "This thin coat of dense connective tissue covers the outer surface of the renal cortex.";
"health_atlas_renal_cortex_corpuscle" = "Renal corpuscle";
"health_atlas_renal_cortex_corpuscle_detail" = "The rounded corpuscle contains a tuft of capillaries, the glomerulus, within Bowman's capsule. Corpuscles lie in the cortical labyrinth, not in the straight rays.";
"health_atlas_renal_cortex_cutaway_selector" = "Cortex cutaway";
"health_atlas_renal_cortex_cutaway_view" = "Renal cortex in section";
"health_atlas_renal_cortex_labyrinth" = "Cortical labyrinth";
"health_atlas_renal_cortex_labyrinth_detail" = "The tissue between the straight rays contains coiled proximal and distal tubules, with rounded renal corpuscles scattered among them.";
"health_atlas_renal_cortex_ray" = "Medullary ray";
"health_atlas_renal_cortex_ray_detail" = "Despite its name, this bundle lies in the cortex. Straight segments of nephron tubules and collecting ducts run together here toward or away from the medulla.";
"health_atlas_renal_medulla_column" = "Renal column";
"health_atlas_renal_medulla_column_detail" = "This inward extension of cortical tissue lies between adjacent medullary pyramids.";
"health_atlas_renal_medulla_cutaway_selector" = "Pyramid cutaway";
"health_atlas_renal_medulla_cutaway_view" = "Renal pyramid in section";
"health_atlas_renal_medulla_ducts" = "Collecting ducts";
"health_atlas_renal_medulla_ducts_detail" = "Collecting ducts run lengthwise and join into larger ducts deeper in the pyramid. The terminal ducts open at the papillary tip.";
"health_atlas_renal_medulla_papilla" = "Renal papilla";
"health_atlas_renal_medulla_papilla_detail" = "The rounded tip of the pyramid projects into a minor calyx, a cup that receives urine from the openings of the papillary ducts.";
"health_atlas_renal_medulla_pyramid_base" = "Pyramid base";
"health_atlas_renal_medulla_pyramid_base_detail" = "The broad end of the medullary pyramid meets the cortex. The pyramid narrows inward toward its papilla.";
"health_atlas_renal_pelvis_cutaway_selector" = "Pelvis cutaway";
"health_atlas_renal_pelvis_cutaway_view" = "Calyces and renal pelvis in section";
"health_atlas_renal_pelvis_funnel" = "Pelvic funnel";
"health_atlas_renal_pelvis_funnel_detail" = "Major calyces join in this broad cavity. It narrows at the kidney hilum to continue as the ureter.";
"health_atlas_renal_pelvis_major_calyx" = "Major calyx";
"health_atlas_renal_pelvis_major_calyx_detail" = "The two smaller cups shown above join into this wider branch, which opens into the renal pelvis.";
"health_atlas_renal_pelvis_minor_calyx" = "Minor calyx";
"health_atlas_renal_pelvis_minor_calyx_detail" = "This cup surrounds the projecting tip of a renal papilla. Its narrow neck opens into a larger calyx.";
"health_atlas_scapula_landmarks_acromion" = "Acromion";
"health_atlas_scapula_landmarks_acromion_detail" = "This broad outer extension of the scapular spine forms the bony tip of the shoulder and meets the clavicle.";
"health_atlas_scapula_landmarks_caption" = "Right scapula, posterior oblique view";
"health_atlas_scapula_landmarks_glenoid" = "Glenoid cavity";
"health_atlas_scapula_landmarks_glenoid_detail" = "This shallow socket at the outer corner meets the head of the humerus to form the shoulder joint.";
"health_atlas_scapula_landmarks_inferior_angle" = "Inferior angle";
"health_atlas_scapula_landmarks_inferior_angle_detail" = "The lowest point of the shoulder blade is where its inner and outer borders meet.";
"health_atlas_scapula_landmarks_infraspinous" = "Infraspinous fossa";
"health_atlas_scapula_landmarks_infraspinous_detail" = "This broad hollow below the scapular spine is where the infraspinatus muscle begins.";
"health_atlas_scapula_landmarks_selector" = "Posterior landmarks";
"health_atlas_scapula_landmarks_spine" = "Scapular spine";
"health_atlas_scapula_landmarks_spine_detail" = "This raised ridge crosses the back of the blade, separating the two hollows and widening into the acromion.";
"health_atlas_scapula_landmarks_supraspinous" = "Supraspinous fossa";
"health_atlas_scapula_landmarks_supraspinous_detail" = "This narrow hollow above the scapular spine is where the supraspinatus muscle begins.";
"health_atlas_show_labels" = "Show labels";
"health_atlas_spinal_cord_section_anterior_fissure" = "Anterior median fissure";
"health_atlas_spinal_cord_section_anterior_fissure_detail" = "This deep cleft runs along the midline at the front of the spinal cord.";
"health_atlas_spinal_cord_section_central_canal" = "Central canal";
"health_atlas_spinal_cord_section_central_canal_detail" = "This tiny channel lies in the bridge of gray matter connecting the two halves of the cord.";
"health_atlas_spinal_cord_section_dorsal_horn" = "Dorsal horn";
"health_atlas_spinal_cord_section_dorsal_horn_detail" = "The slender rear projection of gray matter receives and processes incoming sensory information.";
"health_atlas_spinal_cord_section_posterior_sulcus" = "Posterior median sulcus";
"health_atlas_spinal_cord_section_posterior_sulcus_detail" = "This shallow groove marks the middle of the back of the spinal cord. The anterior median fissure on the opposite side is deeper.";
"health_atlas_spinal_cord_section_selector" = "Transverse section";
"health_atlas_spinal_cord_section_ventral_horn" = "Ventral horn";
"health_atlas_spinal_cord_section_ventral_horn_detail" = "The broader front projection of gray matter contains motor neurons whose axons reach skeletal muscle.";
"health_atlas_spinal_cord_section_view" = "Spinal cord, transverse section (back at top)";
"health_atlas_spinal_cord_section_white_matter" = "White matter";
"health_atlas_spinal_cord_section_white_matter_detail" = "White matter surrounds the butterfly-shaped gray matter and contains bundles of nerve fibers that travel along the cord.";
"health_atlas_submandibular_cutaway_caption" = "Submandibular gland and floor of the mouth";
"health_atlas_submandibular_cutaway_caruncle" = "Sublingual caruncle";
"health_atlas_submandibular_cutaway_caruncle_detail" = "Despite its name, this small bump beside the tongue frenulum is where the main submandibular duct opens. The matching opening on the other side is not shown.";
"health_atlas_submandibular_cutaway_deep" = "Deep part";
"health_atlas_submandibular_cutaway_deep_detail" = "The same gland wraps around the free back edge of the mylohyoid. Its smaller deep part sits above the muscle and gives rise to Wharton duct.";
"health_atlas_submandibular_cutaway_duct" = "Wharton duct";
"health_atlas_submandibular_cutaway_duct_detail" = "The main duct of the submandibular gland runs forward along the tongue side of the neighboring sublingual gland to the front of the mouth floor.";
"health_atlas_submandibular_cutaway_mylohyoid" = "Mylohyoid";
"health_atlas_submandibular_cutaway_mylohyoid_detail" = "This muscular sheet forms the floor of the mouth. The superficial part lies below it; the deep part and the neighboring sublingual gland lie above it.";
"health_atlas_submandibular_cutaway_neighbor" = "Sublingual gland";
"health_atlas_submandibular_cutaway_neighbor_detail" = "This is a separate gland just under the mouth floor, not the deep part of the submandibular gland. Its small ducts of Rivinus open along the raised sublingual fold.";
"health_atlas_submandibular_cutaway_selector" = "Mouth floor route";
"health_atlas_submandibular_cutaway_superficial" = "Superficial part";
"health_atlas_submandibular_cutaway_superficial_detail" = "Most of the submandibular gland lies beneath the lower jaw and below the mylohyoid, the muscle that supports the floor of the mouth.";
"health_atlas_tibia_landmarks_anterior_border" = "Anterior border";
"health_atlas_tibia_landmarks_anterior_border_detail" = "This ridge runs down from the tibial tuberosity and forms the front edge of the shin.";
"health_atlas_tibia_landmarks_caption" = "Right tibia, oblique front view";
"health_atlas_tibia_landmarks_fibular_notch" = "Fibular notch";
"health_atlas_tibia_landmarks_fibular_notch_detail" = "This shallow groove on the outer side of the lower tibia receives the lower end of the fibula.";
"health_atlas_tibia_landmarks_lateral_condyle" = "Lateral condyle";
"health_atlas_tibia_landmarks_lateral_condyle_detail" = "This is the outer half of the widened upper tibia. Its top surface meets the outer condyle of the femur at the knee.";
"health_atlas_tibia_landmarks_malleolus" = "Medial malleolus";
"health_atlas_tibia_landmarks_malleolus_detail" = "This downward projection forms the inner ankle bump. Its inner joint surface meets the talus.";
"health_atlas_tibia_landmarks_medial_condyle" = "Medial condyle";
"health_atlas_tibia_landmarks_medial_condyle_detail" = "This is the inner half of the widened upper tibia. Its top surface meets the inner condyle of the femur at the knee.";
"health_atlas_tibia_landmarks_selector" = "Anterior landmarks";
"health_atlas_tibia_landmarks_tuberosity" = "Tibial tuberosity";
"health_atlas_tibia_landmarks_tuberosity_detail" = "The patellar ligament attaches to this raised area on the front of the upper tibia, below the knee.";
"health_atlas_trachea_ring_plate_caption" = "Tracheal wall cutaway. The back wall is at the top of the exposed cross-section.";
"health_atlas_trachea_ring_plate_cartilage" = "C-shaped cartilage";
"health_atlas_trachea_ring_plate_cartilage_detail" = "Stacked rings of hyaline cartilage support the front and sides of the trachea. Each ring is open at the back.";
"health_atlas_trachea_ring_plate_lining" = "Inner lining";
"health_atlas_trachea_ring_plate_lining_detail" = "The exposed mucosa lines the air passage on the inside of the supporting cartilage. Microscopic cilia on its surface move mucus toward the throat.";
"health_atlas_trachea_ring_plate_lumen" = "Tracheal lumen";
"health_atlas_trachea_ring_plate_lumen_detail" = "This is the hollow air passage inside the trachea. The ring curves around its front and sides; the flexible back wall completes its boundary.";
"health_atlas_trachea_ring_plate_posterior_wall" = "Back wall";
"health_atlas_trachea_ring_plate_posterior_wall_detail" = "This flexible back wall bridges the open ends of the cartilage rings. It contains the trachealis smooth muscle and faces the esophagus.";
"health_atlas_trachea_ring_plate_selector" = "Tracheal rings";
