"health_atlas_cranial_attach_border" = "VI–VIII · Pons border";
"health_atlas_cranial_attach_border_detail" = "At the pons–medulla border, abducens (VI) is near the midline; facial (VII) and vestibulocochlear (VIII) attach farther to the side.";
"health_atlas_cranial_attach_lower" = "IX and X · Medulla";
