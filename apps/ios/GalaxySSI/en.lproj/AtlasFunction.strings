"health_atlas_endometrium_story_repair_caption" = "Epithelial cells from surviving gland openings and nearby intact lining spread across exposed areas. They restore the surface lining over the stroma before the functional layer has regained its thickness.";
"health_atlas_endometrium_story_scope" = "A simplified cross-section of the uterine lining during a normal menstrual cycle. Shapes and motion are not to scale. Chapters show representative changes, not their timing; shedding and repair can overlap. For anatomy education, not for predicting fertility or individual cycles.";
"health_atlas_endometrium_story_secretion" = "Glands in the secretory phase";
"health_atlas_endometrium_story_secretion_caption" = "In the secretory phase, progesterone helps change how the glands and stroma behave. Glands become more winding, and glandular epithelial cells release secretions into the gland spaces. Some stromal cells in the surrounding tissue become rounder.";
"health_atlas_endometrium_story_shedding" = "Shedding during menstruation";
"health_atlas_endometrium_story_shedding_caption" = "As progesterone falls, patches of the functional layer break down and shed into the uterine cavity with blood. The basal layer and the deep portions of glands remain. Some exposed areas can already begin to repair.";
"health_atlas_endometrium_story_title" = "Endometrial renewal";
"health_atlas_endothelium_boundary" = "A lining between blood and tissue";
"health_atlas_endothelium_boundary_caption" = "A thin layer of endothelial cells lines the capillary. It forms a selective boundary between the lumen, where blood flows, and the interstitium, the space around tissue cells.";
