"health_atlas_pleura_story_expand_caption" = "During quiet inhalation, the ribs lift and move outward as the diaphragm contracts, flattens and descends. The parietal pleura moves with these surfaces.";
"health_atlas_pleura_story_fluid" = "Thin fluid film";
"health_atlas_pleura_story_follow" = "The lungs follow";
