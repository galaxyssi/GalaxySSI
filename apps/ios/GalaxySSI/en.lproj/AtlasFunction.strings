"health_atlas_cranial_attach_pons" = "V · Trigeminal";
"health_atlas_cranial_attach_pons_detail" = "The main trigeminal root is attached along the lateral pons. It carries much of the sensation of the face and contributes to chewing movements.";
"health_atlas_cranial_attach_tongue" = "XII · Hypoglossal";
"health_atlas_cranial_attach_tongue_detail" = "Hypoglossal rootlets emerge from a groove closer to the midline of the medulla. The nerve supplies most tongue muscles.";
"health_atlas_cranial_attach_two" = "II · Optic";
