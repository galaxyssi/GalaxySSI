"health_atlas_airway_ciliary_clearance_advance" = "Marker advance per cycle";
"health_atlas_airway_ciliary_clearance_cycles" = "Demo beat cycles";
"health_atlas_airway_ciliary_clearance_diagram" = "A gold marker shows the distance travelled along the model mucus layer above the blue-green cilia.";
"health_atlas_airway_ciliary_clearance_formula" = "Marker travel (u) = beat cycles × advance per cycle (u/cycle). Here u is a fictional distance unit; the demo track is 60 u long.";
"health_atlas_airway_ciliary_clearance_progress" = "Demo track covered: %1$@%%";
"health_atlas_airway_ciliary_clearance_scope" = "Coordinated beats of motile cilia move mucus along the ciliated respiratory lining. In the nasal cavity, they sweep mucus toward the throat; in the paranasal sinuses, they move it toward the natural openings into the nasal cavity. This example concerns only ciliated respiratory lining, not the outer nose or other nasal linings. A fictional marker advances by the same chosen distance each cycle. The values do not measure or predict real mucus transport.";
"health_atlas_airway_ciliary_clearance_title" = "Airway ciliary clearance";
"health_atlas_airway_ciliary_clearance_track" = "Cilia and marker track";
"health_atlas_bile_storage_companion" = "Marker amount unchanged: %1$@ TU";
"health_atlas_bile_storage_formula" = "Remaining liquid volume = 12 VU − water removed. Marker concentration = marker amount ÷ remaining liquid volume. With no marker lost, halving the liquid volume doubles the concentration.";
"health_atlas_bile_storage_marker_amount" = "Marker amount";
"health_atlas_bile_storage_scope" = "The liver makes bile. Between meals, the gallbladder stores bile, and its lining absorbs water and some salts, concentrating the bile. In this teaching model, an imaginary reservoir starts with 12 VU of liquid. Only water leaves, and the evenly mixed marker stays in the reservoir. TU and VU are imaginary units of marker amount and volume. The model does not simulate bile flow or predict actual bile concentrations.";
"health_atlas_bile_storage_title" = "Concentration during bile storage";
"health_atlas_bile_storage_water_removed" = "Water removed";
"health_atlas_bladder_expansion_added" = "Added model volume";
"health_atlas_bladder_expansion_area" = "Final model surface area: %1$@ cm²";
"health_atlas_bladder_expansion_before" = "Start";
"health_atlas_bladder_expansion_caption" = "Starting volume and filling cross-section";
"health_atlas_bladder_expansion_current" = "Filling";
"health_atlas_bladder_expansion_description" = "Model cross-sections. Start: %1$@ mL. Selected finish: %2$@ mL.";
"health_atlas_bladder_expansion_formula" = "Surface area increase = 100 × [(final volume ÷ starting volume)^(2/3) − 1].";
"health_atlas_bladder_expansion_initial" = "Starting model volume";
"health_atlas_bladder_expansion_pause" = "Pause bladder filling";
"health_atlas_bladder_expansion_play" = "Play bladder filling";
"health_atlas_bladder_expansion_scope" = "The bladder wall and its lining accommodate filling. This example uses a sphere to relate volume to surface area. It does not estimate bladder capacity, pressure, or the stretch of individual cells.";
"health_atlas_bladder_expansion_title" = "Bladder filling: surface area increase";
"health_atlas_bone_remodeling_balance_companion" = "Final matrix amount: %1$@ a.u.";
"health_atlas_bone_remodeling_balance_formed" = "Matrix formed";
"health_atlas_bone_remodeling_balance_formula" = "Net matrix change = matrix formed - matrix resorbed. Final matrix amount = 100 a.u. + net matrix change. A net change of zero means formation matches resorption.";
"health_atlas_bone_remodeling_balance_resorbed" = "Matrix resorbed";
"health_atlas_bone_remodeling_balance_scope" = "Osteocytes help coordinate remodeling by signaling. Osteoclasts resorb old matrix, and osteoblasts then lay down new matrix. This model only tallies amounts for one patch of bone, without simulating timing or signaling. The values are synthetic, in arbitrary units (a.u.), and do not estimate changes in real bone.";
"health_atlas_bone_remodeling_balance_title" = "Net bone matrix change";
"health_atlas_cutaneous_sebum_area" = "Coated area";
"health_atlas_cutaneous_sebum_companion" = "Total sebum in the coating: %1$@ µg";
"health_atlas_cutaneous_sebum_formula" = "Average surface density = sebum mass ÷ coated area. At fixed mass, doubling the area halves the average density. At fixed area, doubling the mass doubles the average density.";
"health_atlas_cutaneous_sebum_mass" = "Sebum mass";
"health_atlas_cutaneous_sebum_scope" = "Sebocytes in sebaceous glands produce sebum, which typically reaches the skin surface through hair follicles. This model assumes a uniform coating on a patch of skin with no sebum lost. The mass and area are illustrative, not measurements. The model does not describe actual surface distribution or predict individual secretion rates.";
"health_atlas_cutaneous_sebum_title" = "Average sebum surface density";
"health_atlas_gastric_liquid_emptying_companion" = "Marker emptied: %1$@%% of the starting amount";
"health_atlas_gastric_liquid_emptying_formula" = "Let f be the selected removal percentage divided by 100. Each interval removes f times the marker then present, leaving a fraction (1 − f). After n intervals, the percent of the starting marker remaining is 100 × (1 − f)^n. Percent emptied is 100 minus percent remaining.";
"health_atlas_gastric_liquid_emptying_intervals" = "Number of model intervals";
"health_atlas_gastric_liquid_emptying_removal" = "Removed per model interval";
"health_atlas_gastric_liquid_emptying_scope" = "The stomach releases liquid contents through the pylorus into the duodenum. Real emptying is regulated and can vary with the energy density of the liquid. This model tracks a fictional marker in one perfectly mixed compartment. No marker is added, absorbed, or broken down; it only leaves with the outflow. The removal percentage is invented, and intervals have no physical duration. For teaching only: this does not predict digestion or personal gastric emptying and is not for clinical use.";
"health_atlas_gastric_liquid_emptying_title" = "Gastric liquid emptying: marker remaining";
"health_atlas_platelet_fragment_count_companion" = "Tiles added per extra icon: %1$@";
"health_atlas_platelet_fragment_count_formula" = "Total tiles = megakaryocyte icons × platelet tiles per icon. At a fixed tiles-per-icon setting, each extra icon adds that many tiles. The chart uses the nearest whole icon count.";
"health_atlas_platelet_fragment_count_icons" = "Megakaryocyte icons";
"health_atlas_platelet_fragment_count_scope" = "Real platelets are small fragments of cytoplasm from bone marrow megakaryocytes, not whole cells. For this counting exercise, imagine that each megakaryocyte icon has a set of pre-labeled tiles. Each tile stands for one hypothetical platelet. These invented counts do not represent real platelet yield, blood test thresholds, or clot growth, and they are not laboratory instructions.";
"health_atlas_platelet_fragment_count_tiles_per_icon" = "Platelet tiles per icon";
"health_atlas_platelet_fragment_count_title" = "Platelet tile count";
"health_atlas_thoracic_cross_section_companion" = "Shape ratio (front-to-back ÷ side-to-side): %1$@";
"health_atlas_thoracic_cross_section_formula" = "Ellipse area = π × (front-to-back diameter ÷ 2) × (side-to-side diameter ÷ 2). Diameters in cm give area in cm². A shape ratio of 1 means a circle; smaller ratios mean the slice is wider than it is deep.";
"health_atlas_thoracic_cross_section_front_to_back" = "Front-to-back diameter";
"health_atlas_thoracic_cross_section_scope" = "During inhalation, the sternum can lift and move forward as the ribs rise, increasing front-to-back depth. The ribs can also swing outward, increasing side-to-side width. In this idealized horizontal slice, increasing either diameter while holding the other fixed increases area. The diameters are teaching examples, not measurements. This model does not predict individual chest shape, estimate lung or pleural volume, or diagnose conditions.";
"health_atlas_thoracic_cross_section_side_to_side" = "Side-to-side diameter";
"health_atlas_thoracic_cross_section_title" = "Ideal thoracic cross-sectional area";
"health_atlas_vestibular_tilt_downward" = "Head-down component (D)";
"health_atlas_vestibular_tilt_formula" = "Cue angle from head-down (degrees) = atan2(L, D) × 180 / π. Vector magnitude (g) = √(L² + D²). Both components are in g (multiples of standard gravity). L has no left or right sign; D is positive along the down axis of the head.";
"health_atlas_vestibular_tilt_lateral" = "Lateral component magnitude (L)";
"health_atlas_vestibular_tilt_magnitude" = "Vector magnitude: %1$@ g";
"health_atlas_vestibular_tilt_scope" = "The otolith organs sense a combined cue. In this convention, the gravito-inertial vector is gravitational acceleration minus linear acceleration of the head. Head tilt changes how gravity projects onto the axes of the head. For an upright head accelerating to the right, the lateral cue points left. The vector alone cannot separate tilt from linear acceleration. These synthetic values describe the cue, not actual head tilt, perceived tilt, or balance, and are not for diagnosis.";
"health_atlas_vestibular_tilt_title" = "Otolith cue angle";
