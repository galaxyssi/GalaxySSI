"health_atlas_adipose_volume_share_cell_percent" = "White adipocyte share of model tissue";
"health_atlas_adipose_volume_share_cell_view" = "Model cell section";
"health_atlas_adipose_volume_share_companion" = "Droplet share of one model cell: %1$@%%";
"health_atlas_adipose_volume_share_diagram" = "The gold disk shows the lipid droplet in a cell section. The gold sector shows the fraction of model tissue occupied by droplets.";
"health_atlas_adipose_volume_share_formula" = "For a spherical droplet and cell, the droplet volume fraction in one cell is r^3, where r is the droplet radius divided by the fixed cell radius. If these cells occupy p percent of the model tissue volume, their droplets occupy p times r^3 percent of that tissue volume.";
"health_atlas_adipose_volume_share_radius_ratio" = "Droplet radius / cell radius";
"health_atlas_adipose_volume_share_scope" = "A mature white adipocyte typically contains one large lipid droplet. This teaching model uses identical spheres with a fixed cell radius and one spherical droplet per cell. The two slider settings are invented ratios, and the rest of the model tissue adds no droplets. This geometry does not estimate personal cell dimensions, body fat mass, obesity status, or metabolic equivalents (METs).";
"health_atlas_adipose_volume_share_tissue_view" = "Droplet share of tissue";
"health_atlas_adipose_volume_share_title" = "Lipid droplet share of model tissue";
"health_atlas_circadian_light_window_companion" = "Phase within the current cycle: %1$@°";
"health_atlas_circadian_light_window_diagram" = "The pointer marks the phase within one model cycle. Gold and blue show the example light and dark windows.";
"health_atlas_circadian_light_window_dial_dark" = "Example dark window";
"health_atlas_circadian_light_window_dial_light" = "Example light window";
"health_atlas_circadian_light_window_elapsed" = "Elapsed example time";
"health_atlas_circadian_light_window_formula" = "Elapsed phase = 360° × elapsed time ÷ cycle length. The chart counts every turn. The within-cycle phase is the remainder after full turns: 0° to below 180° marks the example light window, and 180° to below 360° marks the dark window.";
"health_atlas_circadian_light_window_period" = "Example cycle length";
"health_atlas_circadian_light_window_scope" = "Light signals from the retina help synchronize the suprachiasmatic nucleus (SCN) in the hypothalamus. The SCN regulates the timing of melatonin release by pinealocytes in the pineal gland through an indirect nerve pathway. Release typically rises during the biological night. Here, equal light and dark windows are made-up cues, not a model of how light shifts the biological clock. This model does not estimate personal circadian phase, melatonin levels or timing, or sleep timing. It does not recommend light exposure or other interventions.";
"health_atlas_circadian_light_window_title" = "Circadian light and dark windows";
"health_atlas_gastric_precursor_balance_amount" = "Starting precursor amount";
"health_atlas_gastric_precursor_balance_companion" = "Precursor remaining: %1$@ MU";
"health_atlas_gastric_precursor_balance_converted_percent" = "Fictional percentage converted";
"health_atlas_gastric_precursor_balance_formula" = "Divide the selected percentage by 100 to get the converted fraction. Multiply the starting amount by that fraction to get the converted amount. Subtract the converted amount from the starting amount to get the remaining precursor.";
"health_atlas_gastric_precursor_balance_scope" = "Chief cells in gastric glands release an inactive enzyme precursor. Parietal cells supply acid, creating an environment that helps the precursor convert to its active form. The model divides a fictional starting amount into converted and remaining shares, both in model units (MU). The selected percentage is not a measure of acidity or enzyme activity. This model is for teaching only and does not predict digestion or stomach emptying.";
"health_atlas_gastric_precursor_balance_title" = "Gastric precursor balance: amount converted";
"health_atlas_melanin_distribution_companion" = "Total shared among cells: %1$@ PPU";
"health_atlas_melanin_distribution_formula" = "Amount per cell = total pigment packet units ÷ number of recipient cells. With the same total, twice as many cells get half as much each.";
"health_atlas_melanin_distribution_packet_units" = "Hypothetical pigment amount";
"health_atlas_melanin_distribution_recipient_cells" = "Recipient cell count";
"health_atlas_melanin_distribution_scope" = "In the epidermis, melanocytes package melanin in melanosomes and transfer pigment to nearby keratinocytes. In this illustration, each recipient cell gets an equal share of the hypothetical total. PPU means pigment packet units; fractions are shares, not pieces of actual melanosomes. The result is the amount inside each cell, not a uniform coating between or over cells. The model does not predict real transfer rates, skin color, or health outcomes.";
"health_atlas_melanin_distribution_title" = "Pigment amount per recipient cell";
"health_atlas_olfactory_surface_retention_companion" = "Marker on the air side: %1$@ a.u.";
"health_atlas_olfactory_surface_retention_formula" = "Mucus-side amount = total marker × (chosen percentage ÷ 100). Air-side amount = total marker − mucus-side amount. Both amounts are in arbitrary units (a.u.).";
"health_atlas_olfactory_surface_retention_mucus_share" = "Chosen mucus-side share";
"health_atlas_olfactory_surface_retention_scope" = "High in the nasal cavity, mucus covers the surface of the olfactory epithelium. Bowman glands beneath the epithelium supply mucus to that surface. This exercise splits an imaginary, inert marker across that mucus–air boundary without changing its total. The chosen share is hypothetical. It does not describe a real substance, predict smell, or assess anyone’s sense of smell.";
"health_atlas_olfactory_surface_retention_title" = "Fictional marker on the mucus side";
"health_atlas_olfactory_surface_retention_total" = "Total marker amount";
"health_atlas_oral_marker_dilution_added_water" = "Added water volume";
"health_atlas_oral_marker_dilution_companion" = "Mixed volume: %1$@ VU";
"health_atlas_oral_marker_dilution_formula" = "The marker stream always carries 8 TU of dissolved marker. The added water carries none. Mixed volume = marker stream volume + added water volume. Marker concentration = 8 TU divided by the mixed volume.";
"health_atlas_oral_marker_dilution_marker_stream" = "Marker stream volume";
"health_atlas_oral_marker_dilution_scope" = "In the mouth, tastants dissolve in saliva and can reach taste receptor cells through pores in taste buds on the tongue. When those cells are stimulated, taste nerves carry signals to the brain. Here, two streams mix evenly in one idealized local liquid sample. TU and VU are fictional units of marker amount and liquid volume. The graph shows solution concentration only. It does not show real tastant doses, receptor or nerve responses, or perceived taste intensity.";
"health_atlas_oral_marker_dilution_title" = "Oral marker dilution";
"health_atlas_thymic_branching_companion" = "Remaining group: %1$@ tiles";
"health_atlas_thymic_branching_formula" = "Selected tiles = starting tally × (selected percentage ÷ 100). Remaining tiles = starting tally minus selected tiles.";
"health_atlas_thymic_branching_scope" = "In the thymus, positive selection helps thymocytes that express both CD4 and CD8 survive and develop toward a CD4+ or CD8+ lineage. Negative selection removes many self-reactive thymocytes. Conventional CD4+ T cells can later take on helper functions, and conventional CD8+ T cells can take on cytotoxic functions. Thymus-derived regulatory T cells also arise from developing CD4+ cells but are distinct from conventional helper T cells. The exercise divides an invented tally of tiles into two groups. Neither group represents a real stage, lineage, or fate. The numbers are not biological measurements or estimates for anyone.";
"health_atlas_thymic_branching_selected_percent" = "Share of tiles in the selected group";
"health_atlas_thymic_branching_starting_tally" = "Starting tile tally";
"health_atlas_thymic_branching_title" = "Thymic branching: selected tile tally";
"health_atlas_vertebral_series_formula" = "ΔL = N × s\nL = N × (t₀ − s)\nN: number of modeled pads; s: shortening per pad (mm); t₀: synthetic starting thickness of 5 mm per pad. ΔL is total pad shortening and L is total remaining pad thickness, both in mm.";
"health_atlas_vertebral_series_pad_count" = "Number of modeled disc pads";
"health_atlas_vertebral_series_remaining_pad_thickness" = "Total remaining pad thickness: %1$@ mm";
"health_atlas_vertebral_series_scope" = "Intervertebral discs are fibrocartilage pads between adjacent vertebral bodies. Their thickness varies by spinal level. This demo lines up identical pads and shortens each by the same amount to show how the pads alone contribute to the length of a spine section. The inputs are fictional, not personal measurements. The model does not predict actual disc compression or changes in stature, guide loading, or diagnose conditions.";
"health_atlas_vertebral_series_shortening_per_pad" = "Shortening per pad";
"health_atlas_vertebral_series_title" = "Disc-pad shortening in series";
"health_atlas_vocal_cycles_caption" = "Glottal opening in slow motion";
"health_atlas_vocal_cycles_diagram" = "A top view of both vocal folds and a curve of their opening. The model shows %1$@ cycles.";
"health_atlas_vocal_cycles_duration" = "Model time window";
"health_atlas_vocal_cycles_formula" = "Cycles = frequency × time in seconds. One cycle lasts 1,000 ÷ frequency milliseconds.";
"health_atlas_vocal_cycles_frequency" = "Model frequency";
"health_atlas_vocal_cycles_opening" = "Relative opening";
"health_atlas_vocal_cycles_pause" = "Pause vocal-fold motion";
"health_atlas_vocal_cycles_period" = "One cycle: %1$@ ms";
"health_atlas_vocal_cycles_play" = "Play vocal-fold motion";
"health_atlas_vocal_cycles_position" = "Position in the model time window";
"health_atlas_vocal_cycles_scope" = "Airflow can set the vocal folds vibrating during phonation. The opening curve here is idealized and shown in slow motion. It is not a recording, a sound-pressure waveform, or an estimate of your voice.";
"health_atlas_vocal_cycles_title" = "Vocal-fold cycles in the selected time";
