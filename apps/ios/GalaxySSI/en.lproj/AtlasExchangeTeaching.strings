"health_atlas_mammary_duct_delivery_companion" = "Volume left in the model lumen: %1$@ VU";
"health_atlas_mammary_duct_delivery_displaced_share" = "Share displaced into the model duct";
"health_atlas_mammary_duct_delivery_formula" = "Volume moved into the duct = secreted volume times (displaced percentage divided by 100). Volume left in the lumen = secreted volume minus the volume moved into the duct.";
"health_atlas_mammary_duct_delivery_scope" = "In a lactating mammary gland, secretory luminal cells line the alveolus and release milk into its hollow center, the lumen. The myoepithelial cells around the alveolus contract to move milk into the ducts; they do not secrete it. In the model, one initially empty lumen receives a fictional fluid, then the surrounding contractile layer moves a chosen share into one duct. Nothing else is added or lost. VU is an invented volume unit, and the share is a model setting, not a measure of contraction strength. These settings are not physiological ranges and cannot estimate individual milk production or ejection.";
"health_atlas_mammary_duct_delivery_secreted_volume" = "Volume secreted into the model lumen";
"health_atlas_mammary_duct_delivery_title" = "Fluid moved from the alveolus into the duct";
"health_atlas_merkel_contact_companion" = "Circular contact area: %1$@ mm²";
"health_atlas_merkel_contact_force" = "Normal touch force";
"health_atlas_merkel_contact_formula" = "Average surface pressure (kPa) = normal force (mN) / circular contact area (mm²). The area is π × radius squared. At the same force, doubling the radius spreads the load over four times the area and reduces average pressure to one quarter.";
"health_atlas_merkel_contact_radius" = "Contact radius";
"health_atlas_merkel_contact_scope" = "Merkel cells in the basal epidermis work with sensory nerve endings to help signal sustained touch. The forces and small circular patches in this model are invented examples. The surface patch is not a Merkel cell or its receptive field. The model gives only average pressure at the skin surface, not pressure at the receptor. It does not predict receptor response, neural firing, or touch perception, and it does not measure touch sensitivity.";
"health_atlas_merkel_contact_title" = "Surface pressure at a touch site";
"health_atlas_mucosal_sampling_companion" = "Unselected model area: %1$@%%";
"health_atlas_mucosal_sampling_formula" = "Selected area share (%) = 100 × selected tiles ÷ (selected tiles + unselected tiles).";
"health_atlas_mucosal_sampling_scope" = "Mucosa-associated lymphoid tissue (MALT) lies near mucosal surfaces. The palatine tonsils flank the oropharynx, while the adenoid (pharyngeal tonsil) sits at the roof of the nasopharynx. Lymphoid follicles in the appendix wall and Peyer's patches in the ileum are two distinct examples of gut-associated lymphoid tissue (GALT). The model divides one imagined mucosal surface into equal-area tiles that are either selected or unselected. The counts are invented, and the resulting shares describe only the diagram. They do not measure or compare real sites or show what the tissue does.";
"health_atlas_mucosal_sampling_selected_tiles" = "Selected tiles";
"health_atlas_mucosal_sampling_title" = "Selected share of a model mucosal surface";
"health_atlas_mucosal_sampling_unselected_tiles" = "Unselected tiles";
"health_atlas_mucus_film_thickness_area" = "Fictional coated area";
"health_atlas_mucus_film_thickness_companion" = "Total fictional fluid volume: %1$@ u³";
"health_atlas_mucus_film_thickness_formula" = "Uniform film thickness = fluid volume ÷ coated area. At fixed volume, doubling the area halves the thickness. At fixed area, doubling the volume doubles the thickness.";
"health_atlas_mucus_film_thickness_scope" = "Goblet cells secrete mucins that help form surface mucus. Airway mucus helps trap inhaled particles; intestinal mucus helps lubricate and protect the lining. For the pharynx, this example refers only to the ciliated respiratory lining in parts of the nasopharynx. The calculation spreads a fictional fluid evenly over a flat patch. All units are arbitrary. It does not represent real mucus thickness or model secretion or clearance over time, assay results, or pathogen spread.";
"health_atlas_mucus_film_thickness_title" = "Mucus film thickness (teaching model)";
"health_atlas_mucus_film_thickness_volume" = "Fictional fluid volume";
"health_atlas_placental_marker_amount" = "Starting marker on the maternal side";
"health_atlas_placental_marker_amount_label" = "%1$@ units";
"health_atlas_placental_marker_barrier" = "Villous barrier";
"health_atlas_placental_marker_caption" = "Two sides of the exchange surface";
"health_atlas_placental_marker_diagram" = "Blood stays on its own side. At the selected finish: %1$@ marker units on the maternal side, %2$@ on the fetal side.";
"health_atlas_placental_marker_equilibration" = "Progress toward equal shares";
"health_atlas_placental_marker_fetal" = "Fetal side";
"health_atlas_placental_marker_formula" = "Two equal model volumes start with marker only on one side. Transferred marker = half the starting amount × selected progress toward equal shares.";
"health_atlas_placental_marker_maternal" = "Maternal side";
"health_atlas_placental_marker_pause" = "Pause placental marker transfer";
"health_atlas_placental_marker_play" = "Play placental marker transfer";
"health_atlas_placental_marker_remaining" = "Remaining on the maternal side: %1$@ model units";
"health_atlas_placental_marker_scope" = "The placenta keeps maternal and fetal blood in separate circulations while some substances cross the exchange surface. This equal-volume example tracks a fictional marker only. It does not estimate transfer for any real substance, pregnancy, or medication.";
"health_atlas_placental_marker_title" = "Placental exchange: marker reaching the fetal side";
"health_atlas_rectal_reservoir_companion" = "Volume remaining in the rectum: %1$@ mL";
"health_atlas_rectal_reservoir_formula" = "Released volume (mL) = initial rectal volume (mL) × (release share ÷ 100). Remaining rectal volume (mL) = initial rectal volume (mL) − released volume (mL).";
"health_atlas_rectal_reservoir_initial_volume" = "Initial rectal volume";
"health_atlas_rectal_reservoir_release_share" = "Release share";
"health_atlas_rectal_reservoir_scope" = "The rectum temporarily stores stool. The anal canal is the passage from the rectum to the anus, not a storage compartment. The release share is the percentage of the starting volume that passes through that outlet in the example. These made-up volumes and percentages are not normal ranges. The example does not model water absorption, pressure, or sphincter function, and is not medical advice.";
"health_atlas_rectal_reservoir_title" = "Volume released through the anal canal";
"health_atlas_renal_tubule_retention_after_a" = "After segment A";
"health_atlas_renal_tubule_retention_after_b" = "After segment B";
"health_atlas_renal_tubule_retention_companion" = "Total marker reclaimed: %1$@ a.u.";
"health_atlas_renal_tubule_retention_diagram" = "The filled disks show the marker remaining before, between, and after the two model segments.";
"health_atlas_renal_tubule_retention_formula" = "Start with 100 arbitrary units (a.u.) of marker. After A = 100 × (1 − A ÷ 100). After B = amount after A × (1 − B ÷ 100). A and B are the chosen percentages. Each segment reclaims the difference between what enters and what leaves it. Total reclaimed = 100 − amount after B.";
"health_atlas_renal_tubule_retention_scope" = "In real kidneys, the epithelium lining the tubules reabsorbs water and solutes. Tubules can pass from the cortex into the medulla and back. Nephron loops vary in depth, and different segments handle water and solutes differently. This model starts with an inert, fictional marker already inside the tubule. A and B are illustrative steps, not specific structures or kidney regions. Neither slider measures regional clearance or any other kidney function metric. The model does not simulate glomerular filtration, secretion, or urine output.";
"health_atlas_renal_tubule_retention_segment_a" = "Segment A reclamation";
"health_atlas_renal_tubule_retention_segment_b" = "Segment B reclamation";
"health_atlas_renal_tubule_retention_start" = "Start";
"health_atlas_renal_tubule_retention_title" = "Fictional marker remaining after two tubule segments";
"health_atlas_stromal_matrix_added_mass" = "Symbolically added matrix mass";
"health_atlas_stromal_matrix_companion" = "Initial matrix mass per area: %1$@ MU/AU";
"health_atlas_stromal_matrix_formula" = "Total matrix mass per area = (initial mass + symbolic addition) / 2 AU. Both amounts refer to the same fixed patch. The chart varies only the symbolic addition; no material is removed.";
"health_atlas_stromal_matrix_initial_mass" = "Matrix mass already present";
"health_atlas_stromal_matrix_scope" = "Fibroblasts contribute components such as collagen to the extracellular matrix, the material around cells. In the endometrium (uterine lining), some stromal cells express genes for matrix components. This example only tallies material in one imaginary patch. MU and AU are invented mass and area units, not tissue measurements. The model does not predict deposition rates, tissue properties, or menstrual or fertility timing.";
"health_atlas_stromal_matrix_title" = "Stromal matrix per area";
"health_atlas_tooth_enamel_section_companion" = "Inner tissue area: %1$@ mm²";
"health_atlas_tooth_enamel_section_crown" = "Model crown section";
"health_atlas_tooth_enamel_section_diagram" = "The example enamel is the pale outer ring. Its thickness is marked along the radius. The center represents everything inside the enamel.";
"health_atlas_tooth_enamel_section_enamel" = "Enamel ring";
"health_atlas_tooth_enamel_section_formula" = "With outer radius r and enamel thickness t, the inner radius is r − t. Enamel share = 100 × [1 − ((r − t) / r)²], expressed as a percentage of the full cross-section. Inner tissue area = π × (r − t)².";
"health_atlas_tooth_enamel_section_inside" = "Inner tissue";
"health_atlas_tooth_enamel_section_radius" = "Outer crown radius";
"health_atlas_tooth_enamel_section_scope" = "Enamel covers the tooth crown. Dentin lies beneath the enamel, and pulp occupies the center of the tooth. This model shows a hypothetical circular slice of the crown with a uniform enamel ring; it combines the tissues inside the ring rather than drawing dentin and pulp separately. A thicker ring takes up a larger share at the same crown radius, while a larger radius gives the same thickness a smaller share. Both dimensions are invented for teaching, not measured or typical values. This model cannot diagnose dental conditions or estimate enamel loss for an individual.";
"health_atlas_tooth_enamel_section_thickness" = "Enamel thickness";
"health_atlas_tooth_enamel_section_title" = "Enamel share of a crown cross-section";
