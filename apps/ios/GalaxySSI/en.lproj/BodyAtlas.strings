"health_atlas_aging_study_telomeres" = "Daniali et al. · Nature Communications, 2013";
"health_atlas_aging_sample_telomeres" = "87 adults · 4 tissues · ages 19–77";
"health_atlas_aging_result_telomeres" = "In this sample, leukocyte telomere length correlated with length in muscle, subcutaneous fat and skin (Pearson r = 0.83–0.84).";
"health_atlas_aging_limits_telomeres" = "This cross-sectional comparison is not repeated measurement in the same person over time. Correlation does not make blood and tissue measurements interchangeable.";
"health_atlas_aging_study_tcells" = "Liu et al. · Aging Cell, 2009";
"health_atlas_aging_sample_tcells" = "170 donors · 2 cohorts";
"health_atlas_aging_result_tcells" = "In blood T cells, log₂ p16(INK4a) mRNA expression correlated with chronological age (Pearson r = 0.63 across both cohorts).";
"health_atlas_aging_limits_tcells" = "This association does not count senescent cells in an organ or validate a personal aging test.";
"health_atlas_aging_topic_genome" = "Genomic instability";
"health_atlas_aging_explain_genome" = "Cells detect and repair many DNA lesions. Persistent lesions and mutations are distinct outcomes that can disrupt normal cell function.";
"health_atlas_aging_topic_telomeres" = "Telomere attrition";
"health_atlas_aging_explain_telomeres" = "Telomeres protect chromosome ends. In many dividing cells they can shorten, and critically short ends can trigger a damage response. The response is not determined by a single length for every tissue.";
"health_atlas_aging_topic_epigenetics" = "Epigenetic alterations";
"health_atlas_aging_explain_epigenetics" = "Chromatin and chemical marks help govern which genes are active. Age-related changes in these marks can accompany altered gene expression without changing the underlying DNA sequence.";
"health_atlas_aging_topic_proteins" = "Loss of proteostasis";
"health_atlas_aging_explain_proteins" = "Chaperones and degradation systems help maintain functional proteins. If clearance cannot keep pace with damage, misfolded proteins may persist or aggregate.";
"health_atlas_aging_topic_autophagy" = "Impaired macroautophagy";
"health_atlas_aging_explain_autophagy" = "Macroautophagy encloses some cytoplasmic material and delivers it to lysosomes. If delivery or degradation is impaired, cellular material may accumulate. The diagram shows the intact pathway.";
"health_atlas_aging_topic_nutrients" = "Deregulated nutrient sensing";
"health_atlas_aging_explain_nutrients" = "Cells combine signals about nutrients and energy to coordinate growth and maintenance. Aging research examines changes in this regulation, not a diet or fasting target.";
"health_atlas_aging_topic_mitochondria" = "Mitochondrial dysfunction";
"health_atlas_aging_explain_mitochondria" = "Mitochondria supply ATP and participate in stress signaling. Changes in their function and turnover can alter how cells meet energy demand and respond to stress.";
"health_atlas_aging_topic_senescence" = "Cellular senescence";
"health_atlas_aging_explain_senescence" = "Some stressed cells enter a durable arrest and can alter the signals they release. Senescence can play different roles in repair and chronic tissue changes; no single marker identifies every senescent cell.";
"health_atlas_aging_topic_stem_cells" = "Stem cell exhaustion";
"health_atlas_aging_explain_stem_cells" = "Tissue stem cells renew themselves and produce descendants. Age-related changes in those cells and their surroundings can constrain renewal without implying that every stem cell is lost.";
"health_atlas_aging_topic_signaling" = "Altered intercellular communication";
"health_atlas_aging_explain_signaling" = "Cells coordinate tissue behavior with local and distant signals. Changes in the signal, its source or the receiving cell can modify a response without affecting all tissues in the same way.";
"health_atlas_aging_topic_inflammation" = "Chronic inflammation";
"health_atlas_aging_explain_inflammation" = "Acute inflammation can support repair. Persistent inflammatory signaling is a separate research concern; a single inflammatory marker does not identify its cause or diagnose aging.";
"health_atlas_aging_topic_dysbiosis" = "Dysbiosis";
"health_atlas_aging_explain_dysbiosis" = "Gut microbial communities can change with age and influence interactions with the intestinal barrier. Diet, medicines and other factors also shape the community, so differences alone do not establish cause.";
