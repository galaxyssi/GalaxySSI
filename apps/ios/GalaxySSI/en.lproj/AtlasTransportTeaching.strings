"health_atlas_biliary_flow_tally_channel_count" = "Number of source channels";
"health_atlas_biliary_flow_tally_companion" = "Total volume entering in 4 demo minutes: %1$@ VU";
"health_atlas_biliary_flow_tally_formula" = "Outflow = inflow per channel times the number of channels. With nothing added, removed or stored at the junction, the same total volume enters and leaves over 4 demo minutes.";
"health_atlas_biliary_flow_tally_per_channel" = "Inflow per channel";
"health_atlas_biliary_flow_tally_scope" = "Hepatocytes release bile into tiny channels that drain into bile ducts. Smaller ducts join into larger ones; for example, the right and left hepatic ducts join to form the common hepatic duct. Cholangiocytes line the ducts and modify bile as it passes. This model isolates the joining step: identical channels carry a fictional fluid into one outlet, with no duct modification or gallbladder storage. VU is an imaginary volume unit. All settings are fictional and unrelated to personal records; the model does not predict actual bile flow or the effects of disease or drugs.";
"health_atlas_biliary_flow_tally_title" = "Outflow at a duct junction";
"health_atlas_follicle_surface_cavity_diameter" = "Model fluid cavity diameter";
"health_atlas_follicle_surface_formula" = "Cavity radius r = cavity diameter ÷ 2. Outer radius R = r + combined layer thickness. Outer area = 4πR². Shell volume = (4π ÷ 3) × (R³ − r³).";
"health_atlas_follicle_surface_scope" = "An antral follicle has a fluid-filled cavity, with granulosa cells on the inside of its wall and theca on the outside. This model treats the cavity as a sphere and the two layers as one uniform shell. The dimensions are invented, not personal measurements or reference ranges. The model does not estimate individual follicle size, predict ovulation or fertility, assess health conditions, or model the oocyte.";
"health_atlas_follicle_surface_shell_thickness" = "Combined model layer thickness";
"health_atlas_follicle_surface_shell_volume" = "Combined model layer volume: %1$@ mm³";
"health_atlas_follicle_surface_title" = "Ovarian follicle outer surface area";
"health_atlas_joint_articular_arc_angle" = "Sweep angle";
"health_atlas_joint_articular_arc_companion" = "Sweep angle in radians: %1$@ rad";
"health_atlas_joint_articular_arc_formula" = "Arc distance along the surface (mm) = radius (mm) × angle (rad). Angle (rad) = angle (degrees) × π / 180. A larger sweep gives a longer arc at the same radius. At a nonzero sweep, a larger radius also gives a longer arc.";
"health_atlas_joint_articular_arc_radius" = "Surface radius";
"health_atlas_joint_articular_arc_scope" = "At the shoulder, the rounded head of the humerus is the ball, and the shallow glenoid cavity of the scapula is the socket. This synthetic example uses a circular slice of an ideal rounded joint surface. The angle is the size of the sweep from a fixed starting ray, not a direction of shoulder motion. The model does not track real joint motion or estimate contact forces. Its angles are not exercise targets or diagnostic measures.";
"health_atlas_joint_articular_arc_title" = "Articular surface arc distance";
"health_atlas_model_corneal_refraction_companion" = "Bend toward the normal (θ₁ − θ₂): %1$@°";
"health_atlas_model_corneal_refraction_diagram" = "The amber ray enters the model surface and the green ray refracts toward the dashed normal.";
"health_atlas_model_corneal_refraction_formula" = "Snell’s law: 1.00 × sin(θ₁) = n × sin(θ₂). The incident angle θ₁ and the refracted angle θ₂ are measured in degrees from the surface normal, the line perpendicular to the surface. At a fixed oblique incident angle, a higher index n gives a smaller θ₂.";
"health_atlas_model_corneal_refraction_incident_angle" = "Incident angle";
"health_atlas_model_corneal_refraction_incident_ray" = "Incident light";
"health_atlas_model_corneal_refraction_medium_index" = "Refractive index (n)";
"health_atlas_model_corneal_refraction_refracted_ray" = "Refracted light";
"health_atlas_model_corneal_refraction_scope" = "A flat boundary from air into one uniform, transparent medium stands in for the front optical surface. In the eye, the tear film lies over the corneal epithelium. The synthetic index is not a tissue measurement, and the model does not trace light through a single cell, calculate optical power, or predict focus in an individual eye.";
"health_atlas_model_corneal_refraction_surface" = "Model surface";
"health_atlas_model_corneal_refraction_title" = "Refraction at the corneal surface";
"health_atlas_model_external_ear_resonance_formula" = "The lowest standing-wave mode fits one quarter-wavelength in a tube with one open end and one closed end. Fundamental frequency (Hz) = v / (4L), with v in m/s and L converted from cm to m. A longer tube lowers the fundamental at fixed speed; faster sound raises it at fixed length.";
"health_atlas_model_external_ear_resonance_length" = "Classroom tube length (L)";
"health_atlas_model_external_ear_resonance_scope" = "These made-up values describe a straight, rigid classroom tube, not a real ear or personal measurement. The real ear canal is not a rigid pipe: it curves, varies in width, and ends at a vibrating eardrum rather than an ideal sealed end. This analogy does not predict individual hearing.";
"health_atlas_model_external_ear_resonance_speed" = "Speed of sound in tube air (v)";
"health_atlas_model_external_ear_resonance_title" = "External ear: ideal tube resonance";
"health_atlas_model_external_ear_resonance_wavelength" = "Fundamental wavelength: %1$@ cm.";
"health_atlas_neural_relay_delays_companion" = "Delay before the final relay: %1$@ ms";
"health_atlas_neural_relay_delays_count" = "Relay stages";
"health_atlas_neural_relay_delays_formula" = "Total relay delay = relay stages × delay per relay. The total includes every relay up to and including the final one. Each extra relay adds the same delay.";
"health_atlas_neural_relay_delays_per_relay" = "Delay per relay";
"health_atlas_neural_relay_delays_scope" = "In brain circuits and autonomic ganglia, neurons can pass signals at chemical synapses. Releasing a neurotransmitter and getting a response from the next cell takes time. This model uses an invented chain of relays. Every relay passes the signal and adds the same delay between cells; travel along an axon is not included. The model does not map actual connections. Its numbers are invented and do not measure personal timing, nerve conduction speed, or reaction time. They are not for diagnosis.";
"health_atlas_neural_relay_delays_title" = "Total synaptic relay delay";
"health_atlas_parathyroid_occupancy_formula" = "Occupied percent = 100 × s ÷ (s + k). When s equals k, half the sites are occupied. At fixed k, as s rises, occupancy approaches 100 percent in smaller and smaller steps.";
"health_atlas_parathyroid_occupancy_half_point" = "Half-occupancy level (k)";
"health_atlas_parathyroid_occupancy_scope" = "When blood calcium falls, parathyroid chief cells release parathyroid hormone (PTH) to help regulate it. After secretion, the hormone can bind to receptors on target cells and start a response. This analogy shows only binding of an imaginary signal, not how strongly a cell responds. Both sliders use made-up, unitless numbers, not personal records or real receptor affinity. This model does not predict PTH or blood calcium levels.";
"health_atlas_parathyroid_occupancy_signal" = "Example signal level (s)";
"health_atlas_parathyroid_occupancy_title" = "Receptor site occupancy";
"health_atlas_parathyroid_occupancy_unoccupied" = "Unoccupied sites: %1$@%%";
"health_atlas_sweat_duct_balance_coil_sodium" = "Sodium secreted by the coil";
"health_atlas_sweat_duct_balance_companion" = "Net sodium reabsorbed: %1$@ nmol";
"health_atlas_sweat_duct_balance_formula" = "Reabsorbed sodium (nmol) = sodium secreted by the coil (nmol) × (net reabsorbed percentage ÷ 100). Sodium remaining at the duct outlet (nmol) = sodium secreted by the coil − reabsorbed sodium.";
"health_atlas_sweat_duct_balance_net_reabsorbed" = "Duct sodium reabsorption (net share)";
"health_atlas_sweat_duct_balance_scope" = "In the dermis, an eccrine secretory coil releases water and sodium ions into its lumen to form primary sweat. Downstream, the duct reabsorbs some sodium from the lumen toward the surrounding tissue before the sweat reaches the skin surface. This synthetic example tracks only sodium in one parcel, holding its water at 1 µL from the coil to the duct outlet. The settings are illustrative, not reference ranges. The result is neither a tissue measurement nor an estimate of whole-body sweat.";
"health_atlas_sweat_duct_balance_title" = "Sodium remaining at the sweat duct outlet";
