"health_atlas_major_salivary_pairs_view" = "三对大唾液腺的前面观";
"health_atlas_major_salivary_parotid" = "腮腺";
"health_atlas_major_salivary_parotid_detail" = "腮腺是最大的一对唾液腺，位于耳的前下方。两侧的腮腺导管各自横过面颊，开口于上颌第二磨牙相对的颊黏膜上。";
"health_atlas_major_salivary_sublingual" = "舌下腺";
"health_atlas_major_salivary_sublingual_detail" = "舌下腺是最小的一对大唾液腺，分别位于舌下两侧的口底黏膜下。每侧都有数条短导管沿舌下襞开口。";
"health_atlas_major_salivary_submandibular" = "下颌下腺";
"health_atlas_major_salivary_submandibular_detail" = "这对腺体大部分位于下颌骨下方。两侧的下颌下腺导管各自向前走行，开口于舌系带旁。";
"health_atlas_mdr_ej_course" = "前列腺内走行";
"health_atlas_mdr_ej_course_detail" = "两条射精管从前列腺底进入腺体，斜向内前方的尿道，在前列腺内始终彼此分开。";
"health_atlas_mdr_ej_openings" = "精阜处的射精管开口";
"health_atlas_mdr_ej_openings_detail" = "两条射精管分别开口于精阜。精阜是尿道前列腺部后壁上的隆起。";
