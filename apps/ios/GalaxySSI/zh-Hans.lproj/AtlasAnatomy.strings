"health_atlas_atria_compare_caval" = "上腔静脉口";
"health_atlas_atria_compare_caval_detail" = "上腔静脉在右心房上部开口。下腔静脉开口较低，两者均位于内壁平滑的静脉区。";
"health_atlas_atria_compare_fossa" = "卵圆窝";
"health_atlas_atria_compare_fossa_detail" = "这是右心房房间隔面上的浅椭圆形凹陷，是胎儿卵圆孔的遗迹。本图所示的成人卵圆窝并非开放的通道。";
"health_atlas_atria_compare_pectinate" = "右心房梳状肌";
"health_atlas_atria_compare_pectinate_detail" = "梳状肌从界嵴呈扇形伸入右心耳。界嵴将隆起的肌壁与平滑的静脉区分开。";
"health_atlas_atria_compare_pulmonary" = "肺静脉开口";
"health_atlas_atria_compare_pulmonary_detail" = "图中左心房后壁有四个肺静脉口，每侧肺各有两个，接收从肺回流的血液。";
"health_atlas_atria_compare_selector" = "双心房剖视";
"health_atlas_atria_compare_smooth" = "左心房平滑壁";
"health_atlas_atria_compare_smooth_detail" = "左心房大部分内壁较平滑，包括各肺静脉口之间的后壁；梳状肌仅位于左心耳内。";
"health_atlas_atria_compare_view" = "左右心房内部对照：图左为右心房，图右为左心房。两侧为独立的剖视图。";
"health_atlas_collecting_ducts_calyx" = "肾小盏";
"health_atlas_collecting_ducts_calyx_detail" = "肾小盏呈杯状，围绕肾乳头并接收从乳头开口流出的尿液。它属于集合管下游的排尿通路。";
"health_atlas_collecting_ducts_cortical" = "皮质集合管";
"health_atlas_collecting_ducts_cortical_detail" = "不同肾单位的连接小管汇入同一条皮质集合管。图中两个独立的肾单位出口汇入这条共同通路。";
"health_atlas_collecting_ducts_medullary" = "髓质集合管";
"health_atlas_collecting_ducts_medullary_detail" = "集合管沿肾锥体向深部延伸，在内髓质逐步汇成较粗的管道，通向肾乳头。";
"health_atlas_collecting_ducts_papillary" = "乳头管";
"health_atlas_collecting_ducts_papillary_detail" = "乳头管又称贝利尼管，是集合管通路的末段。它在肾乳头顶端开口于肾小盏；图中仅示一个开口。";
"health_atlas_collecting_ducts_tree_selector" = "集合管通路";
"health_atlas_collecting_ducts_tree_view" = "从肾皮质到肾乳头的集合管";
"health_atlas_diaphragm_inferior_aortic" = "主动脉裂孔";
"health_atlas_diaphragm_inferior_aortic_detail" = "主动脉从正中弓状韧带下方通过，位于两膈脚之间、膈的后方，不穿过膈肌或中心腱。";
"health_atlas_diaphragm_inferior_caval" = "腔静脉孔";
"health_atlas_diaphragm_inferior_caval_detail" = "下腔静脉经中心腱右侧的开口穿过膈。";
"health_atlas_diaphragm_inferior_costal" = "膈肋部";
"health_atlas_diaphragm_inferior_costal_detail" = "膈肋部的肌纤维附着于下部肋骨和肋软骨的内面，并向内汇入中心腱。";
"health_atlas_diaphragm_inferior_crus" = "右膈脚";
"health_atlas_diaphragm_inferior_crus_detail" = "右膈脚比左膈脚长，将膈固定在上部腰椎。从下方观察时，右膈脚位于图像左侧。";
"health_atlas_diaphragm_inferior_esophageal" = "食管裂孔";
"health_atlas_diaphragm_inferior_esophageal_detail" = "食管经中心腱后方肌性部分的开口穿过膈。环绕裂孔的肌纤维主要来自右膈脚。";
"health_atlas_diaphragm_inferior_selector" = "膈的下面观";
"health_atlas_diaphragm_inferior_tendon" = "中心腱";
"health_atlas_diaphragm_inferior_tendon_detail" = "周围的膈肌纤维汇聚于这片浅色的三叶状腱膜。呼吸时，中心腱随膈肌运动。";
"health_atlas_diaphragm_inferior_view" = "从下方观察膈，图上方为人体前方";
"health_atlas_distal_tubule_connector" = "连接小管";
"health_atlas_distal_tubule_connector_detail" = "这段短小管将远曲小管内的液体送入集合管系统。集合管也接收其他肾单位的液体。";
"health_atlas_distal_tubule_convolution" = "远曲小管";
"health_atlas_distal_tubule_convolution_detail" = "这段弯曲的小管位于肾皮质。它的管腔与髓袢升支相通，并不连通邻近的肾小球毛细血管。";
"health_atlas_distal_tubule_junction_selector" = "远端小管连接";
"health_atlas_distal_tubule_junction_view" = "远端小管与肾小体及集合管的位置关系";
"health_atlas_distal_tubule_lining" = "立方上皮";
"health_atlas_distal_tubule_lining_detail" = "远端小管的管腔由单层立方上皮围成。这里没有近端小管那样密集的刷状缘，因此管腔边缘更清晰。";
"health_atlas_distal_tubule_macula" = "致密斑";
"health_atlas_distal_tubule_macula_detail" = "这片排列紧密的细胞位于升支粗段末端附近，紧邻肾小球的血管极，在远曲小管起始处的上游。";
"health_atlas_gastrocnemius_aponeurosis" = "腓肠肌腱膜";
"health_atlas_gastrocnemius_aponeurosis_detail" = "腓肠肌两头的肌纤维附着在宽阔的腱膜上。腱膜向下逐渐变窄，与比目鱼肌的腱性部分汇合形成跟腱。";
"health_atlas_gastrocnemius_calcaneal_insertion" = "跟骨止点";
"health_atlas_gastrocnemius_calcaneal_insertion_detail" = "腓肠肌两头和比目鱼肌经跟腱止于跟骨结节的后面。跟骨结节是足跟骨的隆起部分。";
"health_atlas_gastrocnemius_lateral_origin" = "外侧头起点";
"health_atlas_gastrocnemius_lateral_origin_detail" = "外侧头起自股骨外侧髁上方，其肌腹形成小腿后方外侧的隆起。";
"health_atlas_gastrocnemius_medial_origin" = "内侧头起点";
"health_atlas_gastrocnemius_medial_origin_detail" = "内侧头起自股骨后面、内侧髁上方，其肌腹形成小腿后方内侧的隆起。";
"health_atlas_gastrocnemius_posterior_attachments_selector" = "腓肠肌起止点";
"health_atlas_gastrocnemius_posterior_attachments_view" = "右侧腓肠肌后面观，显示从膝上两处起点到足跟共同肌腱的结构。";
"health_atlas_gluteus_maximus_femoral_insertion" = "臀肌粗隆";
"health_atlas_gluteus_maximus_femoral_insertion_detail" = "最下部的肌纤维止于臀肌粗隆，即股骨上段后面、大转子下方的粗糙骨嵴。";
"health_atlas_gluteus_maximus_iliac_origin" = "髂骨起点";
"health_atlas_gluteus_maximus_iliac_origin_detail" = "上部肌纤维起自髂骨臀后线及其邻近的髂骨外面。";
"health_atlas_gluteus_maximus_iliotibial_insertion" = "髂胫束";
"health_atlas_gluteus_maximus_iliotibial_insertion_detail" = "上部肌纤维汇入髂胫束。髂胫束是沿大腿外侧向下延伸的增厚筋膜带。";
"health_atlas_gluteus_maximus_posterior_attachments_selector" = "臀大肌起止点";
"health_atlas_gluteus_maximus_posterior_attachments_view" = "右侧臀大肌后面观，显示骨盆上的起点及髋外侧的两处止点。";
"health_atlas_gluteus_maximus_sacral_origin" = "骶骨起点";
"health_atlas_gluteus_maximus_sacral_origin_detail" = "内侧肌纤维起自骶骨背面及尾骨外侧。另有部分纤维起自邻近的骶结节韧带。";
"health_atlas_hand_carpals" = "腕骨";
"health_atlas_hand_carpals_detail" = "八块小骨排列成两排，构成手掌的基部；其中部分腕骨与桡骨相接。";
"health_atlas_hand_metacarpals" = "掌骨";
"health_atlas_hand_metacarpals_detail" = "五块掌骨连接腕部与手指，组成手掌的骨性支架。";
"health_atlas_hand_palmar_detail" = "手骨掌侧";
"health_atlas_hand_phalanges" = "手指指骨";
"health_atlas_hand_phalanges_detail" = "除拇指外，每根手指有三节指骨，相邻指骨的关节让手指能够弯曲。";
"health_atlas_hand_pisiform" = "豌豆骨";
