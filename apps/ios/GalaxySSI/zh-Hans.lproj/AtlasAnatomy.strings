"health_atlas_mdr_vas_pelvic" = "盆腔段";
"health_atlas_mdr_vas_pelvic_detail" = "输精管进入盆腔后沿盆侧壁走行，转向膀胱后下方，但并不开口于膀胱内。";
"health_atlas_mdr_vas_selector" = "输精管走行";
"health_atlas_mdr_vas_view" = "输精管 · 从附睾至膀胱后方的单侧走行";
"health_atlas_nasal_wall_choana" = "后鼻孔";
"health_atlas_nasal_wall_choana_detail" = "左右鼻腔各有一个后方开口，称为后鼻孔，通向软腭上方的鼻咽。";
"health_atlas_nasal_wall_inferior" = "下鼻甲";
"health_atlas_nasal_wall_inferior_detail" = "下鼻甲位置最低、体积最大，是一块独立的骨。其表面黏膜有助于温暖和湿润吸入的空气，鼻泪管开口于其下方的下鼻道。";
"health_atlas_nasal_wall_middle" = "中鼻甲";
"health_atlas_nasal_wall_middle_detail" = "中鼻甲呈弯曲的薄片状，是筛骨的一部分。其下方的中鼻道接收多个鼻旁窦的引流。";
"health_atlas_nasal_wall_selector" = "鼻腔外侧壁";
"health_atlas_nasal_wall_superior" = "上鼻甲";
"health_atlas_nasal_wall_superior_detail" = "通常所见的三个鼻甲中，上鼻甲最小，从鼻腔外侧壁的后上方突出，部分表面属于嗅区。";
"health_atlas_nasal_wall_vestibule" = "鼻前庭";
"health_atlas_nasal_wall_vestibule_detail" = "鼻前庭紧邻鼻孔内侧，内衬类似皮肤，粗硬的鼻毛可拦截部分较大的颗粒。";
"health_atlas_nasal_wall_view" = "鼻腔侧面剖视，鼻中隔已移除";
"health_atlas_pancreatic_main_duct_bend" = "胰头内的导管弯曲段";
"health_atlas_pancreatic_main_duct_bend_detail" = "主胰管在较宽的胰头内弯向十二指肠降部的肠壁，通常在那里与胆总管汇合。";
"health_atlas_pancreatic_main_duct_papilla" = "十二指肠大乳头";
"health_atlas_pancreatic_main_duct_papilla_detail" = "这个小突起标示了十二指肠降部内侧壁上的开口。图中所示的常见形态是两管在开口前汇成一段短的共同通道，称为肝胰壶腹。";
"health_atlas_pancreatic_main_duct_selector" = "主胰管剖视图";
"health_atlas_pancreatic_main_duct_tributaries" = "胰尾的汇入小管";
"health_atlas_pancreatic_main_duct_tributaries_detail" = "来自胰腺小叶的细小导管在狭窄的胰尾附近汇合，形成主胰管的起始段。";
"health_atlas_pancreatic_main_duct_trunk" = "主胰管（维尔松管）";
"health_atlas_pancreatic_main_duct_trunk_detail" = "主胰管位于胰腺内，沿途接纳较小的分支导管，将胰液从胰尾经胰体输向胰头。";
"health_atlas_pancreatic_main_duct_view" = "主胰管前面观：从胰尾到十二指肠";
"health_atlas_pharynx_regions_epiglottis" = "会厌";
"health_atlas_pharynx_regions_epiglottis_detail" = "会厌是位于喉入口附近的叶状软骨，吞咽时向后翻下覆盖喉入口，有助于保护气道。";
"health_atlas_pharynx_regions_laryngopharynx" = "喉咽";
"health_atlas_pharynx_regions_laryngopharynx_detail" = "喉咽是咽的最下部，位于喉后方，向下续接食管，而喉入口朝向前方。";
"health_atlas_pharynx_regions_nasopharynx" = "鼻咽";
