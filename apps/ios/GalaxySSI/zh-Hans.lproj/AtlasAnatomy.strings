"health_atlas_pharynx_regions_oropharynx" = "口咽";
"health_atlas_pharynx_regions_oropharynx_detail" = "口咽是咽的中部，位于软腭下方、口腔和舌的后方。气流和吞咽的食物都经此通过。";
"health_atlas_pharynx_regions_selector" = "咽的三个分区";
"health_atlas_pharynx_regions_soft_palate" = "软腭";
"health_atlas_pharynx_regions_soft_palate_detail" = "软腭是硬腭后方可活动的部分。吞咽时软腭抬起，将鼻咽与下方的通道隔开。";
"health_atlas_pharynx_regions_view" = "显示咽的三个分区的矢状切面";
"health_atlas_prostate_apex" = "前列腺尖";
"health_atlas_prostate_apex_detail" = "前列腺下端逐渐变窄形成尖部。尿道由此离开前列腺，继续通向盆底。";
"health_atlas_prostate_base" = "前列腺底";
"health_atlas_prostate_base_detail" = "前列腺宽阔的上面与膀胱颈相接，尿道在此进入前列腺。";
"health_atlas_prostate_central_zone" = "中央区";
"health_atlas_prostate_central_zone_detail" = "这片楔形腺体组织围绕射精管，靠近前列腺底较宽，朝射精管汇入尿道前列腺部的位置逐渐变窄。";
"health_atlas_prostate_peripheral_zone" = "外周区";
"health_atlas_prostate_peripheral_zone_detail" = "这一区域的腺体组织构成前列腺后部和两侧的大部分。在此切面上，它面向直肠，向下延伸至前列腺尖附近。";
"health_atlas_prostate_sagittal_selector" = "矢状切面分区";
"health_atlas_prostate_sagittal_view" = "前列腺矢状切面分区示意，图左为身体前方。";
"health_atlas_prostatic_urethra" = "尿道前列腺部";
"health_atlas_prostatic_urethra_detail" = "这段尿道从膀胱颈穿过前列腺，直至前列腺尖。";
