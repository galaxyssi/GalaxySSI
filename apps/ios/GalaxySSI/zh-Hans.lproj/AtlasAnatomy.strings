"health_atlas_mdr_epi_selector" = "附睾管";
"health_atlas_mdr_epi_tail" = "附睾尾";
"health_atlas_mdr_epi_tail_detail" = "在睾丸下极，附睾尾内盘曲的管道逐渐变直，延续为向上行走的输精管。";
"health_atlas_mdr_epi_view" = "附睾 · 后外侧观，示睾丸局部剖面";
"health_atlas_mdr_sv_blind" = "精囊上端盲端";
"health_atlas_mdr_sv_blind_detail" = "每侧精囊的上端封闭，位于膀胱后方、输精管末端的外侧。";
