"health_atlas_mdr_sv_outlet" = "精囊排泄管";
"health_atlas_mdr_sv_outlet_detail" = "这条短管从精囊下端引出，与同侧输精管壶腹汇合。汇合后的管道称为射精管。";
"health_atlas_mdr_sv_selector" = "成对精囊";
"health_atlas_mdr_sv_view" = "精囊 · 膀胱底后面观";
"health_atlas_mdr_vas_ampulla" = "输精管壶腹";
"health_atlas_mdr_vas_ampulla_detail" = "输精管末端在精囊内侧膨大成壶腹，与同侧精囊排泄管汇合，形成同侧射精管。";
