"health_atlas_bone_section_area" = "骨皮质横截面积：%1$@ mm²";
"health_atlas_bone_section_force" = "轴向压缩力";
"health_atlas_bone_section_formula" = "外半径固定为 5 mm。内半径 = 外半径 − 骨皮质厚度。骨皮质横截面积 = π ×（外半径² − 内半径²）。名义压应力 = 轴向压缩力 ÷ 骨皮质横截面积（1 N/mm² = 1 MPa）。";
"health_atlas_bone_section_scope" = "在长骨骨干中，密质骨（骨皮质）构成包绕骨髓腔的壁。本模型仅将一小段骨干简化为直圆管，例如锁骨中段的一小段，或手部一根掌骨、足部一根跖骨的骨干片段。压缩力沿圆管的中心轴线作用。压缩力相同时，骨皮质越厚，承载面积越大，平均压应力越低。数值均为教学示例。本模型不考虑形状变化、弯曲或扭转，不能估算真实骨骼的应力或骨折风险。";
"health_atlas_bone_section_title" = "名义轴向压应力";
"health_atlas_bone_section_wall_thickness" = "骨皮质厚度";
"health_atlas_colonic_water_balance_companion" = "净吸收水量：%1$@ mL";
"health_atlas_colonic_water_balance_formula" = "净吸收水量（mL）= 初始水量（mL）×（净吸收百分比 ÷ 100）。剩余水量（mL）= 初始水量（mL）− 净吸收水量（mL）。";
"health_atlas_colonic_water_balance_net_absorbed" = "净吸收百分比";
"health_atlas_colonic_water_balance_scope" = "结肠吸收来自小肠的内容物中大部分剩余水分。此模型以结肠内的示例水量为起点。所选百分比表示净吸收水量（吸收量减去分泌量）占初始水量的比例。这些数值仅用于教学，不是参考范围，也不能预测个人的吸收量或排便量。";
"health_atlas_colonic_water_balance_starting_volume" = "初始水量";
"health_atlas_colonic_water_balance_title" = "结肠内剩余水量";
"health_atlas_endocrine_dilution_amount" = "示踪物总量";
"health_atlas_endocrine_dilution_companion" = "稀释后保留的示踪物总量：%1$@ TU";
"health_atlas_endocrine_dilution_formula" = "示踪物浓度 = 示踪物总量 ÷ 最终体积。仅将体积加倍，浓度就减半；仅将示踪物总量加倍，浓度就加倍。";
"health_atlas_endocrine_dilution_scope" = "激素分泌后可随血液运输。有些信号也作用于邻近细胞，例如胰岛内的细胞间信号。这个类比只比较均匀混合且示踪物无损失的样本。所有数值均为虚构；TU 和 VU 分别是示踪物量和体积的虚构单位。本模型不描述实际混合过程或激素动力学，也不预测血液中的激素浓度。";
"health_atlas_endocrine_dilution_title" = "稀释后的示踪物浓度";
"health_atlas_endocrine_dilution_volume" = "最终体积";
"health_atlas_glial_capacitance_area" = "相对内表面积";
"health_atlas_glial_capacitance_formula" = "相对电容 = 相对面积 × ln(1.5) ÷ ln(1 + 相对厚度 ÷ 2)，其中 ln 表示自然对数。";
"health_atlas_glial_capacitance_per_area" = "单位内表面积的相对电容：%1$@ 倍";
"health_atlas_glial_capacitance_scope" = "在周围神经系统中，形成髓鞘的施万细胞包裹轴突；在中枢神经系统中，这一过程由少突胶质细胞完成。模型将一段有髓鞘的轴突简化为理想圆柱形电容器，保持内半径和绝缘材料不变。内表面积随节段长度变化。所有数值均为假设基准值的倍数，基准髓鞘厚度为内半径的一半。在电压和面积相同的情况下，髓鞘越厚，电容越小，储存的电荷也越少。本模型不估算神经传导速度，也不用于诊断。";
"health_atlas_glial_capacitance_thickness" = "相对髓鞘厚度";
"health_atlas_glial_capacitance_title" = "髓鞘电容（理想模型）";
"health_atlas_keratin_growth_companion" = "示例中长出 1 毫米所需的时间：%1$@ 天";
"health_atlas_keratin_growth_formula" = "毛干增长长度（毫米）= 示例生长速率（毫米/天）× 示例经过时间（天）。";
"health_atlas_keratin_growth_rate" = "示例生长速率";
"health_atlas_keratin_growth_scope" = "在生长期，毛母质细胞在毛囊内分裂。部分新生细胞在毛干向外推进的过程中角化，成为毛干的一部分。本示例假设生长速率恒定，不模拟毛发生长周期。速率和时间均为虚构的教学参数，不用于测量或预测个人的毛发生长。";
"health_atlas_keratin_growth_time" = "示例经过时间";
"health_atlas_keratin_growth_title" = "毛干增长长度";
"health_atlas_lymph_particle_transport_companion" = "5 分钟内携带的染料质量：%1$@ µg";
"health_atlas_lymph_particle_transport_concentration" = "淋巴液中的染料浓度";
"health_atlas_lymph_particle_transport_flow" = "模型中的淋巴液流量";
"health_atlas_lymph_particle_transport_formula" = "单位时间内携带的染料质量（µg/min）= 染料浓度（µg/mL）× 淋巴液流量（mL/min）。";
"health_atlas_lymph_particle_transport_scope" = "毛细淋巴管的管壁由淋巴管内皮细胞构成，组织液进入管内后成为淋巴液。淋巴液经输出淋巴管离开淋巴结；胸导管通常在左颈内静脉与左锁骨下静脉的汇合处将淋巴液送回血液循环。本模型只考察一股稳定的淋巴液流，例如从淋巴结流出的淋巴液，并假设虚构的染料已均匀混合在其中。染料在所考察的管段中没有增加、损失或积存，因此每分钟流入与流出的染料质量相同。浓度不变时，每分钟流过的淋巴液越多，携带的染料就越多。数值均为虚构，不用于估算染料进入淋巴液的过程、淋巴结的过滤作用或实际淋巴液流量。";
"health_atlas_lymph_particle_transport_title" = "淋巴液携带染料";
"health_atlas_muscle_shortening_count" = "串联肌节数";
"health_atlas_muscle_shortening_formula" = "ΔL = N × s / 1000\nL = N × (2.5 − s) / 1000\nN：串联肌节数；s：单个肌节的缩短量（µm，微米）。演示设定每个肌节的初始长度为 2.5 µm。ΔL 为节段缩短量，L 为缩短后的节段长度，单位均为 mm（毫米）。";
"health_atlas_muscle_shortening_per_sarcomere" = "单个肌节的缩短量";
"health_atlas_muscle_shortening_remaining_length" = "缩短后的节段长度：%1$@ mm";
"health_atlas_muscle_shortening_scope" = "此演示假设一段笔直的肌原纤维中，所有肌节的缩短量相同。输入为虚构的教学数值，并非任何个人或所选肌肉的测量值。模型不考虑肌肉的整体构造、整块肌肉或关节的位移，也不计算力，不用于估算运动表现或预测患者结局。";
"health_atlas_muscle_shortening_title" = "肌原纤维节段的缩短量";
"health_atlas_retinal_convergence_companion" = "未亮起的样本数（期望值）：%1$@";
"health_atlas_retinal_convergence_formula" = "亮起的样本数（期望值）= 参与汇聚的样本数 ×（亮起概率的百分数 ÷ 100）。每个样本亮起时计为 1，否则计为 0。亮起和未亮起的样本数的期望值之和等于总样本数。";
"health_atlas_retinal_convergence_lit_percent" = "每个样本在模拟中亮起的概率";
"health_atlas_retinal_convergence_samples" = "参与汇聚的样本数";
"health_atlas_retinal_convergence_scope" = "在某些视网膜回路中，双极细胞整合感光细胞的信号，神经节细胞汇聚多个双极细胞的信号。本教学示例将等权重的二值样本汇入同一组。亮起概率相同且大于零时，样本越多，平均亮起的样本数就越多。期望值是长期平均值，因此可以不是整数。本模型不考虑 ON/OFF 通路及感受野中心与周边的相互作用。各样本不代表彼此独立的人眼感受野，结果也不代表视觉阈值或神经放电频率。";
"health_atlas_retinal_convergence_title" = "亮起的样本数（期望值）";
