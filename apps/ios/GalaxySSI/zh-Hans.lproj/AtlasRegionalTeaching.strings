"health_atlas_bladder_expansion_scope" = "膀胱壁与内衬可随充盈扩张。这里以球体说明容积和表面积的关系，不估算真实膀胱容量、压力或单个细胞的伸展。";
"health_atlas_bladder_expansion_title" = "膀胱充盈：表面积增幅";
"health_atlas_bone_remodeling_balance_companion" = "重塑后骨基质总量：%1$@ a.u.";
"health_atlas_bone_remodeling_balance_formed" = "基质形成量";
"health_atlas_bone_remodeling_balance_formula" = "基质净变化量 = 基质形成量 − 基质吸收量。重塑后骨基质总量 = 100 a.u. + 基质净变化量。净变化量为零表示形成量与吸收量相等。";
"health_atlas_bone_remodeling_balance_resorbed" = "基质吸收量";
"health_atlas_bone_remodeling_balance_scope" = "骨细胞发出信号，帮助协调骨重塑。破骨细胞先吸收旧基质，随后成骨细胞沉积新基质。本模型只计算一小块骨组织中骨基质的增减，不模拟各阶段的时长或信号传递。数值均为教学设定，以任意单位（a.u.）表示，不用于估算真实骨组织的变化。";
"health_atlas_bone_remodeling_balance_title" = "骨基质净变化量";
"health_atlas_cutaneous_sebum_area" = "覆盖面积";
"health_atlas_cutaneous_sebum_companion" = "覆盖层中的皮脂总质量：%1$@ µg";
"health_atlas_cutaneous_sebum_formula" = "平均面密度 = 皮脂质量 ÷ 覆盖面积。质量不变时，面积加倍，平均面密度减半。面积不变时，质量加倍，平均面密度也加倍。";
"health_atlas_cutaneous_sebum_mass" = "皮脂质量";
"health_atlas_cutaneous_sebum_scope" = "皮脂腺内的皮脂细胞产生皮脂，皮脂通常经毛囊到达皮肤表面。模型假设皮脂均匀覆盖一块皮肤，且没有损失。质量和面积均为示例，并非实测值。模型不描述皮脂在皮肤表面的实际分布，也不预测个人的皮脂分泌速率。";
"health_atlas_cutaneous_sebum_title" = "皮脂平均面密度";
"health_atlas_gastric_liquid_emptying_companion" = "已排出的标记物占初始量的 %1$@%%";
"health_atlas_gastric_liquid_emptying_formula" = "将所选的排出百分数除以 100，得到比例 f。每一步都按比例 f 从当时剩余的标记物中排出一部分，留下的比例为（1 − f）。经过 n 步后，剩余标记物占初始量的百分数为 100 ×（1 − f）^n，排出百分数为 100 减去剩余百分数。";
"health_atlas_gastric_liquid_emptying_intervals" = "模型步数";
"health_atlas_gastric_liquid_emptying_removal" = "每步排出比例";
"health_atlas_gastric_liquid_emptying_scope" = "胃内的液体内容物经幽门进入十二指肠。实际的胃排空受到生理调节，可随液体的能量密度而变化。此模型将胃简化为一个完全混合的空间，追踪一种虚构的标记物。标记物不会被添加、吸收或分解，只随液体流出。排出百分比仅为示例，模型步数不对应实际时间。仅供教学，不用于预测消化过程或个人的胃排空情况，也不用于临床。";
"health_atlas_gastric_liquid_emptying_title" = "胃内液体排空：剩余标记物";
"health_atlas_platelet_fragment_count_companion" = "每多一个图标增加的图块数：%1$@";
"health_atlas_platelet_fragment_count_formula" = "图块总数 = 巨核细胞图标数 × 每个图标对应的血小板图块数。每个图标对应的图块数不变时，每增加一个图标，就加上这么多图块。图表将图标数四舍五入为整数。";
"health_atlas_platelet_fragment_count_icons" = "巨核细胞图标数";
"health_atlas_platelet_fragment_count_scope" = "真实的血小板是来自骨髓巨核细胞的细胞质碎片，并不是完整的细胞。在这个计数练习中，设想每个巨核细胞图标都有一组预先标记的图块，每个图块代表一枚假想的血小板。这些虚构数字不代表实际的血小板生成量、血液检验阈值或血栓生长，也不是实验操作指南。";
"health_atlas_platelet_fragment_count_tiles_per_icon" = "每个图标对应的血小板图块数";
"health_atlas_platelet_fragment_count_title" = "血小板图块总数";
"health_atlas_thoracic_cross_section_companion" = "形状比（前后径 ÷ 左右径）：%1$@";
"health_atlas_thoracic_cross_section_formula" = "椭圆面积 = π ×（前后径 ÷ 2）×（左右径 ÷ 2）。直径以 cm 为单位，面积以 cm² 为单位。形状比为 1 时，截面为圆形；小于 1 时，左右宽度大于前后深度。";
"health_atlas_thoracic_cross_section_front_to_back" = "前后径";
"health_atlas_thoracic_cross_section_scope" = "吸气时，肋骨抬高可带动胸骨向上、向前移动，使胸廓的前后径增大；肋骨也可向外摆动，使左右径增大。在这个理想化的水平截面中，固定一个直径，增大另一个直径，面积就会增大。直径仅为教学示例，并非实测值。本模型不能预测个体胸廓形状，不能估算肺容积或胸膜腔容积，也不能用于诊断。";
"health_atlas_thoracic_cross_section_side_to_side" = "左右径";
"health_atlas_thoracic_cross_section_title" = "理想化胸廓横截面积";
"health_atlas_vestibular_tilt_downward" = "沿头部向下轴的分量（D）";
"health_atlas_vestibular_tilt_formula" = "线索方向与头部向下轴的夹角（度）= atan2(L, D) × 180 / π。矢量大小（g）= √(L² + D²)。两个分量均以 g（标准重力加速度的倍数）为单位。L 只表示大小，不区分左右；D 沿头部向下轴取正值。";
"health_atlas_vestibular_tilt_lateral" = "侧向分量大小（L）";
"health_atlas_vestibular_tilt_magnitude" = "矢量大小：%1$@ g";
"health_atlas_vestibular_tilt_scope" = "耳石器感知的是一种合成线索。本示例将重力-惯性加速度矢量定义为重力加速度减去头部的线加速度。头部倾斜会改变重力在头部各轴上的分量。头部直立并向右加速时，线索的侧向分量指向左方。仅凭这一矢量无法区分头部倾斜和线加速度。这些模拟数值仅描述线索，不表示实际或感知到的头部倾斜，也不用于测量平衡能力或诊断。";
"health_atlas_vestibular_tilt_title" = "耳石线索的方向角";
