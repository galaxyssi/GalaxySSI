"health_atlas_neural_relay_delays_count" = "中继级数";
"health_atlas_neural_relay_delays_formula" = "中继总延迟 = 中继级数 × 每级中继延迟。总延迟包含从第一级到最后一级的所有延迟。每增加一级，都会增加相同的延迟。";
