"health_atlas_joint_articular_arc_formula" = "沿关节面的弧长（mm）= 半径（mm）× 角度（弧度）。角度（弧度）= 角度（度）× π / 180。半径相同时，扫过的角度越大，弧长越长。扫过的角度相同且不为零时，半径越大，弧长也越长。";
"health_atlas_joint_articular_arc_radius" = "关节面半径";
"health_atlas_joint_articular_arc_scope" = "肩关节是球窝关节：圆隆的肱骨头是球头，肩胛骨上的浅凹关节盂是关节窝。这个模拟示例用理想化关节面的圆形截面来说明弧长。角度表示从固定起始射线扫过的幅度，不代表肩关节运动的方向。本模型不追踪实际关节运动，也不估算接触力。模型中的角度不用于设定锻炼目标或诊断。";
"health_atlas_joint_articular_arc_title" = "关节面弧长";
"health_atlas_model_corneal_refraction_companion" = "向法线偏折的角度（θ₁ − θ₂）：%1$@°";
"health_atlas_model_corneal_refraction_diagram" = "琥珀色光线射入模型界面，绿色光线折向虚线表示的法线。";
"health_atlas_model_corneal_refraction_formula" = "斯涅尔定律：1.00 × sin(θ₁) = n × sin(θ₂)。入射角 θ₁ 和折射角 θ₂ 均以垂直于界面的法线为基准，单位为度。斜入射时，若入射角不变，折射率 n 越大，折射角 θ₂ 越小。";
"health_atlas_model_corneal_refraction_incident_angle" = "入射角";
