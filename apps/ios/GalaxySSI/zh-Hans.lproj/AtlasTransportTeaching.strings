"health_atlas_biliary_flow_tally_formula" = "出口流量 = 单条通道的流入流量 × 通道数。汇合处不增加、不移除也不储存液体，因此模拟 4 分钟内流入和流出的总体积相等。";
"health_atlas_biliary_flow_tally_per_channel" = "单条通道的流入流量";
"health_atlas_biliary_flow_tally_scope" = "肝细胞将胆汁分泌到细小的胆小管中，胆汁再流入胆管。较小的胆管汇合成较大的胆管，例如左、右肝管汇合形成肝总管。胆管上皮细胞排列在胆管内壁，并改变流经胆管的胆汁成分。本模型只演示汇合过程：流量相同的通道将虚构液体汇入同一个出口，不模拟胆管对胆汁的改变或胆囊储存。VU 是虚构的体积单位。所有设定均为虚构，与个人健康记录无关；模型不预测真实胆汁流量，也不预测疾病或药物的影响。";
"health_atlas_biliary_flow_tally_title" = "胆管汇合后的出口流量";
"health_atlas_follicle_surface_cavity_diameter" = "模型卵泡腔直径";
"health_atlas_follicle_surface_formula" = "卵泡腔半径 r = 腔直径 ÷ 2。外半径 R = r + 两层总厚度。外表面积 = 4πR²。球壳体积 = (4π ÷ 3) × (R³ − r³)。";
"health_atlas_follicle_surface_scope" = "有腔卵泡内有充满液体的卵泡腔，卵泡壁内侧为颗粒细胞层，外侧为卵泡膜层。模型将卵泡腔简化为球体，并将这两层合并为厚度均一的球壳。尺寸均为虚构示例，不是个人测量值或参考范围。模型不用于估算个人卵泡大小、预测排卵或生育能力，也不用于评估健康状况或模拟卵母细胞。";
"health_atlas_follicle_surface_shell_thickness" = "模型两层总厚度";
"health_atlas_follicle_surface_shell_volume" = "模型两层总体积：%1$@ mm³";
"health_atlas_follicle_surface_title" = "卵巢卵泡外表面积";
"health_atlas_joint_articular_arc_angle" = "扫过的角度";
