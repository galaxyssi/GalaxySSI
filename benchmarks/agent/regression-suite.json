        "tools": {
          "required": ["android.battery.status"],
          "forbidden": [],
          "ordered": ["android.battery.status"]
        },
        "result": {
          "terminal_states": ["completed"],
          "response": {
            "min_chars": 5,
            "max_chars": 500,
            "required_any": ["battery", "%"]
