{
  "transport_version": 1,
  "selection": "automatic",
  "brokers": {
    "emqx": { "host": "broker.emqx.io", "tls_port": 8883 },
    "hivemq": { "host": "broker.hivemq.com", "tls_port": 8883 },
    "mosquitto": { "host": "test.mosquitto.org", "tls_port": 8886 }
  },
  "limits": {
    "encoded_packet_bytes": 1048576,
    "small_packet_bytes": 65536,
